@page "/login"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject ISettingsService SettingsService

<PageTitle>KAST -- Login</PageTitle>

<MudPaper Elevation="3" Class="pa-5">
    <MudText Typo="Typo.h5" Class="mb-1" Style="font-weight:700;">Sign in</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
        Enter your KAST administrator account.
    </MudText>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
    }

    @if (_authSettings.IsOidcConfigured)
    {
        <a class="kast-auth-submit kast-auth-link" href="@OidcLoginUrl">
            Continue with @_authSettings.DisplayName
        </a>
    }

    @if (_authSettings.IsOidcConfigured && IsPasswordFormEnabled)
    {
        <MudDivider Class="my-4" />
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">@PasswordFormLabel</MudText>
    }

    @if (IsPasswordFormEnabled)
    {
        <form method="post" action="/auth/login" enctype="multipart/form-data" data-enhance="false">
            <input type="hidden" name="returnUrl" value="@_returnUrl" />
            <div class="d-flex flex-column gap-3">
                <label class="kast-auth-field">
                    <span>Username</span>
                    <input name="username" autocomplete="username" autofocus="@(!_authSettings.IsOidcConfigured)" />
                </label>
                <label class="kast-auth-field">
                    <span>Password</span>
                    <input name="password" type="password" autocomplete="current-password" />
                </label>
                <button type="submit" class="kast-auth-submit">Sign in</button>
            </div>
        </form>
    }
</MudPaper>

<style>
    .kast-auth-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
        color: var(--mud-palette-text-secondary);
        font-size: .75rem;
    }

    .kast-auth-field input {
        height: 46px;
        border: 1px solid var(--mud-palette-lines-inputs);
        border-radius: 4px;
        background: transparent;
        color: var(--mud-palette-text-primary);
        padding: 0 12px;
        outline: none;
        font: inherit;
    }

    .kast-auth-field input:focus {
        border-color: var(--mud-palette-primary);
    }

    .kast-auth-submit {
        height: 40px;
        border: 0;
        border-radius: 4px;
        background: var(--mud-palette-primary);
        color: var(--mud-palette-primary-text);
        cursor: pointer;
        font-weight: 600;
        text-transform: uppercase;
    }

    .kast-auth-link {
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
    }
</style>

@code {
    private string _returnUrl = "/";
    private string? _error;
    private KastAuthSettings _authSettings = new(KastAuthMode.Local, "OpenID Connect", null, null, null, "groups", "preferred_username", ["KAST Admins"]);
    private bool _systemAuthEnabled;
    private string OidcLoginUrl => $"/auth/oidc/login?returnUrl={Uri.EscapeDataString(_returnUrl)}";
    private bool IsPasswordFormEnabled => _authSettings.IsLocalEnabled || _systemAuthEnabled;
    private string PasswordFormLabel => _authSettings.IsLocalEnabled && _systemAuthEnabled
        ? "Local or system administrator account"
        : _systemAuthEnabled
            ? "System administrator account"
            : "Local administrator account";

    protected override async Task OnInitializedAsync()
    {
        _authSettings = Configuration.GetKastAuthSettings();
        _systemAuthEnabled = (await SettingsService.GetSettingsAsync()).SystemAuthEnabled;
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        _returnUrl = NormalizeReturnUrl(query["returnUrl"]);
        _error = query["error"];
    }

    private static string NormalizeReturnUrl(string? returnUrl)
        => string.IsNullOrWhiteSpace(returnUrl) || !returnUrl.StartsWith('/') || returnUrl.StartsWith("//")
            ? "/"
            : returnUrl;
}
