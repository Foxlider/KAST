@page "/servers/new"
@page "/servers/{Id:int}"
@attribute [Authorize]
@using KAST.UI.Components.Pages.ServerEditTabs
@inject IServerConfigService ConfigService
@inject ISettingsService SettingsService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IServiceScopeFactory ScopeFactory
@implements IDisposable

<PageTitle>KAST -- @(_isNew ? "New Server" : _instance.Name)</PageTitle>

@* ── Toolbar ── *@
<div class="d-flex align-center gap-2 mb-4 flex-wrap">
    <MudTooltip Text="Back to server instances">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                       Color="Color.Default"
                       OnClick="@(() => Nav.NavigateTo("/servers"))" />
    </MudTooltip>
    <MudIcon Icon="@UiHelpers.GetStatusIcon(_instance.Status)" Color="@UiHelpers.GetStatusColor(_instance.Status)" />
    <MudText Typo="Typo.h5" Class="mr-2" Style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:300px;">
        @(_isNew ? "New Server Instance" : _instance.Name)
    </MudText>
    @if (!_isNew)
    {
        <MudChip T="string" Size="Size.Small" Color="@UiHelpers.GetStatusColor(_instance.Status)" Variant="Variant.Filled">@_instance.Status</MudChip>
    }
    <MudSpacer />
    @if (!_isNew && _instances.Count > 1)
    {
        <MudSelect T="int"
                   Value="@_instance.Id"
                   ValueChanged="NavigateToInstance"
                   Dense="true"
                   Variant="Variant.Outlined"
                   Label="Instance"
                   Style="min-width:220px;">
            @foreach (var instance in _instances)
            {
                <MudSelectItem Value="@instance.Id">@instance.Name</MudSelectItem>
            }
        </MudSelect>
    }
    <MudButtonGroup Color="Color.Primary" Variant="Variant.Filled" DropShadow="true">
        <MudButton StartIcon="@Icons.Material.Filled.Save" OnClick="Save">Save</MudButton>
        @if (!_isNew)
        {
            @if (_instance.Status is ServerInstanceStatus.Running or ServerInstanceStatus.Starting)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Stop" OnClick="StopServer">Stop</MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.PlayArrow"
                        OnClick="LaunchServer"
                        Disabled="@(!_instance.InstalledAt.HasValue || _instance.Status == ServerInstanceStatus.Downloading)">
                    Launch
                </MudButton>
            }
        }
    </MudButtonGroup>
</div>

<MudTabs @bind-ActivePanelIndex="_activeTab" Elevation="2" Rounded="true" ApplyEffectsToContainer="true">

    @* ════════════ GENERAL ════════════ *@
    <MudTabPanel Text="General">
        <GeneralTab Instance="_instance"
                    ServerConfig="_serverConfig"
                    IsNew="_isNew"
                    OnNameChanged="OnNameChanged"
                    OnServerConfigChanged="OnServerConfigChanged"
                    GetCommandLinePreview="GetCommandLinePreview" />
    </MudTabPanel>

    @* ════════════ SERVER CONFIG ════════════ *@
    <MudTabPanel Text="Server Config">
        <ServerConfigTab Config="_serverConfig"
                         RawContent="@_serverCfgRaw"
                         OnConfigChanged="OnServerConfigChanged"
                         OnRawContentChanged="OnServerCfgRawChanged" />
    </MudTabPanel>

    @* ════════════ BASIC CONFIG ════════════ *@
    <MudTabPanel Text="Basic Config">
        <BasicConfigTab Config="_basicConfig"
                        RawContent="@_basicCfgRaw"
                        OnConfigChanged="OnBasicConfigChanged"
                        OnRawContentChanged="OnBasicCfgRawChanged" />
    </MudTabPanel>

    @* ════════════ DIFFICULTY ════════════ *@
    <MudTabPanel Text="Difficulty">
        <DifficultyTab Profile="_profileData"
                       RawContent="@_profileRaw"
                       OnProfileChanged="OnProfileChanged"
                       OnRawContentChanged="OnProfileRawChanged" />
    </MudTabPanel>

    @* ════════════ MODS ════════════ *@
    <MudTabPanel Text="Mods" BadgeData="@_instance.Mods.Count.ToString()" BadgeColor="Color.Primary">
        <ModsTab Instance="_instance" IsNew="_isNew" />
    </MudTabPanel>

    @* ════════════ INSTALL ════════════ *@
    <MudTabPanel Text="Install"
                 BadgeData="@(!_instance.InstalledAt.HasValue && !_isNew ? "!" : null)"
                 BadgeColor="Color.Warning">
        <InstallTab Instance="_instance"
                    IsNew="_isNew"
                    OnInstallComplete="HandleInstallComplete" />
    </MudTabPanel>
    @* ════════════ MISSIONS ════════════ *@
    <MudTabPanel Text="Missions">
        <MissionsTab Instance="_instance" />
    </MudTabPanel>

    @* ════════════ MONITOR ════════════ *@
    <MudTabPanel Text="Monitor"
                 BadgeDot="@(_instance.Status == ServerInstanceStatus.Running || _instance.Status == ServerInstanceStatus.Crashed || _instance.Status == ServerInstanceStatus.Starting)"
                 BadgeColor="@(_instance.Status == ServerInstanceStatus.Running ? Color.Success : _instance.Status == ServerInstanceStatus.Crashed ? Color.Error : _instance.Status == ServerInstanceStatus.Starting ? Color.Warning : Color.Default)">
        <MonitorTab Instance="_instance" OnStatusChanged="StateHasChanged" />
    </MudTabPanel>

</MudTabs>

@code {
    [Parameter] public int? Id { get; set; }

    private ServerInstance _instance = new();
    private bool _isNew => Id == null || Id == 0;
    private int _activeTab;
    private string _serversDirectory = "./servers";
    private const int MonitorTabIndex = 7;
    private IReadOnlyList<ServerInstance> _instances = [];
    private int? _loadedId;
    private bool _hasLoadedParameters;

    private ServerConfigData _serverConfig = new();
    private BasicConfigData _basicConfig = new();
    private Arma3ProfileData _profileData = new();
    private string _serverCfgRaw = "";
    private string _basicCfgRaw = "";
    private string _profileRaw = "";

    private bool _isDirty;
    private IDisposable? _locationChangingRegistration;

    protected override Task OnInitializedAsync()
    {
        _locationChangingRegistration = Nav.RegisterLocationChangingHandler(OnLocationChanging);
        return Task.CompletedTask;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_hasLoadedParameters && _loadedId == Id)
            return;

        _hasLoadedParameters = true;
        _loadedId = Id;
        _instances = await WithServerServiceAsync(s => s.GetAllInstancesAsync());
        ResetEditorState();

        if (!_isNew)
        {
            var instance = await WithServerServiceAsync(s => s.GetInstanceByIdAsync(Id!.Value));
            if (instance == null) { Nav.NavigateTo("/servers"); return; }
            _instance = instance;

            if (!string.IsNullOrEmpty(_instance.ServerCfgContent))
            { _serverConfig = ConfigService.ParseServerConfig(_instance.ServerCfgContent); _serverCfgRaw = _instance.ServerCfgContent; }
            if (!string.IsNullOrEmpty(_instance.BasicCfgContent))
            { _basicConfig = ConfigService.ParseBasicConfig(_instance.BasicCfgContent); _basicCfgRaw = _instance.BasicCfgContent; }
            if (!string.IsNullOrEmpty(_instance.ArmaProfileContent))
            { _profileData = ConfigService.ParseArma3Profile(_instance.ArmaProfileContent); _profileRaw = _instance.ArmaProfileContent; }
        }
        else
        {
            var settings = await SettingsService.GetSettingsAsync();
            _serversDirectory = settings.ServersDirectory;
            _instance.Name = $"Server-{DateTime.UtcNow:yyyyMMdd-HHmmss}";
            _instance.InstallPath = BuildInstallPath(_serversDirectory, _instance.Name);
            _serverConfig.Hostname = _instance.Name;
        }

        if (string.IsNullOrEmpty(_serverCfgRaw)) _serverCfgRaw = ConfigService.SerializeServerConfig(_serverConfig);
        if (string.IsNullOrEmpty(_basicCfgRaw)) _basicCfgRaw = ConfigService.SerializeBasicConfig(_basicConfig);
        if (string.IsNullOrEmpty(_profileRaw)) _profileRaw = ConfigService.SerializeArma3Profile(_profileData);

        _isDirty = false;
    }

    private void ResetEditorState()
    {
        _instance = new ServerInstance();
        _serverConfig = new ServerConfigData();
        _basicConfig = new BasicConfigData();
        _profileData = new Arma3ProfileData();
        _serverCfgRaw = "";
        _basicCfgRaw = "";
        _profileRaw = "";
    }

    private void OnNameChanged()
    {
        if (_isNew && !string.IsNullOrWhiteSpace(_instance.Name))
            _instance.InstallPath = BuildInstallPath(_serversDirectory, _instance.Name);
        _isDirty = true;
    }

    private static string BuildInstallPath(string serversDirectory, string serverName)
    {
        var safeName = serverName.Trim();
        foreach (var invalidChar in Path.GetInvalidFileNameChars())
            safeName = safeName.Replace(invalidChar, '_');
        safeName = safeName
            .Replace(Path.DirectorySeparatorChar, '_')
            .Replace(Path.AltDirectorySeparatorChar, '_');

        return Path.Join(serversDirectory, string.IsNullOrWhiteSpace(safeName) ? "Server" : safeName);
    }

    private void OnServerConfigChanged() { _serverCfgRaw = ConfigService.SerializeServerConfig(_serverConfig); _isDirty = true; }
    private void OnServerCfgRawChanged(string v) { _serverCfgRaw = v; _serverConfig = ConfigService.ParseServerConfig(v); _isDirty = true; }
    private void OnBasicConfigChanged() { _basicCfgRaw = ConfigService.SerializeBasicConfig(_basicConfig); _isDirty = true; }
    private void OnBasicCfgRawChanged(string v) { _basicCfgRaw = v; _basicConfig = ConfigService.ParseBasicConfig(v); _isDirty = true; }
    private void OnProfileChanged() { _profileRaw = ConfigService.SerializeArma3Profile(_profileData); _isDirty = true; }
    private void OnProfileRawChanged(string v) { _profileRaw = v; _profileData = ConfigService.ParseArma3Profile(v); _isDirty = true; }

    private async Task HandleInstallComplete()
    {
        var fresh = await WithServerServiceAsync(s => s.GetInstanceByIdAsync(_instance.Id));
        if (fresh != null) _instance = fresh;
        StateHasChanged();
    }

    private async Task Save()
        => await SaveAsync();

    private async Task<bool> SaveAsync()
    {
        try
        {
            _instance.ServerCfgContent = ConfigService.SerializeServerConfig(_serverConfig);
            _instance.BasicCfgContent = ConfigService.SerializeBasicConfig(_basicConfig);
            _instance.ArmaProfileContent = ConfigService.SerializeArma3Profile(_profileData);

            var isRunning = await IsRuntimeActive();

            if (_isNew) await WithServerServiceAsync(s => s.CreateInstanceAsync(_instance));
            else await WithServerServiceAsync(s => s.UpdateInstanceAsync(_instance));

            if (!string.IsNullOrEmpty(_instance.InstallPath) && !isRunning)
            {
                await WithServerServiceAsync(async s =>
                {
                    await s.LinkModsAsync(_instance.Id);
                    s.WriteConfigFiles(_instance);
                    return true;
                });
            }

            Snackbar.Add(
                isRunning
                    ? "Server saved in KAST. Stop or restart the server to apply config file changes."
                    : "Server saved",
                isRunning ? Severity.Warning : Severity.Success);
            _isDirty = false;

            if (Id == null || Id == 0) Nav.NavigateTo($"/servers/{_instance.Id}", replace: true);
            return true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to save: {ex.Message}", Severity.Error);
            await RefreshCurrentInstance();
            return false;
        }
    }

    private async Task LaunchServer()
    {
        if (_isNew) return;
        try
        {
            if (!await SaveAsync())
                return;

            await WithServerServiceAsync(s => s.StartInstanceAsync(_instance.Id));
            _instance = (await WithServerServiceAsync(s => s.GetInstanceByIdAsync(_instance.Id)))!;
            _activeTab = MonitorTabIndex;
            StateHasChanged();
        }
        catch (Exception ex) { Snackbar.Add($"Failed to launch: {ex.Message}", Severity.Error); }
    }

    private async Task StopServer()
    {
        if (_isNew) return;
        try
        {
            await WithServerServiceAsync(s => s.StopInstanceAsync(_instance.Id));
            await RefreshCurrentInstance();
            Snackbar.Add("Server stopped", Severity.Success);
        }
        catch (Exception ex)
        {
            await RefreshCurrentInstance();
            Snackbar.Add($"Failed to stop: {ex.Message}", Severity.Error);
        }
    }

    private async Task RefreshCurrentInstance()
    {
        if (_isNew || _instance.Id <= 0)
            return;

        var fresh = await WithServerServiceAsync(s => s.GetInstanceByIdAsync(_instance.Id));
        if (fresh != null)
            _instance = fresh;
    }

    private void NavigateToInstance(int id)
    {
        if (id != _instance.Id)
            Nav.NavigateTo($"/servers/{id}");
    }

    private async Task<bool> IsRuntimeActive()
    {
        if (_isNew)
            return false;

        var current = await WithServerServiceAsync(s => s.GetInstanceByIdAsync(_instance.Id));
        if (current is null)
            return _instance.Status is ServerInstanceStatus.Running
                or ServerInstanceStatus.Starting
                or ServerInstanceStatus.Restarting
                or ServerInstanceStatus.Stopping;

        _instance.Status = current.Status;
        _instance.ProcessId = current.ProcessId;
        _instance.StartedAt = current.StartedAt;

        return current.Status is ServerInstanceStatus.Running
            or ServerInstanceStatus.Starting
            or ServerInstanceStatus.Restarting
            or ServerInstanceStatus.Stopping;
    }

    private string GetCommandLinePreview()
    {
        _instance.ServerCfgContent = ConfigService.SerializeServerConfig(_serverConfig);
        _instance.BasicCfgContent = ConfigService.SerializeBasicConfig(_basicConfig);
        _instance.ArmaProfileContent = ConfigService.SerializeArma3Profile(_profileData);
        return WithServerService(s => s.GetCommandLine(_instance));
    }

    private async Task<TResult> WithServerServiceAsync<TResult>(Func<IServerInstanceService, Task<TResult>> action)
    {
        using var scope = ScopeFactory.CreateScope();
        var serverService = scope.ServiceProvider.GetRequiredService<IServerInstanceService>();
        return await action(serverService);
    }

    private async Task WithServerServiceAsync(Func<IServerInstanceService, Task> action)
    {
        using var scope = ScopeFactory.CreateScope();
        var serverService = scope.ServiceProvider.GetRequiredService<IServerInstanceService>();
        await action(serverService);
    }

    private TResult WithServerService<TResult>(Func<IServerInstanceService, TResult> action)
    {
        using var scope = ScopeFactory.CreateScope();
        var serverService = scope.ServiceProvider.GetRequiredService<IServerInstanceService>();
        return action(serverService);
    }

    private async ValueTask OnLocationChanging(LocationChangingContext context)
    {
        if (!_isDirty) return;

        context.PreventNavigation();

        var discard = await JS.InvokeAsync<bool>("confirm", "You have unsaved changes to this server instance. Discard them?");

        if (discard)
        {
            _isDirty = false;
            Nav.NavigateTo(context.TargetLocation, forceLoad: false);
        }
    }

    public void Dispose() => _locationChangingRegistration?.Dispose();

}
