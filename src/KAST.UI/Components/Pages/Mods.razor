@page "/mods"
@using KAST.Core.Events
@using System.Text.RegularExpressions
@using System.Net
@using Microsoft.AspNetCore.Components.Forms
@inject IModService ModService
@inject IModUpdateCoordinator ModUpdateCoordinator
@inject IAppEventBroadcaster Broadcaster
@inject IOutputSanitizer OutputSanitizer
@inject IModDownloadCancellationRegistry ModDownloadCancellationRegistry
@inject ISnackbar Snackbar
@implements IAsyncDisposable

<PageTitle>KAST -- Mods</PageTitle>

@* ── Top bar ── *@
<div class="d-flex justify-space-between align-center mb-3 flex-wrap gap-2">
    <div class="d-flex align-center gap-3">
        <MudText Typo="Typo.h5">Mod Management</MudText>
        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
            @_mods.Count total
        </MudChip>
        @if (_outdatedCount > 0)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled"
                     Icon="@Icons.Material.Filled.SystemUpdateAlt">
                @_outdatedCount outdated
            </MudChip>
        }
        @if (_errorCount > 0)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                     Icon="@Icons.Material.Filled.Error">
                @_errorCount error(s)
            </MudChip>
        }
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => _showAddDialog = true)">
            Add Mod
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="@(() => _showImportDialog = true)">
            Import Local
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.PlaylistAdd" OnClick="@(() => _showPresetImportDialog = true)">
            Import Preset
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Info"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="CheckForUpdates"
                   Disabled="_isCheckingUpdates || _isUpdatingAll">
            @(_isCheckingUpdates && !_isUpdatingAll ? "Checking…" : "Check for Updates")
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.CloudDownload"
                   OnClick="UpdateAllOutdated"
                   Disabled="_isUpdatingAll || _isCheckingUpdates || _taskProgress.Count > 0">
            @if (_isCheckingUpdates)
            {
                @("Checking…")
            }
            else if (_isUpdatingAll)
            {
                @("Queuing…")
            }
            else if (_pendingCount > 0)
            {
                @($"Update All ({_pendingCount})")
            }
            else
            {
                @("Update All")
            }
        </MudButton>
    </div>
</div>

@* ── Mod grid ── *@
@if (_mods.Count == 0)
{
    <MudPaper Class="pa-12 text-center" Elevation="1">
        <MudIcon Icon="@Icons.Material.Filled.Extension" Size="Size.Large" Color="Color.Secondary" />
        <MudText Typo="Typo.h6" Class="mt-2">No mods yet</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Add mods from the Steam Workshop or import local mods to get started.
        </MudText>
    </MudPaper>
}
else
{
    <MudDataGrid T="SteamMod" Items="@_mods" Filterable="true" SortMode="SortMode.Multiple"
                 Hover="true" Dense="true" RowClick="@(args => ShowModDetails(args.Item))"
                 Virtualize="true" FixedHeader="true" Height="@GridHeight"
                 ItemSize="56" OverscanCount="12">
        <Columns>
            <TemplateColumn Title="" HeaderStyle="width:48px" Sortable="false" Filterable="false">
                <CellTemplate>
                    @if (!string.IsNullOrEmpty(context.Item.ThumbnailUrl))
                    {
                        <img src="@context.Item.ThumbnailUrl" alt="" width="36" height="36"
                             loading="lazy" decoding="async"
                             style="width:36px;height:36px;object-fit:cover;border-radius:4px;display:block;" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Outlined.Extension" Style="opacity:.4;" />
                    }
                </CellTemplate>
            </TemplateColumn>

            <PropertyColumn Property="m => m.Name" Title="Name" Sortable="true" HeaderStyle="min-width:150px; max-width:260px;">
                <CellTemplate>
                    <MudText Style="cursor:pointer; font-weight:500;">@context.Item.Name</MudText>
                    @if (context.Item.Author != null)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Item.Author</MudText>
                    }
                </CellTemplate>
            </PropertyColumn>

            <PropertyColumn Property="m => m.Source" Title="Source" Sortable="true" HeaderStyle="width:110px" />

            <TemplateColumn Title="Status" Sortable="false" HeaderStyle="width:180px">
                <CellTemplate>
                    @{
                        var isQueued = IsTaskQueued(context.Item.Id);
                        var isCancelling = IsTaskCancelling(context.Item.Id);
                        var isActive = IsTaskActive(context.Item);
                        var pct = GetModProgress(context.Item.Id);
                    }
                    @if (isActive)
                    {
                        <div style="min-width:140px;">
                            <div class="d-flex justify-space-between mb-1">
                                <MudText Typo="Typo.caption" Color="@GetTaskStatusColor(context.Item)">@GetTaskStatusLabel(context.Item)</MudText>
                                @if (!isQueued && !isCancelling)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@pct.ToString("F0")%</MudText>
                                }
                            </div>
                            @if (!isQueued && !isCancelling)
                            {
                                <MudProgressLinear Value="@pct" Min="0" Max="100"
                                                   Color="Color.Warning" Rounded="true" Size="Size.Small" />
                            }
                        </div>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small"
                                 Color="@GetStatusColor(context.Item.Status)"
                                 Variant="Variant.Outlined"
                                 Icon="@GetStatusIcon(context.Item.Status)">
                            @context.Item.Status
                        </MudChip>
                    }
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn Title="Size" Sortable="false" HeaderStyle="white-space:nowrap;">
                <CellTemplate>
                    <MudText Typo="Typo.body2" Style="white-space:nowrap;">
                        @(context.Item.SizeBytes > 0 ? FormatBytes(context.Item.SizeBytes) : "—")
                    </MudText>
                    @if (context.Item.ExpectedSizeBytes > 0 && context.Item.SizeBytes == 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="white-space:nowrap;">
                            ~@FormatBytes(context.Item.ExpectedSizeBytes)
                        </MudText>
                    }
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn Title="Version" Sortable="false" HeaderStyle="width:80px">
                <CellTemplate>
                    @if (context.Item.InstalledManifestId > 0)
                    {
                        var isLatest = context.Item.SteamManifestId == 0 ||
                                       context.Item.InstalledManifestId == context.Item.SteamManifestId;
                        <MudTooltip Text="@(isLatest ? "Up to date" : "Outdated — manifest ID differs from Steam")" Arrow="true">
                            <MudIcon Icon="@(isLatest ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.NewReleases)"
                                     Color="@(isLatest ? Color.Success : Color.Warning)"
                                     Size="Size.Small" />
                        </MudTooltip>
                    }
                    else if (context.Item.Status == ModStatus.Installed)
                    {
                        <MudTooltip Text="Manifest not tracked — run Check for Updates" Arrow="true">
                            <MudIcon Icon="@Icons.Material.Filled.HelpOutline"
                                     Color="Color.Default" Size="Size.Small" Style="opacity:.4;" />
                        </MudTooltip>
                    }
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn Title="Last Checked" Sortable="false" HeaderStyle="width:110px">
                <CellTemplate>
                    @if (context.Item.LastChecked.HasValue)
                    {
                        <MudTooltip Text="@context.Item.LastChecked.Value.ToLocalTime().ToString("g")" Arrow="true">
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="white-space:nowrap;">
                                @FormatRelativeTime(context.Item.LastChecked.Value)
                            </MudText>
                        </MudTooltip>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="opacity:.4;">Never</MudText>
                    }
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn Title="Actions" Sortable="false" HeaderStyle="width:118px" Filterable="false">
                <CellTemplate>
                    <div class="d-flex gap-0 justify-end" @onclick:stopPropagation="true">
                        @if (context.Item.Source == ModSource.SteamWorkshop &&
                             context.Item.Status == ModStatus.Installed)
                        {
                            <MudTooltip Text="Check for Update" Arrow="true">
                                <MudIconButton Icon="@Icons.Material.Outlined.ManageSearch"
                                               Size="Size.Small" Color="Color.Info"
                                               Disabled="@_checkingMods.Contains(context.Item.Id)"
                                               OnClick="@(() => CheckSingleModUpdate(context.Item))" />
                            </MudTooltip>
                        }
                        @if (IsTaskActive(context.Item))
                        {
                            @if (IsTaskCancelling(context.Item.Id))
                            {
                                <MudProgressCircular Size="Size.Small" Color="Color.Warning" />
                            }
                            else
                            {
                                <MudTooltip Text="Cancel" Arrow="true">
                                    <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                                   Size="Size.Small" Color="Color.Warning"
                                                   OnClick="@(() => CancelModDownload(context.Item.Id))" />
                                </MudTooltip>
                            }
                        }
                        else if (CanDownloadOrUpdate(context.Item))
                        {
                            <MudTooltip Text="@GetDownloadButtonLabel(context.Item)" Arrow="true">
                                <MudIconButton Icon="@GetActionIcon(context.Item)"
                                               Size="Size.Small"
                                               Color="@GetActionColor(context.Item)"
                                               OnClick="@(() => DownloadMod(context.Item))" />
                            </MudTooltip>
                        }
                        <MudTooltip Text="Delete" Arrow="true">
                            <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                           Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => DeleteMod(context.Item))" />
                        </MudTooltip>
                    </div>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
}

@* ── Downloads task panel (fixed bottom overlay, always present) ── *@
<div class="dl-fixed-panel">
    <MudExpansionPanels Elevation="5">
        <MudExpansionPanel @bind-Expanded="_showDownloadsDrawer" Dense="true">
            <TitleContent>
                <div class="d-flex align-center gap-2" style="width:100%;">
                    @{
                        var activeCount = _taskIds.Count(id => _mods.FirstOrDefault(m => m.Id == id) is { } mod && IsTaskActive(mod));
                        var taskErrCount = _taskIds.Count(id => _mods.Any(m => m.Id == id &&
                            m.Status == ModStatus.Error));
                        var isCheckingAll = _isUpdatingAll && _isCheckingUpdates;
                        var hasActiveWork = activeCount > 0 || _isUpdatingAll;
                        var bulkCancellationRequested = _bulkUpdateCts?.IsCancellationRequested == true;
                    }
                    @if (hasActiveWork)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Info" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Outlined.DownloadDone" Size="Size.Small"
                                 Color="@(_taskIds.Count > 0 ? Color.Success : Color.Default)"
                                 Style="opacity:.7;" />
                    }
                    <MudText Typo="Typo.body2" Style="font-weight:600;">Downloads</MudText>
                        @if (hasActiveWork)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
                                 Style="height:20px; font-size:11px; margin:0;">
                            @(bulkCancellationRequested ? "Cancelling" : isCheckingAll ? "Checking updates" : $"{activeCount} active")
                        </MudChip>
                    }
                    @if (taskErrCount > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                                 Style="height:20px; font-size:11px; margin:0;">
                            @taskErrCount failed
                        </MudChip>
                    }
                    @if (_taskIds.Count == 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="opacity:.55;">No recent tasks</MudText>
                    }
                    <div style="flex:1" />
                    @if (hasActiveWork)
                    {
                        <div @onclick:stopPropagation="true">
                            <MudTooltip Text="Cancel all" Arrow="true">
                                <MudIconButton Icon="@Icons.Material.Filled.StopCircle"
                                               Size="Size.Small" Color="Color.Error"
                                               OnClick="CancelAllDownloads" />
                            </MudTooltip>
                        </div>
                    }
                </div>
            </TitleContent>
            <ChildContent>
                <div class="dl-body">
                    @if (_taskIds.Count == 0)
                    {
                        <div class="dl-empty">
                            <MudIcon Icon="@Icons.Material.Outlined.CloudQueue" Style="font-size:36px; opacity:.35;" />
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1" Style="opacity:.55;">No recent downloads</MudText>
                        </div>
                    }
                    else
                    {
                        @foreach (var modId in _taskIds)
                        {
                            var dlMod = _mods.FirstOrDefault(m => m.Id == modId);
                            if (dlMod is null) continue;
                            var pct = _taskProgress.TryGetValue(modId, out var tp) ? tp : 100.0;
                            var isQueued = IsTaskQueued(modId);
                            var isCancelling = IsTaskCancelling(modId);
                            var isActive = IsTaskActive(dlMod);
                            <div class="dl-row">
                                <div class="dl-thumb">
                                    @if (!string.IsNullOrEmpty(dlMod.ThumbnailUrl))
                                    {
                                        <img src="@dlMod.ThumbnailUrl" alt="" class="dl-thumb-img" />
                                    }
                                    else
                                    {
                                        <div class="dl-thumb-placeholder">
                                            <MudIcon Icon="@Icons.Material.Outlined.Extension" Style="opacity:.35;" />
                                        </div>
                                    }
                                </div>
                                <div class="dl-info">
                                    <div class="d-flex align-center justify-space-between mb-1">
                                        <MudText Typo="Typo.body2"
                                                 Style="font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; flex:1; min-width:0;"
                                                 title="@dlMod.Name">
                                            @dlMod.Name
                                        </MudText>
                                        <div class="d-flex align-center" style="flex-shrink:0;">
                                            @if (isActive)
                                            {
                                                @if (!isQueued && !isCancelling)
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@pct.ToString("F0")%</MudText>
                                                }
                                                @if (isCancelling)
                                                {
                                                    <MudProgressCircular Size="Size.Small" Color="Color.Warning" />
                                                }
                                                else
                                                {
                                                    <MudTooltip Text="Cancel" Arrow="true">
                                                        <MudIconButton Icon="@Icons.Material.Outlined.Cancel"
                                                                       Size="Size.Small" Color="Color.Error"
                                                                       Style="width:28px;height:28px;"
                                                                       OnClick="@(() => CancelModDownload(modId))" />
                                                    </MudTooltip>
                                                }
                                            }
                                            else
                                            {
                                                <MudIcon Icon="@GetStatusIcon(dlMod.Status)"
                                                         Color="@GetStatusColor(dlMod.Status)"
                                                         Size="Size.Small" />
                                            }
                                        </div>
                                    </div>
                                    <div class="d-flex align-center gap-2 mb-1">
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@GetTaskStatusColor(dlMod)"
                                                 Variant="Variant.Text"
                                                 Style="height:18px; font-size:10px; padding:0 4px; margin:0;">
                                            @GetTaskStatusLabel(dlMod)
                                        </MudChip>
                                        @if (isActive && !isQueued && !isCancelling && dlMod.ExpectedSizeBytes > 0)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="white-space:nowrap;">
                                                @FormatBytes((long)(pct / 100.0 * dlMod.ExpectedSizeBytes)) / @FormatBytes(dlMod.ExpectedSizeBytes)
                                            </MudText>
                                        }
                                    </div>
                                    @if (isActive && !isQueued && !isCancelling)
                                    {
                                        <MudProgressLinear Value="@pct" Min="0" Max="100"
                                                          Color="Color.Warning" Rounded="true" Size="Size.Small" />
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </ChildContent>
        </MudExpansionPanel>
    </MudExpansionPanels>
</div>

@* ── Mod Detail Dialog ── *@
<MudDialog @bind-Visible="_showDetailDialog" Options="_detailDialogOptions">
    <TitleContent>
        <div class="d-flex align-center gap-3 flex-wrap">
            <MudChip T="string" Size="Size.Small"
                     Color="@GetStatusColor(_selectedMod?.Status ?? ModStatus.NotInstalled)"
                     Variant="Variant.Filled"
                     Icon="@GetStatusIcon(_selectedMod?.Status ?? ModStatus.NotInstalled)">
                @_selectedMod?.Status
            </MudChip>
            <MudText Typo="Typo.h6">@_selectedMod?.Name</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_selectedMod != null)
        {
            <div class="d-flex gap-4 flex-wrap">
                @if (!string.IsNullOrEmpty(_selectedMod.ThumbnailUrl))
                {
                    <img src="@_selectedMod.ThumbnailUrl" alt="@_selectedMod.Name"
                         style="width:200px;height:200px;object-fit:cover;border-radius:8px;flex-shrink:0;align-self:flex-start;" />
                }
                <div style="flex:1; min-width:260px;">
                    <MudSimpleTable Dense="true" Hover="false" Style="background:transparent;">
                        <tbody>
                            @if (_selectedMod.Author != null)
                            {
                                <tr><td style="width:130px;opacity:.7;">Author</td><td>@_selectedMod.Author</td></tr>
                            }
                            <tr><td style="opacity:.7;">Source</td><td>@_selectedMod.Source</td></tr>
                            @if (_selectedMod.WorkshopId > 0)
                            {
                                <tr>
                                    <td style="opacity:.7;">Workshop ID</td>
                                    <td>
                                        <MudLink Href="@($"https://steamcommunity.com/sharedfiles/filedetails/?id={_selectedMod.WorkshopId}")"
                                                 Target="_blank" Typo="Typo.body2">
                                            @_selectedMod.WorkshopId
                                        </MudLink>
                                    </td>
                                </tr>
                            }
                            <tr>
                                <td style="opacity:.7;">Size on Disk</td>
                                <td>@(_selectedMod.SizeBytes > 0 ? FormatBytes(_selectedMod.SizeBytes) : "Not downloaded")</td>
                            </tr>
                            @if (_selectedMod.ExpectedSizeBytes > 0)
                            {
                                <tr><td style="opacity:.7;">Steam Size</td><td>@FormatBytes(_selectedMod.ExpectedSizeBytes)</td></tr>
                            }
                            @if (_selectedMod.InstalledManifestId > 0)
                            {
                                <tr>
                                    <td style="opacity:.7;">Installed Manifest</td>
                                    <td><code style="font-size:11px;">@_selectedMod.InstalledManifestId</code></td>
                                </tr>
                            }
                            @if (_selectedMod.SteamManifestId > 0)
                            {
                                <tr>
                                    <td style="opacity:.7;">Steam Manifest</td>
                                    <td>
                                        <code style="font-size:11px;">@_selectedMod.SteamManifestId</code>
                                        @if (_selectedMod.InstalledManifestId > 0)
                                        {
                                            @if (_selectedMod.InstalledManifestId == _selectedMod.SteamManifestId)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                                         Color="Color.Success" Size="Size.Small" Class="ml-1" />
                                            }
                                            else
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.NewReleases"
                                                         Color="Color.Warning" Size="Size.Small" Class="ml-1" />
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                            @if (_selectedMod.LastUpdatedSteam.HasValue)
                            {
                                <tr><td style="opacity:.7;">Updated (Steam)</td><td>@_selectedMod.LastUpdatedSteam.Value.ToLocalTime().ToString("g")</td></tr>
                            }
                            @if (_selectedMod.LastUpdatedLocal.HasValue)
                            {
                                <tr><td style="opacity:.7;">Updated (Local)</td><td>@_selectedMod.LastUpdatedLocal.Value.ToLocalTime().ToString("g")</td></tr>
                            }
                            @if (_selectedMod.LastChecked.HasValue)
                            {
                                <tr><td style="opacity:.7;">Last Checked</td><td>@_selectedMod.LastChecked.Value.ToLocalTime().ToString("g")</td></tr>
                            }
                            @if (!string.IsNullOrWhiteSpace(_selectedMod.LocalPath))
                            {
                                <tr>
                                    <td style="opacity:.7;">Files</td>
                                    <td><code style="font-size:11px;">@OutputSanitizer.ToDisplayPath(_selectedMod.LocalPath)</code></td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_selectedMod.Description))
            {
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle2" Class="mb-1">Description</MudText>
                <MudPaper Elevation="0" Class="pa-3 mod-description" Style="background:var(--mud-palette-background-grey); border-radius:6px; max-height:300px; overflow-y:auto;">
                    @RenderDescription(_selectedMod.Description)
                </MudPaper>
            }
            <MudDivider Class="my-3" />
            <MudTextField @bind-Value="_commentInput"
                          Label="Notes / Comment"
                          Placeholder="Add a personal note about this mod…"
                          Lines="3" FullWidth="true"
                          Variant="Variant.Outlined"
                          @onblur="SaveComment" />
        }
    </DialogContent>
    <DialogActions>
        @if (_selectedMod != null && CanDownloadOrUpdate(_selectedMod))
        {
            <MudButton Variant="Variant.Filled" Color="@GetActionColor(_selectedMod)"
                       OnClick="DownloadModFromDialog"
                       Disabled="@(_selectedMod.Status is ModStatus.Downloading or ModStatus.Updating)">
                @GetDownloadButtonLabel(_selectedMod)
            </MudButton>
        }
        <MudButton OnClick="@(() => _showDetailDialog = false)">Close</MudButton>
    </DialogActions>
</MudDialog>

@* ── Add Workshop Mod Dialog ── *@
<MudDialog @bind-Visible="_showAddDialog">
    <TitleContent><MudText Typo="Typo.h6">Add Workshop Mod</MudText></TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_workshopIdInput" Label="Workshop ID or URL"
                      Placeholder="e.g. 450814997 or full Steam Workshop URL"
                      FullWidth="true" Immediate="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => { _showAddDialog = false; _workshopIdInput = ""; })">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddWorkshopMod">Add Mod</MudButton>
    </DialogActions>
</MudDialog>

@* ── Import Preset Dialog ── *@
<MudDialog @bind-Visible="_showPresetImportDialog"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true })">
    <TitleContent>
        <MudIcon Icon="@Icons.Material.Filled.PlaylistAdd" Class="mr-2" />
        <MudText Typo="Typo.h6" Style="display:inline;">Import Arma 3 Preset</MudText>
    </TitleContent>
    <DialogContent>
        <MudFileUpload T="IBrowserFile" FilesChanged="OnPresetFileSelected" Accept=".html">
            <CustomContent>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.UploadFile"
                           FullWidth="true" Color="@(_presetFile is null ? Color.Default : Color.Primary)"
                           OnClick="@context.OpenFilePickerAsync">
                    @(_presetFile is null ? "Select HTML preset file (.html)" : _presetFile.Name)
                </MudButton>
            </CustomContent>
        </MudFileUpload>
        @if (_parsedPresetMods.Count > 0)
        {
            var selectableMods = _parsedPresetMods
                    .Where(p => !_mods.Any(m => m.WorkshopId == p.WorkshopId)).ToList();
            var selectedNewCount = selectableMods.Count(p => _presetSelectedIds.Contains(p.WorkshopId));
            bool? selectAllState = selectedNewCount == selectableMods.Count && selectableMods.Count > 0
                    ? true
                    : selectedNewCount == 0 ? false : null;
            <div class="d-flex align-center justify-space-between mt-3 mb-1">
                <MudText Typo="Typo.body2">
                    Preset <strong>@_parsedPresetName</strong> — @_parsedPresetMods.Count mod(s)
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@selectedNewCount selected</MudText>
            </div>
            <div class="d-flex align-center gap-2 px-1 py-1" style="border-bottom:1px solid var(--mud-palette-divider);">
                <MudCheckBox T="bool?" Value="@selectAllState"
                             ValueChanged="ToggleSelectAllPresetMods"
                             Size="Size.Small" Dense="true"
                             Disabled="_isImportingPreset" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">Select all new</MudText>
            </div>
            <div style="max-height:260px; overflow-y:auto;">
                @foreach (var (wid, dname) in _parsedPresetMods)
                {
                    var exists = _mods.Any(m => m.WorkshopId == wid);
                    var isChecked = exists || _presetSelectedIds.Contains(wid);
                    <div class="d-flex align-center gap-2 py-1 px-1"
                         style="border-bottom:1px solid var(--mud-palette-divider); opacity:@(exists ? "0.55" : "1");">
                        <MudCheckBox T="bool" Value="@isChecked"
                                     ValueChanged="@((v) => TogglePresetMod(wid, v))"
                                     Size="Size.Small" Dense="true"
                                     Disabled="@(exists || _isImportingPreset)" />
                        <MudText Typo="Typo.body2"
                                 Style="flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                                 title="@dname">@dname</MudText>
                        @if (exists)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success"
                                     Variant="Variant.Text" Style="font-size:10px; flex-shrink:0; margin:0;">added</MudChip>
                        }
                    </div>
                }
            </div>
        }
        @if (_isImportingPreset)
        {
            <MudProgressLinear Value="@_presetImportDone" Max="@_presetImportTotal"
                               Color="Color.Primary" Rounded="true" Size="Size.Small" Class="mt-3" />
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                @_presetImportDone / @_presetImportTotal processed…
            </MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="ClosePresetImportDialog" Disabled="_isImportingPreset">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(_presetSelectedIds.Count == 0 || _isImportingPreset)"
                   OnClick="ImportPresetMods">
            @if (_isImportingPreset)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                @($"Importing… ({_presetImportDone}/{_presetImportTotal})")
            }
            else
            {
                @($"Add {_presetSelectedIds.Count} mod(s)")
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@* ── Import Local Mod Dialog ── *@
<MudDialog @bind-Visible="_showImportDialog">
    <TitleContent><MudText Typo="Typo.h6">Import Local Mod</MudText></TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_localModName" Label="Mod Name" FullWidth="true" Class="mb-3" />
        <MudTextField @bind-Value="_localModPath" Label="Path (folder or .zip file)" FullWidth="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => { _showImportDialog = false; _localModName = ""; _localModPath = ""; })">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ImportLocalMod">Import</MudButton>
    </DialogActions>
</MudDialog>

@code {
    // ── State ────────────────────────────────────────────────────────────────
    private IReadOnlyList<SteamMod> _mods = [];
    private SteamMod? _selectedMod;
    private bool _showDetailDialog;
    private bool _showAddDialog;
    private bool _showImportDialog;
    private bool _showPresetImportDialog;
    private bool _showDownloadsDrawer;
    private bool _isCheckingUpdates;
    private bool _isUpdatingAll;
    private int _outdatedCount;
    private int _errorCount;
    private int _pendingCount;
    private string _commentInput = "";

    // Preset import
    private IBrowserFile? _presetFile;
    private string _parsedPresetName = "";
    private List<(long WorkshopId, string DisplayName)> _parsedPresetMods = [];
    private HashSet<long> _presetSelectedIds = [];
    private bool _isImportingPreset;
    private int _presetImportDone;
    private int _presetImportTotal;

    private readonly Dictionary<int, double> _taskProgress = new(); // progress for active downloads
    private readonly List<int> _taskIds = new();                    // all task mod IDs, newest first
    private readonly Dictionary<int, CancellationTokenSource> _downloadCts = new();
    private readonly HashSet<int> _queuedTaskIds = new();
    private readonly HashSet<int> _cancellingTaskIds = new();
    private readonly Dictionary<int, double> _pendingTaskProgress = new();
    private readonly object _progressSync = new();
    private readonly CancellationTokenSource _componentCts = new();
    private bool _progressFlushScheduled;
    private CancellationTokenSource? _bulkUpdateCts;
    private readonly HashSet<int> _checkingMods = new();

    private string _workshopIdInput = "";
    private string _localModName = "";
    private string _localModPath = "";

    private readonly DialogOptions _detailDialogOptions = new()
    {
        MaxWidth = MaxWidth.Large,
        FullWidth = true,
        CloseButton = true,
        BackdropClick = true
    };

    // ── Lifecycle ────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await RefreshMods();
        Broadcaster.OnModDownloadProgress += HandleDownloadProgress;
        Broadcaster.OnModStatusChanged    += HandleStatusChanged;
    }

    public async ValueTask DisposeAsync()
    {
        Broadcaster.OnModDownloadProgress -= HandleDownloadProgress;
        Broadcaster.OnModStatusChanged    -= HandleStatusChanged;
        foreach (var cts in _downloadCts.Values) cts.Cancel();
        _bulkUpdateCts?.Cancel();
        _bulkUpdateCts?.Dispose();
        _componentCts.Cancel();
        _componentCts.Dispose();
        await Task.CompletedTask;
    }

    // ── In-process event handlers ─────────────────────────────────────────────
    private void HandleDownloadProgress(ModDownloadProgressEvent evt)
    {
        lock (_progressSync)
        {
            _pendingTaskProgress[evt.ModId] = evt.ProgressPercent;
            if (_progressFlushScheduled)
                return;

            _progressFlushScheduled = true;
        }

        _ = FlushProgressAsync();
    }

    private async Task FlushProgressAsync()
    {
        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(100), _componentCts.Token);
            Dictionary<int, double> progress;
            lock (_progressSync)
            {
                progress = new Dictionary<int, double>(_pendingTaskProgress);
                _pendingTaskProgress.Clear();
                _progressFlushScheduled = false;
            }

            await InvokeAsync(() =>
            {
                foreach (var (modId, percent) in progress)
                {
                    var mod = _mods.FirstOrDefault(candidate => candidate.Id == modId);
                    if (mod is null || !IsTaskActive(mod))
                        continue;

                    _taskProgress[modId] = percent;
                    AddTask(modId);
                }
                StateHasChanged();
            });

            lock (_progressSync)
            {
                if (_pendingTaskProgress.Count == 0 || _progressFlushScheduled)
                    return;

                _progressFlushScheduled = true;
            }
            _ = FlushProgressAsync();
        }
        catch (OperationCanceledException) when (_componentCts.IsCancellationRequested)
        {
            lock (_progressSync)
                _progressFlushScheduled = false;
        }
    }

    private void HandleStatusChanged(ModStatusChangedEvent evt)
    {
        _ = InvokeAsync(() =>
        {
            var mod = _mods.FirstOrDefault(m => m.Id == evt.ModId);
            if (mod is null || !Enum.TryParse<ModStatus>(evt.NewStatus, out var status))
                return;

            mod.Status = status;
            if (status is ModStatus.Downloading or ModStatus.Updating)
            {
                _queuedTaskIds.Remove(mod.Id);
                AddTask(mod.Id);
            }
            else
            {
                _queuedTaskIds.Remove(mod.Id);
                _cancellingTaskIds.Remove(mod.Id);
                _taskProgress.Remove(mod.Id);
            }

            RecalculateModCounts();
            StateHasChanged();
        });
    }

    // ── Data ─────────────────────────────────────────────────────────────────
    private async Task RefreshMods()
    {
        _mods = await ModService.GetAllModsAsync();
        RecalculateModCounts();
    }

    private void RecalculateModCounts()
    {
        _outdatedCount = _mods.Count(m => m.Status == ModStatus.UpdateAvailable);
        _errorCount    = _mods.Count(m => m.Status == ModStatus.Error);
        _pendingCount  = _mods.Count(m => m.Source == ModSource.SteamWorkshop &&
                                           m.Status is ModStatus.NotInstalled or
                                                       ModStatus.UpdateAvailable or
                                                       ModStatus.Error);
    }

    private double GetModProgress(int modId) =>
        _taskProgress.TryGetValue(modId, out var p) ? p : 0;

    private bool IsTaskQueued(int modId) => _queuedTaskIds.Contains(modId);
    private bool IsTaskCancelling(int modId) => _cancellingTaskIds.Contains(modId);
    private bool IsTaskActive(SteamMod mod) =>
        IsTaskQueued(mod.Id) ||
        IsTaskCancelling(mod.Id) ||
        mod.Status is ModStatus.Downloading or ModStatus.Updating;

    private string GetTaskStatusLabel(SteamMod mod) =>
        IsTaskCancelling(mod.Id) ? "Cancelling" :
        IsTaskQueued(mod.Id) ? "Queued" :
        mod.Status.ToString();

    private Color GetTaskStatusColor(SteamMod mod) =>
        IsTaskCancelling(mod.Id) ? Color.Warning :
        IsTaskQueued(mod.Id) ? Color.Info :
        GetStatusColor(mod.Status);

    private void AddTask(int modId)
    {
        if (!_taskIds.Contains(modId))
            _taskIds.Insert(0, modId);
    }

    private void QueueTasks(IEnumerable<SteamMod> mods)
    {
        foreach (var mod in mods)
        {
            AddTask(mod.Id);
            _queuedTaskIds.Add(mod.Id);
            _taskProgress[mod.Id] = 0;
        }
    }

    private static string GridHeight => "calc(100vh - 232px)"; // task panel always present

    // ── Actions ──────────────────────────────────────────────────────────────
    private void ShowModDetails(SteamMod mod)
    {
        _selectedMod = mod;
        _commentInput = mod.Comment ?? "";
        _showDetailDialog = true;
    }

    private async Task SaveComment()
    {
        if (_selectedMod is null) return;
        var trimmed = _commentInput.Trim();
        if (trimmed == (_selectedMod.Comment ?? "")) return; // no change
        _selectedMod.Comment = trimmed.Length == 0 ? null : trimmed;
        await ModService.UpdateModAsync(_selectedMod);
        _commentInput = _selectedMod.Comment ?? "";
    }

    private void ClosePresetImportDialog()
    {
        _showPresetImportDialog = false;
        _presetFile = null;
        _parsedPresetName = "";
        _parsedPresetMods.Clear();
        _presetSelectedIds.Clear();
        _presetImportDone = 0;
        _presetImportTotal = 0;
    }

    private async Task OnPresetFileSelected(IBrowserFile file)
    {
        _presetFile = file;
        _parsedPresetName = "";
        _parsedPresetMods = [];
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var html = await reader.ReadToEndAsync();

            var nameMatch = Regex.Match(html, @"<meta\s+name=""arma:PresetName""\s+content=""([^""]+)""",
                RegexOptions.IgnoreCase);
            _parsedPresetName = nameMatch.Success
                ? nameMatch.Groups[1].Value
                : file.Name.Replace(".html", "", StringComparison.OrdinalIgnoreCase);

            var rows = Regex.Matches(html,
                @"<tr\s+data-type=""ModContainer"">(.*?)</tr>",
                RegexOptions.Singleline | RegexOptions.IgnoreCase);
            foreach (Match row in rows)
            {
                var nameM = Regex.Match(row.Groups[1].Value,
                    @"data-type=""DisplayName""[^>]*>([^<]+)<", RegexOptions.IgnoreCase);
                var urlM = Regex.Match(row.Groups[1].Value, @"\?id=(\d+)", RegexOptions.IgnoreCase);
                if (urlM.Success && long.TryParse(urlM.Groups[1].Value, out var id))
                {
                    var displayName = nameM.Success
                        ? System.Net.WebUtility.HtmlDecode(nameM.Groups[1].Value.Trim())
                        : $"Workshop/{id}";
                    _parsedPresetMods.Add((id, displayName));
                }
            }

            // Pre-select all mods that don't already exist
            _presetSelectedIds = [.. _parsedPresetMods
                .Where(p => !_mods.Any(m => m.WorkshopId == p.WorkshopId))
                .Select(p => p.WorkshopId)];
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to parse preset file: {OutputSanitizer.SanitizeException(ex)}", Severity.Error);
        }
    }

    private async Task ImportPresetMods()
    {
        if (_presetSelectedIds.Count == 0) return;
        _isImportingPreset = true;
        _presetImportDone = 0;
        _presetImportTotal = _presetSelectedIds.Count;
        var comment = $"Preset: {_parsedPresetName}";
        int added = 0, failed = 0;

        foreach (var (workshopId, _) in _parsedPresetMods.Where(p => _presetSelectedIds.Contains(p.WorkshopId)))
        {
            try
            {
                var wasNew = !_mods.Any(m => m.WorkshopId == workshopId);
                var mod = await ModService.AddWorkshopModAsync(workshopId);
                if (wasNew)
                {
                    mod.Comment = comment;
                    await ModService.UpdateModAsync(mod);
                }
                added++;
            }
            catch
            {
                failed++;
            }
            _presetImportDone++;
            StateHasChanged();
        }

        await RefreshMods();
        _isImportingPreset = false;
        var msg = $"Preset '{_parsedPresetName}': {added} mod(s) added";
        if (failed > 0) msg += $", {failed} failed";
        ClosePresetImportDialog();
        Snackbar.Add(msg, failed > 0 ? Severity.Warning : Severity.Success);
    }

    private void TogglePresetMod(long workshopId, bool selected)
    {
        if (selected) _presetSelectedIds.Add(workshopId);
        else _presetSelectedIds.Remove(workshopId);
    }

    private void ToggleSelectAllPresetMods(bool? value)
    {
        var selectable = _parsedPresetMods
            .Where(p => !_mods.Any(m => m.WorkshopId == p.WorkshopId))
            .Select(p => p.WorkshopId);
        if (value == true)
            foreach (var id in selectable) _presetSelectedIds.Add(id);
        else
            foreach (var id in selectable) _presetSelectedIds.Remove(id);
    }

    private async Task AddWorkshopMod()
    {
        if (string.IsNullOrWhiteSpace(_workshopIdInput)) return;
        var workshopId = ParseWorkshopId(_workshopIdInput);
        if (workshopId <= 0) { Snackbar.Add("Invalid Workshop ID or URL", Severity.Error); return; }
        try
        {
            await ModService.AddWorkshopModAsync(workshopId);
            _showAddDialog = false;
            _workshopIdInput = "";
            await RefreshMods();
            Snackbar.Add("Mod added successfully", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add($"Failed: {OutputSanitizer.SanitizeException(ex)}", Severity.Error); }
    }

    private async Task ImportLocalMod()
    {
        if (string.IsNullOrWhiteSpace(_localModName) || string.IsNullOrWhiteSpace(_localModPath)) return;
        try
        {
            await ModService.ImportLocalModAsync(_localModPath, _localModName);
            _showImportDialog = false;
            _localModName = ""; _localModPath = "";
            await RefreshMods();
            Snackbar.Add("Mod imported successfully", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add($"Import failed: {OutputSanitizer.SanitizeException(ex)}", Severity.Error); }
    }

    private async Task DownloadMod(SteamMod mod, CancellationToken parentCt = default)
    {
        var cts = parentCt.CanBeCanceled
            ? CancellationTokenSource.CreateLinkedTokenSource(parentCt)
            : new CancellationTokenSource();
        _downloadCts[mod.Id] = cts;
        try
        {
            var isUpdate = mod.Status is ModStatus.UpdateAvailable or ModStatus.Installed or ModStatus.Error;
            mod.Status = isUpdate ? ModStatus.Updating : ModStatus.Downloading;
            _taskProgress[mod.Id] = 0;
            if (!_taskIds.Contains(mod.Id))
                _taskIds.Insert(0, mod.Id);
            StateHasChanged();

            if (isUpdate) await ModService.UpdateModFilesAsync(mod.Id, progress: null, cts.Token);
            else          await ModService.DownloadModAsync(mod.Id,     progress: null, cts.Token);

            _taskProgress.Remove(mod.Id);
            await RefreshMods();
            Snackbar.Add($"Downloaded {mod.Name}", Severity.Success);
        }
        catch (OperationCanceledException)
        {
            _taskProgress.Remove(mod.Id);
            Snackbar.Add($"{mod.Name}: cancelled", Severity.Info);
            await RefreshMods();
        }
        catch (Exception ex)
        {
            _taskProgress.Remove(mod.Id);
            Snackbar.Add($"Download failed: {OutputSanitizer.SanitizeException(ex)}", Severity.Error);
            await RefreshMods();
        }
        finally
        {
            _downloadCts.Remove(mod.Id);
            _queuedTaskIds.Remove(mod.Id);
            _cancellingTaskIds.Remove(mod.Id);
            cts.Dispose();
        }
    }

    private async Task DownloadModFromDialog()
    {
        if (_selectedMod == null) return;
        var mod = _selectedMod;
        _showDetailDialog = false;
        _selectedMod = null;
        await DownloadMod(mod);
    }

    private async Task DeleteMod(SteamMod mod)
    {
        await ModService.DeleteModAsync(mod.Id);
        if (_selectedMod?.Id == mod.Id) { _selectedMod = null; _showDetailDialog = false; }
        await RefreshMods();
        Snackbar.Add($"Deleted {mod.Name}", Severity.Success);
    }

    private async Task CheckForUpdates()
    {
        _isCheckingUpdates = true;
        StateHasChanged();
        try
        {
            await ModService.CheckForUpdatesAsync();
            await RefreshMods();
            Snackbar.Add(
                _outdatedCount > 0
                    ? $"{_outdatedCount} mod(s) have updates available"
                    : "All mods are up to date",
                _outdatedCount > 0 ? Severity.Warning : Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add($"Check failed: {OutputSanitizer.SanitizeException(ex)}", Severity.Error); }
        finally { _isCheckingUpdates = false; }
    }

    private async Task UpdateAllOutdated()
    {
        if (_isUpdatingAll || _isCheckingUpdates) return;
        _isUpdatingAll = true;
        _isCheckingUpdates = true;
        _bulkUpdateCts?.Dispose();
        var bulkUpdateCts = new CancellationTokenSource();
        _bulkUpdateCts = bulkUpdateCts;
        var pendingMods = new List<SteamMod>();
        StateHasChanged();
        try
        {
            // Phase 1: check Steam for manifest changes
            await ModService.CheckForUpdatesAsync(bulkUpdateCts.Token);
            await RefreshMods();
            _isCheckingUpdates = false;
            StateHasChanged();

            // Phase 2: update the selected mods through the service-owned queue.
            pendingMods = _mods
                .Where(m => m.Source == ModSource.SteamWorkshop &&
                            m.Status is ModStatus.NotInstalled or ModStatus.UpdateAvailable or ModStatus.Error)
                .ToList();
            if (pendingMods.Count == 0)
            {
                Snackbar.Add("All mods are already up to date", Severity.Success);
                return;
            }
            QueueTasks(pendingMods);
            _showDownloadsDrawer = true;
            StateHasChanged();

            // The service creates isolated, bounded-parallel workers. Awaiting
            // keeps the bulk operation tracked by this circuit for cancellation.
            await ModUpdateCoordinator.UpdateAllOutdatedModsAsync(bulkUpdateCts.Token);
            await RefreshMods();
            var failedCount = _mods.Count(m => pendingMods.Any(p => p.Id == m.Id) && m.Status == ModStatus.Error);
            Snackbar.Add(
                failedCount == 0
                    ? $"Finished updating {pendingMods.Count} mod(s)"
                    : $"Finished updating {pendingMods.Count - failedCount} mod(s); {failedCount} failed",
                failedCount == 0 ? Severity.Success : Severity.Warning);
        }
        catch (OperationCanceledException) { Snackbar.Add("Update all cancelled", Severity.Info); }
        catch (Exception ex) { Snackbar.Add($"Update failed: {OutputSanitizer.SanitizeException(ex)}", Severity.Error); }
        finally
        {
            foreach (var mod in pendingMods)
            {
                _queuedTaskIds.Remove(mod.Id);
                _cancellingTaskIds.Remove(mod.Id);
            }
            if (_bulkUpdateCts == bulkUpdateCts)
                _bulkUpdateCts = null;
            bulkUpdateCts.Dispose();
            _isUpdatingAll = false;
            _isCheckingUpdates = false;
        }
    }

    // ── Helpers ──────────────────────────────────────────────────────────────
    private static bool CanDownloadOrUpdate(SteamMod mod) => mod.Source == ModSource.SteamWorkshop;
    private void CancelModDownload(int modId)
    {
        var wasQueued = IsTaskQueued(modId);
        var cancellationRequested = false;
        if (_downloadCts.TryGetValue(modId, out var cts))
        {
            cts.Cancel();
            cancellationRequested = true;
        }
        else
        {
            cancellationRequested = wasQueued
                ? ModDownloadCancellationRegistry.CancelOrMarkPending(modId)
                : ModDownloadCancellationRegistry.Cancel(modId);
        }

        if (!cancellationRequested)
            return;

        _queuedTaskIds.Remove(modId);
        _cancellingTaskIds.Add(modId);
        StateHasChanged();
    }

    private void CancelAllDownloads()
    {
        foreach (var cts in _downloadCts.Values.ToArray()) cts.Cancel();
        _bulkUpdateCts?.Cancel();
        foreach (var mod in _mods.Where(IsTaskActive))
        {
            _queuedTaskIds.Remove(mod.Id);
            _cancellingTaskIds.Add(mod.Id);
        }
        StateHasChanged();
    }

    private async Task CheckSingleModUpdate(SteamMod mod)
    {
        _checkingMods.Add(mod.Id);
        StateHasChanged();
        try
        {
            await ModService.CheckModForUpdateAsync(mod.Id);
            await RefreshMods();
            var updated = _mods.FirstOrDefault(m => m.Id == mod.Id);
            var isOutdated = updated?.Status == ModStatus.UpdateAvailable;
            Snackbar.Add(
                isOutdated ? $"{mod.Name}: update available" : $"{mod.Name}: up to date",
                isOutdated ? Severity.Warning : Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add($"Check failed: {OutputSanitizer.SanitizeException(ex)}", Severity.Error); }
        finally { _checkingMods.Remove(mod.Id); }
    }

    private static string GetDownloadButtonLabel(SteamMod mod) => mod.Status switch
    {
        ModStatus.NotInstalled                          => "Download",
        ModStatus.UpdateAvailable                       => "Update",
        ModStatus.Error                                 => "Retry",
        ModStatus.Downloading or ModStatus.Updating     => "In Progress…",
        _                                               => "Re-download"
    };

    private static Color GetActionColor(SteamMod mod) => mod.Status switch
    {
        ModStatus.UpdateAvailable => Color.Warning,
        ModStatus.Error           => Color.Error,
        _                         => Color.Primary
    };

    private static Color GetStatusColor(ModStatus status) => status switch
    {
        ModStatus.Installed                             => Color.Success,
        ModStatus.Downloading or ModStatus.Updating     => Color.Warning,
        ModStatus.Error                                 => Color.Error,
        ModStatus.UpdateAvailable                       => Color.Warning,
        _                                               => Color.Default
    };

    private static string GetActionIcon(SteamMod mod) => mod.Status switch
    {
        ModStatus.UpdateAvailable                   => Icons.Material.Filled.SystemUpdateAlt,
        ModStatus.Error                             => Icons.Material.Filled.Refresh,
        ModStatus.Downloading or ModStatus.Updating => Icons.Material.Filled.CloudDownload,
        ModStatus.Installed                         => Icons.Material.Outlined.CloudDownload,
        _                                           => Icons.Material.Filled.CloudDownload
    };

    private static string GetStatusIcon(ModStatus status) => status switch
    {
        ModStatus.Installed       => Icons.Material.Filled.CheckCircle,
        ModStatus.Downloading     => Icons.Material.Filled.CloudDownload,
        ModStatus.Updating        => Icons.Material.Filled.Sync,
        ModStatus.Error           => Icons.Material.Filled.Error,
        ModStatus.UpdateAvailable => Icons.Material.Filled.NewReleases,
        _                         => Icons.Material.Outlined.RadioButtonUnchecked
    };

    private static long ParseWorkshopId(string input)
    {
        if (long.TryParse(input.Trim(), out var directId)) return directId;
        if (input.Contains("id="))
        {
            var idPart = input.Split("id=").Last().Split('&').First();
            if (long.TryParse(idPart, out var urlId)) return urlId;
        }
        return -1;
    }

    private static string FormatBytes(long bytes)
    {
        string[] sizes = ["B", "KB", "MB", "GB", "TB"];
        int order = 0; double size = bytes;
        while (size >= 1024 && order < sizes.Length - 1) { order++; size /= 1024; }
        return $"{size:F1} {sizes[order]}";
    }

    private static string FormatRelativeTime(DateTime utc)
    {
        var elapsed = DateTime.UtcNow - utc;
        if (elapsed.TotalSeconds < 60)  return "Just now";
        if (elapsed.TotalMinutes < 60)  return $"{(int)elapsed.TotalMinutes}m ago";
        if (elapsed.TotalHours   < 24)  return $"{(int)elapsed.TotalHours}h ago";
        if (elapsed.TotalDays    < 30)  return $"{(int)elapsed.TotalDays}d ago";
        if (elapsed.TotalDays    < 365) return $"{(int)(elapsed.TotalDays / 30)}mo ago";
        return $"{(int)(elapsed.TotalDays / 365)}y ago";
    }

    /// <summary>
    /// Converts a Steam Workshop BBCode description to safe HTML for rendering.
    /// Handles all documented Steam BBCode tags.
    /// </summary>
    private static MarkupString RenderDescription(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return new MarkupString(string.Empty);

        const RegexOptions SI = RegexOptions.Singleline | RegexOptions.IgnoreCase;
        const RegexOptions I  = RegexOptions.IgnoreCase;

        var t = raw.Replace("\r\n", "\n").Replace("\r", "\n");

        // 1. <br> → \n, then decode HTML entities
        t = Regex.Replace(t, @"<br\s*/?>", "\n", I);
        t = WebUtility.HtmlDecode(t);

        // 2. HTML-encode to prevent XSS — BBCode [tags] use [ ] which are not HTML-special
        t = WebUtility.HtmlEncode(t);

        // 3. [noparse] — strip the wrapper, leave content as literal text
        t = Regex.Replace(t, @"\[noparse\](.*?)\[/noparse\]", "$1", SI);

        // 4. Headings
        t = Regex.Replace(t, @"\[h1\](.*?)\[/h1\]", "<strong class=\"bb-h1\">$1</strong>", SI);
        t = Regex.Replace(t, @"\[h2\](.*?)\[/h2\]", "<strong class=\"bb-h2\">$1</strong>", SI);
        t = Regex.Replace(t, @"\[h3\](.*?)\[/h3\]", "<strong class=\"bb-h3\">$1</strong>", SI);

        // 5. Inline formatting
        t = Regex.Replace(t, @"\[b\](.*?)\[/b\]",           "<strong>$1</strong>",  SI);
        t = Regex.Replace(t, @"\[i\](.*?)\[/i\]",           "<em>$1</em>",          SI);
        t = Regex.Replace(t, @"\[u\](.*?)\[/u\]",           "<u>$1</u>",            SI);
        t = Regex.Replace(t, @"\[strike\](.*?)\[/strike\]", "<s>$1</s>",            SI);
        t = Regex.Replace(t, @"\[spoiler\](.*?)\[/spoiler\]",
            "<span style=\"background:currentColor;color:transparent;border-radius:2px;padding:0 2px;\" title=\"spoiler\">$1</span>", SI);

        // 6. URLs — only http/https allowed (prevents javascript: etc.)
        t = Regex.Replace(t, @"\[url=(https?://[^\]]*?)\](.*?)\[/url\]",
            "<a href=\"$1\" target=\"_blank\" rel=\"noopener noreferrer\">$2</a>", SI);
        t = Regex.Replace(t, @"\[url\](https?://[^\[]*?)\[/url\]",
            "<a href=\"$1\" target=\"_blank\" rel=\"noopener noreferrer\">$1</a>", SI);

        // 7. Horizontal rule
        t = Regex.Replace(t, @"\[hr\](\[/hr\])?", "<hr class=\"bb-hr\" />", I);

        // 8. Images — only http/https
        t = Regex.Replace(t, @"\[img\](https?://[^\[]*?)\[/img\]",
            "<img src=\"$1\" class=\"bb-img\" alt=\"\" loading=\"lazy\" />", SI);

        // 9. Lists — inline formatting inside items already processed above
        t = Regex.Replace(t, @"\[list\](.*?)\[/list\]", m =>
        {
            var inner = Regex.Replace(m.Groups[1].Value, @"\[\*\]([^\[]*)", "<li>$1</li>", I);
            return $"<ul class=\"bb-list\">{inner}</ul>";
        }, SI);
        t = Regex.Replace(t, @"\[olist\](.*?)\[/olist\]", m =>
        {
            var inner = Regex.Replace(m.Groups[1].Value, @"\[\*\]([^\[]*)", "<li>$1</li>", I);
            return $"<ol class=\"bb-list\">{inner}</ol>";
        }, SI);
        // standalone [*] outside list wrappers → bullet
        t = Regex.Replace(t, @"\[\*\]", "&bull; ", I);

        // 10. Quotes
        t = Regex.Replace(t, @"\[quote(?:=[^\]]+)?\](.*?)\[/quote\]",
            "<blockquote class=\"bb-quote\">$1</blockquote>", SI);

        // 11. Code
        t = Regex.Replace(t, @"\[code\](.*?)\[/code\]",
            "<pre class=\"bb-code\">$1</pre>", SI);

        // 12. Tables
        t = Regex.Replace(t, @"\[table[^\]]*\](.*?)\[/table\]", "<table class=\"bb-table\">$1</table>", SI);
        t = Regex.Replace(t, @"\[tr\](.*?)\[/tr\]", "<tr>$1</tr>",   SI);
        t = Regex.Replace(t, @"\[th\](.*?)\[/th\]", "<th>$1</th>",   SI);
        t = Regex.Replace(t, @"\[td\](.*?)\[/td\]", "<td>$1</td>",   SI);

        // 13. [p] paragraphs
        t = Regex.Replace(t, @"\[p\](.*?)\[/p\]", "<p style=\"margin:.4em 0;\">$1</p>", SI);

        // 14. Strip any remaining unrecognised BBCode tags
        t = Regex.Replace(t, @"\[/?[a-zA-Z0-9*]+(?:=[^\]]+)?\]", "", I);

        // 15. Newlines → <br>, collapse triple-br
        t = t.Replace("\n", "<br />");
        t = Regex.Replace(t, @"(<br />){3,}", "<br /><br />");

        return new MarkupString(t.Trim());
    }
}
