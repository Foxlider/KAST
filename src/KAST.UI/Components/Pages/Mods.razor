@page "/mods"
@attribute [Authorize]
@using KAST.Infrastructure.Services.Content
@inject IModService ModService
@inject IAppEventBroadcaster Broadcaster
@inject ContentProgressTracker ContentTracker
@inject ISnackbar Snackbar
@inject ModDownloadManager DownloadManager
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>KAST -- Mods</PageTitle>

@* ── Top bar ── *@
<div class="d-flex justify-space-between align-center mb-3 flex-wrap gap-2">
    <div class="d-flex align-center gap-3">
        <MudToggleGroup T="string" @bind-Value="_viewMode" Size="Size.Small" Class="mr-2">
            <MudToggleItem Value="@("table")">
                <MudIcon Icon="@Icons.Material.Filled.TableRows" />
            </MudToggleItem>
            <MudToggleItem Value="@("cards")">
                <MudIcon Icon="@Icons.Material.Filled.GridView" />
            </MudToggleItem>
        </MudToggleGroup>
        <MudText Typo="Typo.h5">Mod Management</MudText>
        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
            @_mods.Count total
        </MudChip>
        @if (_outdatedCount > 0)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled"
                     Icon="@Icons.Material.Filled.SystemUpdateAlt">
                @_outdatedCount outdated
            </MudChip>
        }
        @if (_errorCount > 0)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                     Icon="@Icons.Material.Filled.Error">
                @_errorCount error(s)
            </MudChip>
        }
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => _showAddDialog = true)">
            Add Mod
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="@(() => _showImportDialog = true)">
            Import Local
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.PlaylistAdd" OnClick="@(() => _showPresetImportDialog = true)">
            Import Preset
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Info"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="CheckForUpdates"
                   Disabled="_isCheckingUpdates || _isUpdatingAll">
            @(_isCheckingUpdates && !_isUpdatingAll ? "Checking…" : "Check for Updates")
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.CloudDownload"
                   OnClick="UpdateAllOutdated"
                   Disabled="_isUpdatingAll || _isCheckingUpdates || DownloadManager.ActiveCount > 0">
            @if (_isCheckingUpdates)
            {
                @("Checking…")
            }
            else if (_isUpdatingAll)
            {
                @("Queuing…")
            }
            else if (_pendingCount > 0)
            {
                @($"Update All ({_pendingCount})")
            }
            else
            {
                @("Update All")
            }
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Construction"
                   OnClick="RepairAllMods"
                   Disabled="_isUpdatingAll || _isCheckingUpdates || DownloadManager.ActiveCount > 0">
            Repair All
        </MudButton>
    </div>
</div>

@{
    var activeDownloads = _mods
        .Where(m => m.Status is ModStatus.Downloading or ModStatus.Updating)
        .OrderBy(m => m.ExpectedSizeBytes)
        .ToList();
    var queuedDownloads = _mods
        .Where(m => _queuedModIds.Contains(m.Id) &&
                    m.Status is not (ModStatus.Downloading or ModStatus.Updating))
        .OrderBy(m => m.ExpectedSizeBytes)
        .ToList();
    var hasActive = activeDownloads.Count > 0;
    var hasQueued = queuedDownloads.Count > 0;
}

<MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true">

    @* ════════════ MODS TAB ════════════ *@
    <MudTabPanel Text="Mods" BadgeData="@(_mods.Count > 0 ? _mods.Count.ToString() : null)" BadgeColor="Color.Primary">
        @if (_mods.Count == 0)
        {
            <MudPaper Class="pa-8 d-flex flex-column align-center" Elevation="1">
                <MudIcon Icon="@Icons.Material.Filled.Extension" Size="Size.Large" Color="Color.Secondary" Class="mb-3" />
                <MudText Typo="Typo.h6" Color="Color.Secondary">No mods yet</MudText>
                <MudText Color="Color.Secondary" Class="mb-3">
                    Add mods from the Steam Workshop or import local mods to get started.
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => _showAddDialog = true)">
                    Add Your First Mod
                </MudButton>
            </MudPaper>
        }
        else if (_viewMode == "table")
        {
            <MudDataGrid T="SteamMod" Items="@_mods" Filterable="true" SortMode="SortMode.Multiple"
                         Hover="true" Dense="true" RowClick="@(args => ShowModDetails(args.Item))"
                         Virtualize="true" FixedHeader="true" Height="@GridHeight"
                         MultiSelection="true" @bind-SelectedItems="_selectedMods">
        <Columns>
            <SelectColumn T="SteamMod" />
            <TemplateColumn Title="" HeaderStyle="width:48px" Sortable="false" Filterable="false">
                <CellTemplate>
                    @if (!string.IsNullOrEmpty(context.Item.ThumbnailUrl))
                    {
                        <img src="@context.Item.ThumbnailUrl" alt=""
                             style="width:36px;height:36px;object-fit:cover;border-radius:4px;display:block;" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Outlined.Extension" Style="opacity:.4;" />
                    }
                </CellTemplate>
            </TemplateColumn>

            <PropertyColumn Property="m => m.Name" Title="Name" Sortable="true" HeaderStyle="min-width:150px; max-width:260px;">
                <CellTemplate>
                    <MudText Style="cursor:pointer; font-weight:500;">@context.Item.Name</MudText>
                    @if (context.Item.Author != null)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Item.Author</MudText>
                    }
                </CellTemplate>
            </PropertyColumn>

            <PropertyColumn Property="m => m.Source" Title="Source" Sortable="true" HeaderStyle="width:110px" />

            <TemplateColumn Title="Status" Sortable="false" HeaderStyle="width:180px">
                <CellTemplate>
                    @{
                        var isActive = context.Item.Status is ModStatus.Downloading or ModStatus.Updating;
                        var pct = GetModProgress(context.Item.Id);
                    }
                    @if (isActive)
                    {
                        <div style="min-width:140px;">
                            <div class="d-flex justify-space-between mb-1">
                                <MudText Typo="Typo.caption" Color="Color.Warning">@context.Item.Status</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@pct.ToString("F0")%</MudText>
                            </div>
                            <MudProgressLinear Value="@pct" Min="0" Max="100"
                                              Color="Color.Warning" Rounded="true" Size="Size.Small" />
                        </div>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small"
                                 Color="@UiHelpers.GetModStatusColor(context.Item.Status)"
                                 Variant="Variant.Outlined"
                                 Icon="@UiHelpers.GetModStatusIcon(context.Item.Status)">
                            @context.Item.Status
                        </MudChip>
                    }
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn Title="Size" Sortable="false" HeaderStyle="white-space:nowrap;">
                <CellTemplate>
                    <MudText Typo="Typo.body2" Style="white-space:nowrap;">
                        @(context.Item.SizeBytes > 0 ? UiHelpers.FormatBytes(context.Item.SizeBytes) : "—")
                    </MudText>
                    @if (context.Item.ExpectedSizeBytes > 0 && context.Item.SizeBytes == 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="white-space:nowrap;">
                            ~@UiHelpers.FormatBytes(context.Item.ExpectedSizeBytes)
                        </MudText>
                    }
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn Title="Version" Sortable="false" HeaderStyle="width:80px">
                <CellTemplate>
                    @if (context.Item.InstalledManifestId > 0)
                    {
                        var isLatest = context.Item.SteamManifestId == 0 ||
                                       context.Item.InstalledManifestId == context.Item.SteamManifestId;
                        <MudTooltip Text="@(isLatest ? "Up to date" : "Outdated — manifest ID differs from Steam")" Arrow="true">
                            <MudIcon Icon="@(isLatest ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.NewReleases)"
                                     Color="@(isLatest ? Color.Success : Color.Warning)"
                                     Size="Size.Small" />
                        </MudTooltip>
                    }
                    else if (context.Item.Status == ModStatus.Installed)
                    {
                        <MudTooltip Text="Manifest not tracked — run Check for Updates" Arrow="true">
                            <MudIcon Icon="@Icons.Material.Filled.HelpOutline"
                                     Color="Color.Default" Size="Size.Small" Style="opacity:.4;" />
                        </MudTooltip>
                    }
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn Title="Last Checked" Sortable="false" HeaderStyle="width:110px">
                <CellTemplate>
                    @if (context.Item.LastChecked.HasValue)
                    {
                        <MudTooltip Text="@context.Item.LastChecked.Value.ToLocalTime().ToString("g")" Arrow="true">
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="white-space:nowrap;">
                                @UiHelpers.FormatRelativeTime(context.Item.LastChecked.Value)
                            </MudText>
                        </MudTooltip>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="opacity:.4;">Never</MudText>
                    }
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn Title="Actions" Sortable="false" HeaderStyle="width:118px" Filterable="false">
                <CellTemplate>
                    <div class="d-flex gap-0 justify-end" @onclick:stopPropagation="true">
                        @if (context.Item.Source == ModSource.SteamWorkshop &&
                             context.Item.Status == ModStatus.Installed)
                        {
                            <MudTooltip Text="Check for Update" Arrow="true">
                                <MudIconButton Icon="@Icons.Material.Outlined.ManageSearch"
                                               Size="Size.Small" Color="Color.Info"
                                               Disabled="@_checkingMods.Contains(context.Item.Id)"
                                               OnClick="@(() => CheckSingleModUpdate(context.Item))" />
                            </MudTooltip>
                        }
                        @if (context.Item.Status is ModStatus.Downloading or ModStatus.Updating)
                        {
                            <MudTooltip Text="Cancel" Arrow="true">
                                <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                               Size="Size.Small" Color="Color.Warning"
                                               OnClick="@(() => CancelModDownload(context.Item.Id))" />
                            </MudTooltip>
                        }
                        else if (CanDownloadOrUpdate(context.Item))
                        {
                            <MudTooltip Text="@GetDownloadButtonLabel(context.Item)" Arrow="true">
                                <MudIconButton Icon="@GetActionIcon(context.Item)"
                                               Size="Size.Small"
                                               Color="@GetActionColor(context.Item)"
                                               OnClick="@(() => DownloadMod(context.Item))" />
                            </MudTooltip>
                        }
                        <MudTooltip Text="Delete" Arrow="true">
                            <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                           Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => ShowDeleteModDialog(context.Item))" />
                        </MudTooltip>
                    </div>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
    @if (_selectedMods?.Count > 0)
    {
        <MudPaper Class="pa-3 d-flex align-center gap-3"
                  Style="position:sticky; bottom:0; z-index:10; border-top:2px solid var(--mud-palette-primary);"
                  Elevation="8">
            <MudText Typo="Typo.body2" Style="font-weight:600;">@_selectedMods.Count mod(s) selected</MudText>
            <div style="flex:1;"></div>
            <MudButton Variant="Variant.Filled" Color="Color.Error"
                       StartIcon="@Icons.Material.Outlined.Delete"
                       Size="Size.Small"
                       OnClick="ShowBulkDeleteDialog">
                Delete Selected
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Size="Size.Small"
                       OnClick="ClearSelection">
                Cancel Selection
            </MudButton>
        </MudPaper>
    }
}
else
{
    <MudGrid>
        @foreach (var mod in _mods)
        {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <div @onclick="@(() => ShowModDetails(mod))" style="cursor:pointer;">
                <MudCard Elevation="1" Class="mb-3">
                    @if (!string.IsNullOrEmpty(mod.ThumbnailUrl))
                    {
                        <MudCardMedia Image="@mod.ThumbnailUrl" Height="160" />
                    }
                    else
                    {
                        <div style="height:160px; display:flex; align-items:center; justify-content:center; background:var(--mud-palette-background-grey);">
                            <MudIcon Icon="@Icons.Material.Outlined.Extension" Size="Size.Large" Style="opacity:.35;" />
                        </div>
                    }
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle2" Style="font-weight:600;">@mod.Name</MudText>
                        @if (mod.Author != null)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@mod.Author</MudText>
                        }
                        <div class="d-flex align-center gap-2 mt-2">
                            <MudChip T="string" Size="Size.Small"
                                     Color="@UiHelpers.GetModStatusColor(mod.Status)"
                                     Variant="Variant.Outlined"
                                     Icon="@UiHelpers.GetModStatusIcon(mod.Status)">
                                @mod.Status
                            </MudChip>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @(mod.SizeBytes > 0 ? UiHelpers.FormatBytes(mod.SizeBytes) : "—")
                            </MudText>
                        </div>
                    </MudCardContent>
                </MudCard>
                </div>
            </MudItem>
        }
    </MudGrid>
}
    </MudTabPanel>

    @* ════════════ DOWNLOADS TAB ════════════ *@
    <MudTabPanel Text="Downloads" BadgeData="@(hasActive || hasQueued ? (activeDownloads.Count + queuedDownloads.Count).ToString() : null)" BadgeColor="@(hasActive ? Color.Primary : Color.Warning)">
        <div class="d-flex gap-3" style="min-height:300px;">
            @* ── Active Downloads (Left) ── *@
            <div style="flex:1;">
                <MudText Typo="Typo.h6" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.CloudDownload" Color="Color.Primary" Size="Size.Small" Class="mr-1" />
                    Active (@activeDownloads.Count)
                </MudText>
                @if (activeDownloads.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Default">No active downloads.</MudText>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var mod in activeDownloads)
                        {
                            var pct = GetModProgress(mod.Id);
                            var speed = _downloadSpeed.GetValueOrDefault(mod.Id, 0);
                            var files = GetModFileProgress(mod.Id);
                            var expanded = _expandedDownloadModIds.Contains(mod.Id);
                            var status = GetModDownloadStatus(mod.Id);
                            <div class="mod-download">
                                <button type="button" class="mod-download-header" @onclick="@(() => ToggleDownloadExpanded(mod.Id))">
                                    @if (!string.IsNullOrEmpty(mod.ThumbnailUrl))
                                    {
                                        <img src="@mod.ThumbnailUrl" alt="" class="mod-download-thumb" />
                                    }
                                    <div class="mod-download-title">
                                        <MudText Typo="Typo.body2">@mod.Name</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@status</MudText>
                                    </div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mod-download-size">@FormatDownloadSize(mod.ExpectedSizeBytes)</MudText>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Info">@pct.ToString("F0")%</MudChip>
                                    <MudIcon Icon="@(expanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" />
                                </button>
                                @if (expanded)
                                {
                                    <div class="mod-download-files">
                                        @if (files.Count == 0)
                                        {
                                            <div class="mod-download-file-row">
                                                <div class="mod-download-file-name">Preparing file list...</div>
                                                <div class="mod-download-file-progress">
                                                    <MudProgressLinear Value="@pct" Min="0" Max="100" Color="Color.Primary" Rounded="true" Size="Size.Small" />
                                                    <span>@pct.ToString("F0")%@(speed > 0 ? $" - {UiHelpers.FormatBytes((long)speed)}/s" : "")</span>
                                                </div>
                                                <div class="mod-download-file-size">@FormatDownloadSize(mod.ExpectedSizeBytes)</div>
                                            </div>
                                        }
                                        else
                                        {
                                            @foreach (var file in files)
                                            {
                                                <div class="mod-download-file-row">
                                                    <div class="mod-download-file-name" title="@file.FileName">@file.FileName</div>
                                                    <div class="mod-download-file-progress">
                                                        <MudProgressLinear Value="@file.ProgressPercent" Min="0" Max="100"
                                                                           Color="@(file.IsSkipped ? Color.Warning : Color.Primary)"
                                                                           Rounded="true" Size="Size.Small" />
                                                        <span>@FormatFileProgress(file)</span>
                                                    </div>
                                                    <div class="mod-download-file-size">@FormatDownloadSize(file.TotalBytes)</div>
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            @* ── Queue (Right) ── *@
            <div style="flex:1;">
                <MudText Typo="Typo.h6" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Queue" Color="Color.Warning" Size="Size.Small" Class="mr-1" />
                    Queue (@queuedDownloads.Count)
                </MudText>
                @if (queuedDownloads.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Default">Nothing queued.</MudText>
                }
                else
                {
                    <div class="d-flex flex-column gap-1" style="max-height:60vh; overflow-y:auto;">
                        @foreach (var mod in queuedDownloads)
                        {
                            <div class="d-flex align-center gap-2 pa-2" style="border:1px solid var(--mud-palette-divider); border-radius:4px;">
                                @if (!string.IsNullOrEmpty(mod.ThumbnailUrl))
                                {
                                    <img src="@mod.ThumbnailUrl" alt="" style="width:20px;height:20px;object-fit:cover;border-radius:2px;" />
                                }
                                <div style="flex:1; min-width:0;">
                                    <MudText Typo="Typo.body2" Style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@mod.Name</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@UiHelpers.FormatBytes(mod.ExpectedSizeBytes)</MudText>
                                </div>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                         Color="@(mod.Status == ModStatus.Error ? Color.Error : mod.Status == ModStatus.UpdateAvailable ? Color.Warning : Color.Default)">
                                    @mod.Status
                                </MudChip>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </MudTabPanel>

</MudTabs>

@* ── Mod Detail Dialog ── *@
<MudDialog @bind-Visible="_showDetailDialog" Options="_detailDialogOptions">
    <TitleContent>
        <div class="d-flex align-center gap-3 flex-wrap">
            <MudChip T="string" Size="Size.Small"
                     Color="@UiHelpers.GetModStatusColor(_selectedMod?.Status ?? ModStatus.NotInstalled)"
                      Variant="Variant.Filled"
                      Icon="@UiHelpers.GetModStatusIcon(_selectedMod?.Status ?? ModStatus.NotInstalled)">
                @_selectedMod?.Status
            </MudChip>
            <MudText Typo="Typo.h6">@_selectedMod?.Name</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_selectedMod != null)
        {
            <div class="d-flex gap-4 flex-wrap">
                @if (!string.IsNullOrEmpty(_selectedMod.ThumbnailUrl))
                {
                    <img src="@_selectedMod.ThumbnailUrl" alt="@_selectedMod.Name"
                         style="width:200px;height:200px;object-fit:cover;border-radius:8px;flex-shrink:0;align-self:flex-start;" />
                }
                <div style="flex:1; min-width:260px;">
                    <MudSimpleTable Dense="true" Hover="false" Style="background:transparent;">
                        <tbody>
                            @if (_selectedMod.Author != null)
                            {
                                <tr><td style="width:130px;opacity:.7;">Author</td><td>@_selectedMod.Author</td></tr>
                            }
                            <tr><td style="opacity:.7;">Source</td><td>@_selectedMod.Source</td></tr>
                            @if (_selectedMod.WorkshopId > 0)
                            {
                                <tr>
                                    <td style="opacity:.7;">Workshop ID</td>
                                    <td>
                                        <MudLink Href="@($"https://steamcommunity.com/sharedfiles/filedetails/?id={_selectedMod.WorkshopId}")"
                                                 Target="_blank" Typo="Typo.body2">
                                            @_selectedMod.WorkshopId
                                        </MudLink>
                                    </td>
                                </tr>
                            }
                            <tr>
                                <td style="opacity:.7;">Size on Disk</td>
                                <td>@(_selectedMod.SizeBytes > 0 ? UiHelpers.FormatBytes(_selectedMod.SizeBytes) : "Not downloaded")</td>
                            </tr>
                            @if (_selectedMod.ExpectedSizeBytes > 0)
                            {
                                <tr><td style="opacity:.7;">Steam Size</td><td>@UiHelpers.FormatBytes(_selectedMod.ExpectedSizeBytes)</td></tr>
                            }
                            @if (_selectedMod.InstalledManifestId > 0)
                            {
                                <tr>
                                    <td style="opacity:.7;">Installed Manifest</td>
                                    <td><code style="font-size:11px;">@_selectedMod.InstalledManifestId</code></td>
                                </tr>
                            }
                            @if (_selectedMod.SteamManifestId > 0)
                            {
                                <tr>
                                    <td style="opacity:.7;">Steam Manifest</td>
                                    <td>
                                        <code style="font-size:11px;">@_selectedMod.SteamManifestId</code>
                                        @if (_selectedMod.InstalledManifestId > 0)
                                        {
                                            @if (_selectedMod.InstalledManifestId == _selectedMod.SteamManifestId)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                                         Color="Color.Success" Size="Size.Small" Class="ml-1" />
                                            }
                                            else
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.NewReleases"
                                                         Color="Color.Warning" Size="Size.Small" Class="ml-1" />
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                            @if (_selectedMod.LastUpdatedSteam.HasValue)
                            {
                                <tr><td style="opacity:.7;">Updated (Steam)</td><td>@_selectedMod.LastUpdatedSteam.Value.ToLocalTime().ToString("g")</td></tr>
                            }
                            @if (_selectedMod.LastUpdatedLocal.HasValue)
                            {
                                <tr><td style="opacity:.7;">Updated (Local)</td><td>@_selectedMod.LastUpdatedLocal.Value.ToLocalTime().ToString("g")</td></tr>
                            }
                            @if (_selectedMod.LastChecked.HasValue)
                            {
                                <tr><td style="opacity:.7;">Last Checked</td><td>@_selectedMod.LastChecked.Value.ToLocalTime().ToString("g")</td></tr>
                            }
                            @if (!string.IsNullOrWhiteSpace(_selectedMod.LocalPath))
                            {
                                <tr>
                                    <td style="opacity:.7;vertical-align:top;">Path</td>
                                    <td><code style="font-size:11px; word-break:break-all;">@_selectedMod.LocalPath</code></td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_selectedMod.Description))
            {
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle2" Class="mb-1">Description</MudText>
                <MudPaper Elevation="0" Class="pa-3 mod-description" Style="background:var(--mud-palette-background-grey); border-radius:6px; max-height:300px; overflow-y:auto;">
                    @RenderDescription(_selectedMod.Description)
                </MudPaper>
            }
            <MudDivider Class="my-3" />
            <MudTextField @bind-Value="_commentInput"
                          Label="Notes / Comment"
                          Placeholder="Add a personal note about this mod…"
                          Lines="3" FullWidth="true"
                          Variant="Variant.Outlined"
                          @onblur="SaveComment" />
        }
    </DialogContent>
    <DialogActions>
        @if (_selectedMod != null && CanDownloadOrUpdate(_selectedMod))
        {
            <MudButton Variant="Variant.Filled" Color="@GetActionColor(_selectedMod)"
                       OnClick="DownloadModFromDialog"
                       Disabled="@(_selectedMod.Status is ModStatus.Downloading or ModStatus.Updating)">
                @GetDownloadButtonLabel(_selectedMod)
            </MudButton>
        }
        <MudButton OnClick="@(() => _showDetailDialog = false)">Close</MudButton>
    </DialogActions>
</MudDialog>

@* ── Add Workshop Mod Dialog ── *@
<MudDialog @bind-Visible="_showAddDialog">
    <TitleContent><MudText Typo="Typo.h6">Add Workshop Mod</MudText></TitleContent>
    <DialogContent>
