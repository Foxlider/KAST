    private void OpenUploadDialog() { _showUploadDialog = true; _uploadFiles = []; }

    private async Task OpenFilePicker()
    {
        if (_fileUpload != null)
            await _fileUpload.OpenFilePickerAsync();
    }

    private void CloseUploadDialog()
    {
        _showUploadDialog = false;
        _uploadFiles = [];
        _uploadProgress = 0;
        _uploadStatusText = "";
    }

    private void OnUploadFilesSelected(IReadOnlyList<IBrowserFile> files)
    {
        _uploadFiles = files.Where(f => f.Name.EndsWith(".pbo", StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private async Task ConfirmUpload()
    {
        if (_uploadFiles.Count == 0) return;

        _isUploading = true;
        _uploadProgress = 0;
        int uploaded = 0;
        int failed = 0;

        for (int i = 0; i < _uploadFiles.Count; i++)
        {
            var file = _uploadFiles[i];
            _uploadStatusText = $"Uploading {i + 1} of {_uploadFiles.Count}: {file.Name}";
            _uploadProgress = (double)i / _uploadFiles.Count * 100;
            StateHasChanged();

            try
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 500 * 1024 * 1024);
                await MissionService.UploadMissionAsync(Instance.Id, file.Name, stream);
                uploaded++;
            }
            catch (InvalidOperationException ex)
            {
                failed++;
                Snackbar.Add($"Failed: {file.Name} — {ex.Message}", Severity.Error);
            }
            catch (IOException ex)
            {
                failed++;
                Snackbar.Add($"Failed: {file.Name}: {ex.Message}", Severity.Error);
            }
            catch (UnauthorizedAccessException ex)
            {
                failed++;
                Snackbar.Add($"Failed: {file.Name}: {ex.Message}", Severity.Error);
            }
        }

        _uploadProgress = 100;
        _uploadStatusText = uploaded > 0
            ? $"Uploaded {uploaded} file(s)" + (failed > 0 ? $", {failed} failed" : "")
            : "Upload failed";
        StateHasChanged();

        if (uploaded > 0)
        {
            Snackbar.Add($"Uploaded {uploaded} mission(s)", Severity.Success);
            await RefreshAll();
        }

        CloseUploadDialog();
        _isUploading = false;
        StateHasChanged();
    }

