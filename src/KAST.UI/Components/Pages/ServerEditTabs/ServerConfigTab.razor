@* Server Config: structured fields + raw server.cfg editor *@

<MudGrid Class="mt-3">
    <MudItem xs="12" md="6">
        <MudCard Elevation="1" Class="mb-3">
            <MudCardContent>
                <MudText Typo="Typo.subtitle1" Class="mb-2">Server Options</MudText>
                <MudTextField Value="@Config.Hostname"
                              ValueChanged="@((string v) => { Config.Hostname = v; _ = OnConfigChanged.InvokeAsync(); })"
                              Label="Hostname" FullWidth="true" Class="mb-2" />
                <MudTextField Value="@Config.Password"
                              ValueChanged="@((string v) => { Config.Password = v; _ = OnConfigChanged.InvokeAsync(); })"
                              Label="Server Password" FullWidth="true" Class="mb-2" />
                <MudTextField Value="@Config.PasswordAdmin"
                              ValueChanged="@((string v) => { Config.PasswordAdmin = v; _ = OnConfigChanged.InvokeAsync(); })"
                              Label="Admin Password" FullWidth="true" Class="mb-2" />
                <MudNumericField T="int" Value="@Config.MaxPlayers"
                                 ValueChanged="@((int v) => { Config.MaxPlayers = v; _ = OnConfigChanged.InvokeAsync(); })"
                                 Label="Max Players" Min="1" Max="128" />
            </MudCardContent>
        </MudCard>
        <MudCard Elevation="1" Class="mb-3">
            <MudCardContent>
                <MudText Typo="Typo.subtitle1" Class="mb-2">Joining Rules</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="6"><MudSwitch @bind-Value="Config.BattlEye" Label="BattlEye" Color="Color.Primary" /></MudItem>
                    <MudItem xs="6"><MudSwitch @bind-Value="Config.KickDuplicate" Label="Kick Duplicates" Color="Color.Primary" /></MudItem>
                    <MudItem xs="6"><MudSwitch @bind-Value="Config.Loopback" Label="LAN Mode" Color="Color.Primary" /></MudItem>
                    <MudItem xs="6"><MudSwitch @bind-Value="Config.Upnp" Label="UPnP" Color="Color.Primary" /></MudItem>
                    <MudItem xs="6" sm="4">
                        <MudSelect Value="@Config.VerifySignatures.ToString()"
                                   ValueChanged="@((string v) => { Config.VerifySignatures = int.Parse(v); _ = OnConfigChanged.InvokeAsync(); })"
                                   Label="Verify Signatures" FullWidth="true">
                            <MudSelectItem Value="@("0")">Disabled</MudSelectItem>
                            <MudSelectItem Value="@("1")">Deprecated (v1+v2)</MudSelectItem>
                            <MudSelectItem Value="@("2")">Activated (v2)</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudSelect Value="@Config.AllowedFilePatching.ToString()"
                                   ValueChanged="@((string v) => { Config.AllowedFilePatching = int.Parse(v); _ = OnConfigChanged.InvokeAsync(); })"
                                   Label="File Patching" FullWidth="true">
                            <MudSelectItem Value="@("0")">No Clients</MudSelectItem>
                            <MudSelectItem Value="@("1")">HC Only</MudSelectItem>
                            <MudSelectItem Value="@("2")">All Clients</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                </MudGrid>
            </MudCardContent>
        </MudCard>
        <MudCard Elevation="1" Class="mb-3">
            <MudCardContent>
                <MudText Typo="Typo.subtitle1" Class="mb-2">Timeouts &amp; Kick</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="6"><MudNumericField T="int" Value="@Config.MaxPing" ValueChanged="@((int v) => { Config.MaxPing = v; _ = OnConfigChanged.InvokeAsync(); })" Label="Max Ping" /></MudItem>
                    <MudItem xs="6"><MudNumericField T="int" Value="@Config.MaxDesync" ValueChanged="@((int v) => { Config.MaxDesync = v; _ = OnConfigChanged.InvokeAsync(); })" Label="Max Desync" /></MudItem>
                    <MudItem xs="6"><MudNumericField T="int" Value="@Config.MaxPacketLoss" ValueChanged="@((int v) => { Config.MaxPacketLoss = v; _ = OnConfigChanged.InvokeAsync(); })" Label="Max Packet Loss" /></MudItem>
                    <MudItem xs="6"><MudNumericField T="int" Value="@Config.DisconnectTimeout" ValueChanged="@((int v) => { Config.DisconnectTimeout = v; _ = OnConfigChanged.InvokeAsync(); })" Label="Disconnect Timeout" Min="5" Max="90" /></MudItem>
                    <MudItem xs="6"><MudNumericField T="int" Value="@Config.LobbyIdleTimeout" ValueChanged="@((int v) => { Config.LobbyIdleTimeout = v; _ = OnConfigChanged.InvokeAsync(); })" Label="Lobby Idle Timeout" /></MudItem>
                    <MudItem xs="6"><MudSwitch @bind-Value="Config.KickClientOnSlowNetwork" Label="Kick on Slow Network" Color="Color.Warning" /></MudItem>
                </MudGrid>
            </MudCardContent>
        </MudCard>
        <MudCard Elevation="1" Class="mb-3">
            <MudCardContent>
                <MudText Typo="Typo.subtitle1" Class="mb-2">VoN &amp; Audio</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="6"><MudSwitch @bind-Value="Config.DisableVoN" Label="Disable VoN" Color="Color.Error" /></MudItem>
                    <MudItem xs="6">
                        <MudSelect Value="@Config.VonCodec.ToString()"
                                   ValueChanged="@((string v) => { Config.VonCodec = int.Parse(v); _ = OnConfigChanged.InvokeAsync(); })"
                                   Label="Codec" FullWidth="true">
                            <MudSelectItem Value="@("0")">SPEEX</MudSelectItem>
                            <MudSelectItem Value="@("1")">OPUS</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="6"><MudNumericField T="int" Value="@Config.VonCodecQuality" ValueChanged="@((int v) => { Config.VonCodecQuality = v; _ = OnConfigChanged.InvokeAsync(); })" Label="Codec Quality (1-30)" Min="1" Max="30" /></MudItem>
                </MudGrid>
            </MudCardContent>
        </MudCard>
        <MudCard Elevation="1" Class="mb-3">
            <MudCardContent>
                <MudText Typo="Typo.subtitle1" Class="mb-2">Advanced</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="6"><MudSwitch @bind-Value="Config.PersistentBattlefield" Label="Persistent" Color="Color.Primary" /></MudItem>
                    <MudItem xs="6"><MudSwitch @bind-Value="Config.DrawingInMap" Label="Drawing in Map" Color="Color.Primary" /></MudItem>
                    <MudItem xs="6"><MudSwitch @bind-Value="Config.SkipLobby" Label="Skip Lobby" Color="Color.Primary" /></MudItem>
                    <MudItem xs="6"><MudSwitch @bind-Value="Config.EnablePlayerDiag" Label="Player Diagnostics" Color="Color.Primary" /></MudItem>
                    <MudItem xs="6"><MudSwitch @bind-Value="Config.StatisticsEnabled" Label="Statistics" Color="Color.Primary" /></MudItem>
                    <MudItem xs="6"><MudSwitch @bind-Value="Config.AllowProfileGlasses" Label="Profile Glasses" Color="Color.Primary" /></MudItem>
                    <MudItem xs="6">
                        <MudSelect Value="@Config.ForceRotorLibSimulation.ToString()"
                                   ValueChanged="@((string v) => { Config.ForceRotorLibSimulation = int.Parse(v); _ = OnConfigChanged.InvokeAsync(); })"
                                   Label="Force RotorLib" FullWidth="true">
                            <MudSelectItem Value="@("0")">Player Choice</MudSelectItem>
                            <MudSelectItem Value="@("1")">Force AFM</MudSelectItem>
                            <MudSelectItem Value="@("2")">Force SFM</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="6">
                        <MudSelect Value="@Config.ZeusCompositionScriptLevel.ToString()"
                                   ValueChanged="@((string v) => { Config.ZeusCompositionScriptLevel = int.Parse(v); _ = OnConfigChanged.InvokeAsync(); })"
                                   Label="Zeus Script Level" FullWidth="true">
                            <MudSelectItem Value="@("0")">Forbidden</MudSelectItem>
                            <MudSelectItem Value="@("1")">Attributes Only</MudSelectItem>
                            <MudSelectItem Value="@("2")">All Scripts</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="6">
                        <MudSelect Value="@Config.OverrideHazeQuality.ToString()"
                                   ValueChanged="@((string v) => { Config.OverrideHazeQuality = int.Parse(v); _ = OnConfigChanged.InvokeAsync(); })"
                                   Label="Override Haze" FullWidth="true">
                            <MudSelectItem Value="@("-1")">Do Not Force</MudSelectItem>
                            <MudSelectItem Value="@("0")">Very Low</MudSelectItem>
                            <MudSelectItem Value="@("1")">Low</MudSelectItem>
                            <MudSelectItem Value="@("2")">Standard</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="6"><MudNumericField T="int" Value="@Config.IdleFPSLimit" ValueChanged="@((int v) => { Config.IdleFPSLimit = v; _ = OnConfigChanged.InvokeAsync(); })" Label="Idle FPS Limit" Min="5" Max="60" /></MudItem>
                </MudGrid>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudTextField Value="@RawContent"
                      ValueChanged="@((string v) => OnRawContentChanged.InvokeAsync(v))"
                      Label="Raw server.cfg" FullWidth="true"
                      Lines="35" Style="font-family:monospace; font-size:12px;" />
    </MudItem>
</MudGrid>

@code {
    [Parameter, EditorRequired] public ServerConfigData Config { get; set; } = default!;
    [Parameter] public string RawContent { get; set; } = "";
    [Parameter] public EventCallback OnConfigChanged { get; set; }
    [Parameter] public EventCallback<string> OnRawContentChanged { get; set; }
}
