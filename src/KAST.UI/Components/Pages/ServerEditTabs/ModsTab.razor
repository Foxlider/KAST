@inject IModService ModService
@inject IServerInstanceService ServerService
@inject IModPresetService ModPresetService
@inject ISnackbar Snackbar

@* ── Toolbar ── *@
<div class="d-flex align-center gap-2 mt-3 mb-2 flex-wrap">
    <MudTextField @bind-Value="_modSearch"
                  Placeholder="Filter mods…"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Clearable="true" Immediate="true"
                  Margin="Margin.Dense"
                  Variant="Variant.Outlined"
                  Style="max-width:260px;" />
    <MudSpacer />
    <MudToggleGroup T="string" @bind-Value="_viewMode" Size="Size.Small" Class="mr-1">
        <MudToggleItem Value="@("table")">
            <MudTooltip Text="Table view">
                <MudIcon Icon="@Icons.Material.Filled.TableRows" />
            </MudTooltip>
        </MudToggleItem>
        <MudToggleItem Value="@("columns")">
            <MudTooltip Text="Column drag-drop view">
                <MudIcon Icon="@Icons.Material.Filled.ViewColumn" />
            </MudTooltip>
        </MudToggleItem>
    </MudToggleGroup>
    <MudButton StartIcon="@Icons.Material.Filled.RemoveCircleOutline"
               Color="Color.Default" Variant="Variant.Outlined"
               Size="Size.Small"
               Disabled="@(!Instance.Mods.Any())"
               OnClick="@(() => _showUnloadAllDialog = true)">
        Unload All
    </MudButton>
    <MudButton StartIcon="@Icons.Material.Filled.DoneAll"
               Color="Color.Info" Variant="Variant.Outlined"
               Size="Size.Small"
               Disabled="@(!UnassignedMods.Any())"
               OnClick="@(() => _showLoadAllDialog = true)">
        Load All
    </MudButton>
    <MudButton StartIcon="@Icons.Material.Filled.PlaylistAdd"
               Color="Color.Secondary" Variant="Variant.Outlined"
               Size="Size.Small"
               OnClick="@(() => _showPresetImportDialog = true)">
        Import → Clientside
    </MudButton>
    <MudButton StartIcon="@Icons.Material.Filled.Save"
               Color="Color.Primary" Variant="Variant.Outlined"
               Size="Size.Small"
               Disabled="@(!Instance.Mods.Any())"
               OnClick="@(() => _showSavePresetDialog = true)">
        Save Preset
    </MudButton>
    @if (_presets.Count > 0)
    {
        <MudBadge Content="@_presets.Count" Color="Color.Primary">
            <MudButton StartIcon="@Icons.Material.Filled.History"
                       Color="Color.Default" Variant="Variant.Outlined"
                       Size="Size.Small"
                       OnClick="@(() => _showPresetsPanel = !_showPresetsPanel)">
                Presets
            </MudButton>
        </MudBadge>
    }
</div>

@* ── Zone Filter Chips ── *@
<div class="d-flex gap-1 mb-2 flex-wrap">
    <MudChip T="string" Size="Size.Small" Variant="@(_activeZoneFilter == null ? Variant.Filled : Variant.Outlined)"
             Color="Color.Default" OnClick="@(() => _activeZoneFilter = null)">
        All (@_tableRows.Count)
    </MudChip>
    <MudChip T="string" Size="Size.Small" Variant="@(_activeZoneFilter == "available" ? Variant.Filled : Variant.Outlined)"
             Color="Color.Default" OnClick="@(() => ToggleZoneFilter("available"))">
        Available (@CountInZone("available"))
    </MudChip>
    <MudChip T="string" Size="Size.Small" Variant="@(_activeZoneFilter == "whitelisted" ? Variant.Filled : Variant.Outlined)"
             Color="Color.Warning" OnClick="@(() => ToggleZoneFilter("whitelisted"))">
        Whitelisted (@CountInZone("whitelisted"))
    </MudChip>
    <MudChip T="string" Size="Size.Small" Variant="@(_activeZoneFilter == "client" ? Variant.Filled : Variant.Outlined)"
             Color="Color.Info" OnClick="@(() => ToggleZoneFilter("client"))">
        Clientside (@CountInZone("client"))
    </MudChip>
    <MudChip T="string" Size="Size.Small" Variant="@(_activeZoneFilter == "server" ? Variant.Filled : Variant.Outlined)"
             Color="Color.Primary" OnClick="@(() => ToggleZoneFilter("server"))">
        Serverside (@CountInZone("server"))
    </MudChip>
</div>

@* ════════════ TABLE VIEW ════════════ *@
<div class="mod-assignment-summary mb-2">
    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Icon="@Icons.Material.Filled.Extension">
        @Instance.Mods.Count loaded
    </MudChip>
    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info" Icon="@Icons.Material.Filled.People">
        @ClientMods.Count clientside
    </MudChip>
    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" Icon="@Icons.Material.Filled.Storage">
        @ServerMods.Count serverside
    </MudChip>
    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning" Icon="@Icons.Material.Filled.VpnKey">
        @WhitelistedMods.Count whitelisted
    </MudChip>
    @if (AssignmentWarnings.Count > 0)
    {
        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning" Icon="@Icons.Material.Filled.Warning">
            @AssignmentWarnings.Count warning(s)
        </MudChip>
    }
</div>

@if (AssignmentWarnings.Count > 0)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
        @string.Join(" ", AssignmentWarnings.Take(2))
        @if (AssignmentWarnings.Count > 2)
        {
            <span> +@(AssignmentWarnings.Count - 2) more.</span>
        }
    </MudAlert>
}

@if (_viewMode == "table")
{
    <MudTable Items="_filteredTableRows" Hover="true" Dense="true" Elevation="1"
              MultiSelection="true" @bind-SelectedItems="_selectedRows"
              Style="max-height:55vh; overflow-y:auto;" FixedHeader="true">
        <HeaderContent>
            <MudTh Style="width:40px;"></MudTh>
            <MudTh>Mod</MudTh>
            <MudTh Style="width:100px;">Zone</MudTh>
            <MudTh Style="width:70px;">Order</MudTh>
            <MudTh Style="width:60px;"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <img src="@(context.ThumbnailUrl ?? "")" alt="" onerror="this.style.display='none'"
                     style="width:20px;height:20px;object-fit:cover;border-radius:2px;flex-shrink:0;" />
            </MudTd>
            <MudTd DataLabel="Mod">
                <MudText Typo="Typo.body2" Style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:400px;">
                    @context.Name
                </MudText>
                @if (GetAssignmentWarning(context) is { } warning)
                {
                    <MudText Typo="Typo.caption" Color="Color.Warning">@warning</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Zone">
                <MudSelect T="string" Value="@context.Zone" ValueChanged="@(async v => await MoveModToZone(context, v))"
                           AnchorOrigin="Origin.BottomCenter" Dense="true"
                           Style="min-width:110px;" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("available")">
                        <MudText Typo="Typo.caption">Available</MudText>
                    </MudSelectItem>
                    <MudSelectItem Value="@("whitelisted")">
                        <MudText Typo="Typo.caption" Color="Color.Warning">Whitelisted</MudText>
                    </MudSelectItem>
                    <MudSelectItem Value="@("client")">
                        <MudText Typo="Typo.caption" Color="Color.Info">Clientside</MudText>
                    </MudSelectItem>
                    <MudSelectItem Value="@("server")">
                        <MudText Typo="Typo.caption" Color="Color.Primary">Serverside</MudText>
                    </MudSelectItem>
                </MudSelect>
            </MudTd>
            <MudTd DataLabel="Order">
                @if (context.Zone != "available")
                {
                    <MudNumericField T="int" Value="@GetLoadOrder(context)" ValueChanged="@(async v => await SetLoadOrder(context, v))"
                                     Min="0" HideSpinButtons="true" Margin="Margin.Dense"
                                     Style="max-width:60px;" Variant="Variant.Outlined" />
                }
            </MudTd>
            <MudTd DataLabel="">
                @if (context.Zone != "available")
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => RemoveModFromZone(context))" />
                }
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="@(new[] { 25, 50, 100 })" />
        </PagerContent>
    </MudTable>

    @* Bulk actions for selected rows *@
    @if (_selectedRows.Count > 0)
    {
        <div class="d-flex align-center gap-2 mt-2 pa-2 mud-paper mud-elevation-1">
            <MudText Typo="Typo.caption">@_selectedRows.Count selected</MudText>
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Info"
                       OnClick="@(() => BulkMoveSelected("client"))">
                → Clientside
            </MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="@(() => BulkMoveSelected("server"))">
                → Serverside
            </MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning"
                       OnClick="@(() => BulkMoveSelected("whitelisted"))">
                → Whitelisted
            </MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                       OnClick="BulkRemoveSelected">
                Remove from instance
            </MudButton>
        </div>
    }
}

@* ════════════ COLUMN DRAG-DROP VIEW ════════════ *@
@if (_viewMode == "columns")
{
    <MudDropContainer T="ModDragItem"
                      Items="@_modDragItems"
                      ItemsSelector="@ModItemsSelector"
                      ItemDropped="@OnModDropped"
                      Class="d-flex flex-row gap-2 w-100">
        <ChildContent>
            <div class="mud-paper mud-elevation-1 pa-0 mod-col">
                <MudDropZone T="ModDragItem" Identifier="available" AllowReorder="false"
                             Class="pa-3 d-flex flex-column mod-dropzone flex-grow-1">
                    <div class="d-flex align-center gap-1 mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Apps" Size="Size.Small" />
                        <MudText Typo="Typo.subtitle2">Available</MudText>
                        <MudSpacer />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@_modDragItems.Count(x => x.Zone == "available")</MudText>
                    </div>
                </MudDropZone>
            </div>
            <div class="mud-paper mud-elevation-1 pa-0 mod-col">
                <MudDropZone T="ModDragItem" Identifier="whitelisted" AllowReorder="true"
                             Class="pa-3 d-flex flex-column mod-dropzone flex-grow-1">
                    <div class="d-flex align-center gap-1 mb-1">
                        <MudIcon Icon="@Icons.Material.Filled.VpnKey" Size="Size.Small" Color="Color.Warning" />
                        <MudText Typo="Typo.subtitle2">Whitelisted</MudText>
                        <MudSpacer />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@_modDragItems.Count(x => x.Zone == "whitelisted")</MudText>
                    </div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2" Style="opacity:.55; font-size:0.68rem;">Symlinked + keys only</MudText>
                </MudDropZone>
            </div>
            <div class="mud-paper mud-elevation-1 pa-0 mod-col">
                <MudDropZone T="ModDragItem" Identifier="client" AllowReorder="true"
                             Class="pa-3 d-flex flex-column mod-dropzone flex-grow-1">
                    <div class="d-flex align-center gap-1 mb-1">
                        <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Color="Color.Info" />
                        <MudText Typo="Typo.subtitle2">Clientside</MudText>
                        <MudSpacer />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@_modDragItems.Count(x => x.Zone == "client")</MudText>
                    </div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2" Style="opacity:.55; font-size:0.68rem;"><code>-mod=</code></MudText>
                </MudDropZone>
            </div>
            <div class="mud-paper mud-elevation-1 pa-0 mod-col">
                <MudDropZone T="ModDragItem" Identifier="server" AllowReorder="true"
                             Class="pa-3 d-flex flex-column mod-dropzone flex-grow-1">
                    <div class="d-flex align-center gap-1 mb-1">
                        <MudIcon Icon="@Icons.Material.Filled.Storage" Size="Size.Small" Color="Color.Primary" />
                        <MudText Typo="Typo.subtitle2">Serverside</MudText>
                        <MudSpacer />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@_modDragItems.Count(x => x.Zone == "server")</MudText>
                    </div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2" Style="opacity:.55; font-size:0.68rem;"><code>-serverMod=</code></MudText>
                </MudDropZone>
            </div>
        </ChildContent>
        <ItemRenderer>
            <div class="mod-item">
                @if (!string.IsNullOrEmpty(context.ThumbnailUrl))
                {
                    <img src="@context.ThumbnailUrl" alt=""
                         style="width:18px;height:18px;object-fit:cover;border-radius:2px;flex-shrink:0;" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Extension" Size="Size.Small"
                             Style="flex-shrink:0;opacity:.45;" />
                }
                <span class="mod-item-name">@context.Name</span>
            </div>
        </ItemRenderer>
    </MudDropContainer>
}

@* ── Saved Presets Panel ── *@
@if (_showPresetsPanel && _presets.Count > 0)
{
    <div class="mud-paper mud-elevation-1 pa-3 mt-3">
        <div class="d-flex align-center gap-2 mb-2">
            <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Saved Presets</MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                           OnClick="@(() => _showPresetsPanel = false)" />
        </div>
        <MudTable Items="_presets" Hover="true" Dense="true" Elevation="0">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Type</MudTh>
                <MudTh>Created</MudTh>
                <MudTh>Last Applied</MudTh>
                <MudTh Style="width:180px;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name">@context.Name</MudTd>
                <MudTd DataLabel="Type">
                    <MudChip T="string" Size="Size.Small"
                             Color="@(context.Type == KAST.Core.Enums.ModPresetType.Kast ? Color.Primary : Color.Secondary)"
                             Variant="Variant.Filled">
                        @context.Type
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Created">@context.CreatedAt.ToString("yyyy-MM-dd HH:mm")</MudTd>
                <MudTd DataLabel="Last Applied">
                    @(context.LastAppliedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")
                </MudTd>
                <MudTd DataLabel="Actions">
                    <MudButton StartIcon="@Icons.Material.Filled.PlayArrow"
                               Color="Color.Success" Size="Size.Small" Variant="Variant.Filled"
                               OnClick="@(() => ApplyPreset(context))"
                               Disabled="@IsApplyingPreset(context)">
                        Apply
                    </MudButton>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                   Color="Color.Error"
                                   OnClick="@(() => DeletePreset(context))" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    </div>
}

@* ════════════ Save Preset Dialog ════════════ *@
<MudDialog @bind-Visible="_showSavePresetDialog"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseButton = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">Save Current Mods as Preset</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_savePresetName" Label="Preset Name" Required="true"
                      Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            Saves the current mod layout (all 4 columns) as a KAST preset.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showSavePresetDialog = false)">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="SaveCurrentAsPreset"
                   Disabled="@(string.IsNullOrWhiteSpace(_savePresetName))">
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@* ════════════ Preset Import Dialog ════════════ *@
<MudDialog @bind-Visible="_showPresetImportDialog"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true })">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.PlaylistAdd" Color="Color.Secondary" />
            <MudText Typo="Typo.h6">Import Arma 3 Launcher Preset</MudText>
            <MudSpacer />
            <MudText Typo="Typo.caption" Color="Color.Info">→ Clientside</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudFileUpload T="IBrowserFile" FilesChanged="@OnPresetFileSelected" Accept=".html,.htm">
            <CustomContent>
                <MudButton StartIcon="@Icons.Material.Filled.FileUpload"
                           Variant="Variant.Outlined" Size="Size.Small"
                           OnClick="@context.OpenFilePickerAsync">
                    Select Preset HTML file…
                </MudButton>
            </CustomContent>
        </MudFileUpload>

        @if (_parsedPresetMods.Count > 0)
        {
            <div class="d-flex align-center gap-2 mt-3 mb-1">
                <MudIcon Icon="@Icons.Material.Filled.PlaylistPlay" Size="Size.Small" />
                <MudText Typo="Typo.subtitle2">@_parsedPresetName</MudText>
                <MudSpacer />
                <MudText Typo="Typo.caption" Color="Color.Secondary">@_presetSelectedIds.Count selected</MudText>
            </div>

            <div class="d-flex align-center mb-1"
                 style="border-bottom:1px solid var(--mud-palette-divider); padding-bottom:4px;">
                <MudCheckBox T="bool?" Value="@GetPresetSelectAllState()"
                             ValueChanged="@ToggleSelectAllPresetMods"
                             Dense="true" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">Select all preset mods</MudText>
            </div>

            <div style="max-height:260px; overflow-y:auto;">
                @foreach (var (wid, dname) in _parsedPresetMods)
                {
                    bool alreadyClient = Instance.Mods.Any(m => m.IsClientSide && m.SteamMod?.WorkshopId == wid);
                    bool alreadyIn = Instance.Mods.Any(m => m.SteamMod?.WorkshopId == wid);
                    <div class="d-flex align-center gap-1 py-1" style="@(alreadyClient ? "opacity:.75;" : "")">
                        <MudCheckBox T="bool"
                                     Value="@(_presetSelectedIds.Contains(wid))"
                                     ValueChanged="@((v) => TogglePresetMod(wid, v))"
                                     Dense="true" />
                        <MudIcon Icon="@Icons.Material.Filled.Extension" Size="Size.Small"
                                 Style="opacity:.4; flex-shrink:0;" />
                        <MudText Typo="Typo.caption"
                                 Style="flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@dname</MudText>
                        @if (alreadyIn)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info"
                                     Variant="Variant.Text">loaded</MudChip>
                        }
                    </div>
                }
            </div>

            @if (_isImportingPreset)
            {
                <div class="mt-2">
                    <MudProgressLinear Value="@(_presetImportTotal == 0 ? 0 : (double)_presetImportDone / _presetImportTotal * 100)"
                                       Indeterminate="@(_presetImportTotal == 0)"
                                       Color="Color.Primary" Class="mb-1" />
                    <MudText Typo="Typo.caption">@_presetImportDone / @_presetImportTotal adding…</MudText>
                </div>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="ClosePresetImportDialog" Disabled="@_isImportingPreset">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@(_parsedPresetMods.Count == 0 || _isImportingPreset)"
                   OnClick="ImportPresetToClient">
            Replace Clientside
        </MudButton>
    </DialogActions>
</MudDialog>

@* ════════════ Unload All / Load All Confirmation Dialogs ════════════ *@
<MudDialog @bind-Visible="_showUnloadAllDialog"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseButton = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">Unload All Mods</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>Remove all @Instance.Mods.Count mods from this server instance? The mod files themselves are not deleted, only their assignment to this server.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showUnloadAllDialog = false)">Cancel</MudButton>
        <MudButton Color="Color.Warning" Variant="Variant.Filled"
                   OnClick="ConfirmUnloadAll">
            Unload All
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_showLoadAllDialog"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseButton = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">Load All Available Mods</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>Add all @UnassignedMods.Count available mods to this server as clientside mods?</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showLoadAllDialog = false)">Cancel</MudButton>
        <MudButton Color="Color.Info" Variant="Variant.Filled"
                   OnClick="ConfirmLoadAll">
            Load All
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter, EditorRequired] public ServerInstance Instance { get; set; } = default!;
    [Parameter] public bool IsNew { get; set; }

    private List<SteamMod> _availableMods = [];
    private List<ModDragItem> _modDragItems = [];
    private List<ModDragItem> _tableRows = [];
    private HashSet<ModDragItem> _selectedRows = [];
    private string _modSearch = "";
    private string _viewMode = "table";
    private string? _activeZoneFilter;

    // Preset import
    private bool _showPresetImportDialog;
    private string _parsedPresetName = "";
    private string _parsedPresetHtml = "";
    private List<(long WorkshopId, string DisplayName)> _parsedPresetMods = [];
    private HashSet<long> _presetSelectedIds = [];
    private bool _isImportingPreset;
    private int _presetImportDone;
    private int _presetImportTotal;

    // Saved presets
    private List<ModPreset> _presets = [];
    private bool _showPresetsPanel;
    private bool _showSavePresetDialog;
    private string _savePresetName = "";
    private int? _applyingPresetId;

    // Confirmation dialogs
    private bool _showUnloadAllDialog;
    private bool _showLoadAllDialog;

    private List<SteamMod> UnassignedMods => _availableMods
        .Where(m => !Instance.Mods.Any(im => im.SteamModId == m.Id)).ToList();
    private List<ServerInstanceMod> WhitelistedMods => Instance.Mods
        .Where(m => !m.IsClientSide && !m.IsServerSide).OrderBy(m => m.LoadOrder).ToList();
    private List<ServerInstanceMod> ClientMods => Instance.Mods
        .Where(m => m.IsClientSide).OrderBy(m => m.LoadOrder).ToList();
    private List<ServerInstanceMod> ServerMods => Instance.Mods
        .Where(m => m.IsServerSide).OrderBy(m => m.LoadOrder).ToList();

    private IEnumerable<ModDragItem> _filteredTableRows =>
        string.IsNullOrWhiteSpace(_modSearch)
            ? _tableRows.Where(r => _activeZoneFilter == null || r.Zone == _activeZoneFilter)
            : _tableRows.Where(r => (_activeZoneFilter == null || r.Zone == _activeZoneFilter) &&
                                     r.Name.Contains(_modSearch, StringComparison.OrdinalIgnoreCase));

    private int CountInZone(string zone) => _tableRows.Count(r => r.Zone == zone);

    private IReadOnlyList<string> AssignmentWarnings => Instance.Mods
        .Select(GetAssignmentWarning)
        .Where(w => w is not null)
        .Select(w => w!)
        .Distinct()
        .ToList();

    private SteamMod? GetModForRow(ModDragItem row)
    {
        return _availableMods.FirstOrDefault(m => m.Id == row.ModId) ??
               Instance.Mods.FirstOrDefault(m => m.SteamModId == row.ModId)?.SteamMod;
    }

    private string? GetAssignmentWarning(ModDragItem row)
    {
        if (row.Zone == "available")
            return null;

        var mod = GetModForRow(row);
        return mod is null ? "Mod data missing" : GetAssignmentWarning(mod);
    }

    private static string? GetAssignmentWarning(ServerInstanceMod instanceMod)
    {
        var mod = instanceMod.SteamMod;
        return mod is null ? "Mod data missing" : GetAssignmentWarning(mod);
    }

    private static string? GetAssignmentWarning(SteamMod mod)
    {
        return mod.Status switch
        {
            ModStatus.NotInstalled => $"{mod.Name} is assigned but not installed.",
            ModStatus.Downloading or ModStatus.Updating => $"{mod.Name} is still downloading.",
            ModStatus.Error => $"{mod.Name} needs attention before launch.",
            _ when string.IsNullOrWhiteSpace(mod.LocalPath) && mod.Source == ModSource.SteamWorkshop =>
                $"{mod.Name} has no local path.",
            _ => null
        };
    }

    private int GetLoadOrder(ModDragItem row)
    {
        var im = Instance.Mods.FirstOrDefault(m => m.SteamModId == row.ModId);
        return im?.LoadOrder ?? 0;
    }

    // ── Lifecycle ────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        _availableMods = (await ModService.GetAllModsAsync()).ToList();
        BuildAllItems();
        await LoadPresets();
    }

    private void BuildAllItems()
    {
        _modDragItems = BuildDragItemsForZone(null).ToList();
        _tableRows = _modDragItems.ToList();
    }

    private IEnumerable<ModDragItem> BuildDragItemsForZone(string? zone)
    {
        var items = UnassignedMods
            .Select(m => new ModDragItem { ModId = m.Id, Name = m.Name ?? "", ThumbnailUrl = m.ThumbnailUrl, Zone = "available" })
            .Concat(WhitelistedMods
                .Select(im => new ModDragItem { ModId = im.SteamModId, Name = im.SteamMod?.Name ?? im.SteamModId.ToString(), ThumbnailUrl = im.SteamMod?.ThumbnailUrl, Zone = "whitelisted" }))
            .Concat(ClientMods
                .Select(im => new ModDragItem { ModId = im.SteamModId, Name = im.SteamMod?.Name ?? im.SteamModId.ToString(), ThumbnailUrl = im.SteamMod?.ThumbnailUrl, Zone = "client" }))
            .Concat(ServerMods
                .Select(im => new ModDragItem { ModId = im.SteamModId, Name = im.SteamMod?.Name ?? im.SteamModId.ToString(), ThumbnailUrl = im.SteamMod?.ThumbnailUrl, Zone = "server" }));
        return items;
    }

    private bool ModItemsSelector(ModDragItem item, string zone)
    {
        if (item.Zone != zone) return false;
        if (zone == "available" && !string.IsNullOrWhiteSpace(_modSearch))
            return item.Name.Contains(_modSearch, StringComparison.OrdinalIgnoreCase);
        return true;
    }

    // ── Zone filtering ───────────────────────────────────────────────────────

    private void ToggleZoneFilter(string zone)
    {
        _activeZoneFilter = _activeZoneFilter == zone ? null : zone;
    }

    // ── Table view: move mod between zones ────────────────────────────────────

    private async Task MoveModToZone(ModDragItem row, string newZone)
    {
        if (row.Zone == newZone) return;

        await ApplyZoneChange(row.ModId, newZone);
        RefreshAllItems();
    }

    private async Task RemoveModFromZone(ModDragItem row)
    {
        await RemoveMod(row.ModId);
        RefreshAllItems();
    }

    private async Task SetLoadOrder(ModDragItem row, int newOrder)
    {
        var im = Instance.Mods.FirstOrDefault(m => m.SteamModId == row.ModId);
        if (im == null || im.LoadOrder == newOrder) return;
        im.LoadOrder = newOrder;
        if (!IsNew)
            await ServerService.UpdateModLoadOrderAsync(Instance.Id, row.ModId, newOrder);
        ReindexMods();
        RefreshAllItems();
    }

    private async Task ApplyZoneChange(int modId, string newZone)
    {
        if (newZone == "available")
        {
            await RemoveMod(modId);
        }
        else
        {
            var im = Instance.Mods.FirstOrDefault(m => m.SteamModId == modId);
            if (im != null)
            {
                im.IsClientSide = newZone == "client";
                im.IsServerSide = newZone == "server";
                if (!IsNew)
                    await ServerService.UpdateModFlagsAsync(Instance.Id, modId, im.IsClientSide, im.IsServerSide);
            }
            else
            {
                await AddMod(modId, newZone);
            }
        }
        ReindexMods();
    }

    private void RefreshAllItems()
    {
        _modDragItems = BuildDragItemsForZone(null).ToList();
        _tableRows = _modDragItems.ToList();
        _selectedRows.Clear();
        StateHasChanged();
    }

    // ── Bulk operations ──────────────────────────────────────────────────────

    private async Task BulkMoveSelected(string zone)
    {
        foreach (var row in _selectedRows.ToList())
        {
            await ApplyZoneChange(row.ModId, zone);
        }
        RefreshAllItems();
    }

    private async Task BulkRemoveSelected()
    {
        foreach (var row in _selectedRows.ToList())
        {
            await RemoveMod(row.ModId);
        }
        RefreshAllItems();
    }

    // ── Core mod operations ──────────────────────────────────────────────────

    private async Task AddMod(int modId, string zone)
    {
        if (!IsNew)
            await ServerService.AddModToInstanceAsync(Instance.Id, modId,
                isClientSide: zone == "client",
                isServerSide: zone == "server");

        var steamMod = _availableMods.FirstOrDefault(m => m.Id == modId);
        if (steamMod != null)
            Instance.Mods.Add(new ServerInstanceMod
            {
                SteamModId = modId,
                SteamMod = steamMod,
                IsClientSide = zone == "client",
                IsServerSide = zone == "server",
                LoadOrder = Instance.Mods.Count
            });

        ReindexMods();
    }

    private async Task RemoveMod(int modId)
    {
        if (!IsNew)
            await ServerService.RemoveModFromInstanceAsync(Instance.Id, modId);

        var toRemove = Instance.Mods.FirstOrDefault(m => m.SteamModId == modId);
        if (toRemove != null) Instance.Mods.Remove(toRemove);

        ReindexMods();
    }

    private void ReindexMods()
    {
        int wi = 0; foreach (var m in Instance.Mods.Where(m => !m.IsClientSide && !m.IsServerSide).OrderBy(m => m.LoadOrder)) m.LoadOrder = wi++;
        int ci = 0; foreach (var m in Instance.Mods.Where(m => m.IsClientSide).OrderBy(m => m.LoadOrder)) m.LoadOrder = ci++;
        int si = 0; foreach (var m in Instance.Mods.Where(m => m.IsServerSide).OrderBy(m => m.LoadOrder)) m.LoadOrder = si++;
    }

    // ── Drag-drop view operations ────────────────────────────────────────────

    private async Task OnModDropped(MudItemDropInfo<ModDragItem> info)
    {
        if (info.Item is not { } item) return;
        var oldZone = item.Zone;
        var newZone = info.DropzoneIdentifier;
        var newIndex = info.IndexInZone;

        item.Zone = newZone;

        if (oldZone == newZone)
        {
            if (newZone is "whitelisted" or "client" or "server")
            {
                bool isClient = newZone == "client";
                bool isServer = newZone == "server";
                var zoneMods = Instance.Mods
                    .Where(m => m.IsClientSide == isClient && m.IsServerSide == isServer)
                    .OrderBy(m => m.LoadOrder)
                    .ToList();
                var mod = zoneMods.FirstOrDefault(m => m.SteamModId == item.ModId);
                if (mod != null)
                {
                    zoneMods.Remove(mod);
                    zoneMods.Insert(Math.Clamp(newIndex, 0, zoneMods.Count), mod);
                    int idx = 0;
                    foreach (var m in zoneMods) m.LoadOrder = idx++;
                }
            }
        }
        else if (newZone == "available")
        {
            await RemoveMod(item.ModId);
        }
        else if (oldZone == "available")
        {
            await AddMod(item.ModId, newZone);
        }
        else
        {
            var im = Instance.Mods.FirstOrDefault(m => m.SteamModId == item.ModId);
            if (im is not null)
            {
                im.IsClientSide = newZone == "client";
                im.IsServerSide = newZone == "server";
                if (!IsNew)
                    await ServerService.UpdateModFlagsAsync(Instance.Id, item.ModId, im.IsClientSide, im.IsServerSide);
            }
        }

        RefreshAllItems();
    }

    private async Task ConfirmUnloadAll()
    {
        _showUnloadAllDialog = false;
        foreach (var modId in Instance.Mods.Select(m => m.SteamModId).ToList())
            await RemoveMod(modId);
        RefreshAllItems();
