    // ── Preset Import ────────────────────────────────────────────────────────

    private void ClosePresetImportDialog()
    {
        _showPresetImportDialog = false;
        _parsedPresetMods = [];
        _parsedPresetName = "";
        _parsedPresetHtml = "";
        _presetSelectedIds = [];
        _isImportingPreset = false;
        _presetImportDone = 0;
        _presetImportTotal = 0;
    }

    private async Task OnPresetFileSelected(IBrowserFile file)
    {
        if (file is null) return;
        using var stream = file.OpenReadStream(maxAllowedSize: 4 * 1024 * 1024);
        using var reader = new StreamReader(stream);
        var html = await reader.ReadToEndAsync();
        _parsedPresetHtml = html;

        var nameMatch = Regex.Match(html,
            @"<meta\s+name=""arma:PresetName""\s+content=""([^""]+)""",
            RegexOptions.IgnoreCase);
        _parsedPresetName = nameMatch.Success
            ? nameMatch.Groups[1].Value
            : file.Name.Replace(".html", "", StringComparison.OrdinalIgnoreCase);

        var rows = Regex.Matches(html,
            @"<tr\s+data-type=""ModContainer"">(.*?)</tr>",
            RegexOptions.Singleline | RegexOptions.IgnoreCase);

        _parsedPresetMods = [];
        foreach (Match row in rows)
        {
            var nameM = Regex.Match(row.Groups[1].Value,
                @"<td\s+data-type=""DisplayName"">\s*(.*?)\s*</td>",
                RegexOptions.IgnoreCase | RegexOptions.Singleline);
            var idM = Regex.Match(row.Groups[1].Value,
                @"[?&]id=(\d+)",
                RegexOptions.IgnoreCase);
            if (!idM.Success || !long.TryParse(idM.Groups[1].Value, out var wid)) continue;
            var displayName = nameM.Success ? nameM.Groups[1].Value.Trim() : wid.ToString();
            _parsedPresetMods.Add((wid, displayName));
        }

        _presetSelectedIds = [.. _parsedPresetMods.Select(p => p.WorkshopId)];

        StateHasChanged();
    }

    private void TogglePresetMod(long workshopId, bool selected)
    {
        if (selected) _presetSelectedIds.Add(workshopId);
        else _presetSelectedIds.Remove(workshopId);
    }

    private bool? GetPresetSelectAllState()
    {
        var presetIds = _parsedPresetMods.Select(p => p.WorkshopId).ToList();
        if (presetIds.Count == 0) return false;
        int selected = presetIds.Count(id => _presetSelectedIds.Contains(id));
        if (selected == 0) return false;
        return selected == presetIds.Count ? true : null;
    }

    private void ToggleSelectAllPresetMods(bool? value)
    {
        var presetIds = _parsedPresetMods.Select(p => p.WorkshopId);
        if (value == true)
            foreach (var id in presetIds) _presetSelectedIds.Add(id);
        else
            foreach (var id in presetIds) _presetSelectedIds.Remove(id);
    }

    private async Task ImportPresetToClient()
    {
        _isImportingPreset = true;
        var selectedPresetMods = _parsedPresetMods
            .Where(p => _presetSelectedIds.Contains(p.WorkshopId))
            .GroupBy(p => p.WorkshopId)
            .Select(g => g.First())
            .ToList();
        var selectedWorkshopIds = selectedPresetMods
            .Select(p => p.WorkshopId)
            .ToHashSet();
        var clientsToUnload = Instance.Mods
            .Where(m => m.IsClientSide && (m.SteamMod == null || !selectedWorkshopIds.Contains(m.SteamMod.WorkshopId)))
            .ToList();

        _presetImportTotal = selectedPresetMods.Count + clientsToUnload.Count;
        _presetImportDone = 0;
        StateHasChanged();

        var desiredClientMods = new List<SteamMod>();

        foreach (var (workshopId, _) in selectedPresetMods)
        {
            try
            {
                var existingMod = Instance.Mods
                    .FirstOrDefault(m => m.SteamMod?.WorkshopId == workshopId)
                    ?.SteamMod;
                var mod = existingMod ?? await ModService.AddWorkshopModAsync(workshopId);

                if (!_availableMods.Any(m => m.Id == mod.Id))
                    _availableMods.Add(mod);

                desiredClientMods.Add(mod);
            }
            catch { }

            _presetImportDone++;
            StateHasChanged();
        }

        foreach (var clientMod in clientsToUnload)
        {
            if (clientMod.IsServerSide)
            {
                clientMod.IsClientSide = false;
                if (!IsNew)
                    await ServerService.UpdateModFlagsAsync(Instance.Id, clientMod.SteamModId,
                        isClientSide: false, isServerSide: true);
            }
            else
            {
                await RemoveMod(clientMod.SteamModId);
            }

            _presetImportDone++;
            StateHasChanged();
        }

        for (var index = 0; index < desiredClientMods.Count; index++)
        {
            var mod = desiredClientMods[index];
            var existingLink = Instance.Mods.FirstOrDefault(m => m.SteamModId == mod.Id);
            if (existingLink == null)
            {
                if (!IsNew)
                    await ServerService.AddModToInstanceAsync(Instance.Id, mod.Id, index,
                        isClientSide: true, isServerSide: false);

                Instance.Mods.Add(new ServerInstanceMod
                {
                    SteamModId = mod.Id, SteamMod = mod,
                    IsClientSide = true, IsServerSide = false, LoadOrder = index
                });
            }
            else
            {
                existingLink.IsClientSide = true;
                existingLink.IsServerSide = false;
                existingLink.LoadOrder = index;
                if (!IsNew)
                {
                    await ServerService.UpdateModFlagsAsync(Instance.Id, mod.Id,
                        isClientSide: true, isServerSide: false);
                    await ServerService.UpdateModLoadOrderAsync(Instance.Id, mod.Id, index);
                }
            }
        }

        try
        {
            var presetName = string.IsNullOrWhiteSpace(_parsedPresetName)
                ? $"Import {DateTime.UtcNow:yyyy-MM-dd HH:mm}"
                : _parsedPresetName;
            await ModPresetService.ImportFromArmaHtmlAsync(Instance.Id, presetName, _parsedPresetHtml);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Preset saved but failed to persist: {ex.Message}", Severity.Warning);
        }

        ReindexMods();
        RefreshAllItems();
        ClosePresetImportDialog();
        await LoadPresets();
    }

    // ── Preset Management ────────────────────────────────────────────────────

    private bool IsApplyingPreset(ModPreset preset) => _applyingPresetId == preset.Id;

    private async Task LoadPresets()
    {
        if (IsNew) return;
        try
        {
            _presets = (await ModPresetService.GetPresetsForInstanceAsync(Instance.Id)).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load presets: {ex.Message}", Severity.Error);
        }
    }

    private async Task SaveCurrentAsPreset()
    {
        if (string.IsNullOrWhiteSpace(_savePresetName)) return;
        try
        {
            var preset = await ModPresetService.SaveInstanceAsKastPresetAsync(Instance.Id, _savePresetName.Trim());
            Snackbar.Add($"Preset '{preset.Name}' saved", Severity.Success);
            _showSavePresetDialog = false;
            _savePresetName = "";
            _showPresetsPanel = true;
            await LoadPresets();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to save preset: {ex.Message}", Severity.Error);
        }
    }

    private async Task ApplyPreset(ModPreset preset)
    {
        _applyingPresetId = preset.Id;
        StateHasChanged();
        try
        {
            await ModPresetService.ApplyPresetAsync(preset.Id, Instance.Id);
            Snackbar.Add($"Applied preset '{preset.Name}'", Severity.Success);

            _availableMods = (await ModService.GetAllModsAsync()).ToList();
            var fresh = await ServerService.GetInstanceByIdAsync(Instance.Id);
            if (fresh != null)
            {
                Instance.Mods.Clear();
                foreach (var m in fresh.Mods) Instance.Mods.Add(m);
            }
            RefreshAllItems();
            await LoadPresets();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to apply preset: {ex.Message}", Severity.Error);
        }
        finally
        {
            _applyingPresetId = null;
            StateHasChanged();
        }
    }

    private async Task DeletePreset(ModPreset preset)
    {
        try
        {
            await ModPresetService.DeletePresetAsync(preset.Id);
            Snackbar.Add($"Deleted preset '{preset.Name}'", Severity.Success);
            await LoadPresets();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to delete preset: {ex.Message}", Severity.Error);
        }
    }

    private sealed class ModDragItem
    {
        public int ModId { get; set; }
        public string Name { get; set; } = "";
        public string? ThumbnailUrl { get; set; }
        public string Zone { get; set; } = "available";
    }
