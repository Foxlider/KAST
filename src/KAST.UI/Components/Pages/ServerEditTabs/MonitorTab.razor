@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject KAST.UI.Services.ServerConsoleStore ConsoleStore
@inject KAST.UI.Services.ServerRuntimeEventStore RuntimeEventStore
@inject KastInternalUrlProvider InternalUrls
@inject InternalHubTokenService InternalHubToken
@inject ILogger<MonitorTab> Logger
@inject ISnackbar Snackbar

@if (!_monitoringConnected && _monitoringError is not null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-3">
        Monitoring unavailable. Console and metrics updates are disconnected.
    </MudAlert>
}

<MudGrid Class="mt-3" Spacing="3">
    <MudItem xs="12" sm="4">
        <MudCard Elevation="2">
            <MudCardContent>
                <MudText Typo="Typo.overline" Color="Color.Secondary">CPU</MudText>
                <MudText Typo="Typo.h5">@_monitorCpu.ToString("F1")%</MudText>
                <MudProgressLinear Value="@_monitorCpu" Color="Color.Info" />
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudCard Elevation="2">
            <MudCardContent>
                <MudText Typo="Typo.overline" Color="Color.Secondary">Memory</MudText>
                <MudText Typo="Typo.h5">@UiHelpers.FormatBytes(_monitorMemory)</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudCard Elevation="2">
            <MudCardContent>
                <MudText Typo="Typo.overline" Color="Color.Secondary">Players</MudText>
                <MudText Typo="Typo.h5">@_monitorPlayerCount</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Uptime @GetUptime()</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

<MudGrid Class="mt-4" Spacing="3">
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-3 h-100" Elevation="1">
            <MudText Typo="Typo.overline" Color="Color.Secondary">Mission</MudText>
            @if (_latestMission is null)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No mission detected yet.</MudText>
            }
            else
            {
                <MudText Typo="Typo.subtitle2">@(_latestMission.MissionFile ?? "Mission running")</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @FirstNonBlank(_latestMission.MissionWorld, _latestMission.MissionDirectory, "Unknown world")
                </MudText>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-3 h-100" Elevation="1">
            <MudText Typo="Typo.overline" Color="Color.Secondary">Steam</MudText>
            @if (_latestSteamEvent is null)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No Steam status detected yet.</MudText>
            }
            else
            {
                <MudText Typo="Typo.subtitle2">@_latestSteamEvent.Title</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@_latestSteamEvent.Message</MudText>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-3 h-100" Elevation="1">
            <MudText Typo="Typo.overline" Color="Color.Secondary">Admin Activity</MudText>
            @if (_latestAdminEvent is null)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No admin activity detected yet.</MudText>
            }
            else
            {
                <MudText Typo="Typo.subtitle2">@_latestAdminEvent.Title</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@_latestAdminEvent.Message</MudText>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@if (AlertEvents.Count > 0)
{
    <MudPaper Class="pa-3 mt-3" Elevation="1">
        <div class="d-flex align-center justify-space-between mb-2">
            <MudText Typo="Typo.subtitle2">Server Events</MudText>
            <MudTooltip Text="Clear detected server events">
                <MudIconButton Icon="@Icons.Material.Outlined.DeleteSweep"
                               Size="Size.Small"
                               OnClick="ClearRuntimeEvents" />
            </MudTooltip>
        </div>
        <div class="kast-runtime-events">
            @foreach (var runtimeEvent in AlertEvents.TakeLast(8).Reverse())
            {
                <MudAlert Severity="@ToMudSeverity(runtimeEvent.Severity)"
                          Variant="Variant.Outlined"
                          Dense="true"
                          Class="mb-1">
                    <div class="d-flex flex-column">
                        <span>@runtimeEvent.Title</span>
                        <span class="mud-typography-caption">@runtimeEvent.Message</span>
                    </div>
                </MudAlert>
            }
        </div>
    </MudPaper>
}

<div class="d-flex align-center justify-space-between mt-4 mb-1">
    <MudText Typo="Typo.subtitle2">Server Console</MudText>
    <div class="d-flex align-center gap-1">
        <MudButtonGroup Variant="Variant.Text" Size="Size.Small" OverrideStyles="false">
            <MudButton Color="@(_consoleFilter == ConsoleFilter.All     ? Color.Primary : Color.Default)" OnClick="@(() => _consoleFilter = ConsoleFilter.All)">All</MudButton>
            <MudButton Color="@(_consoleFilter == ConsoleFilter.Info    ? Color.Info    : Color.Default)" OnClick="@(() => _consoleFilter = ConsoleFilter.Info)">Info</MudButton>
            <MudButton Color="@(_consoleFilter == ConsoleFilter.Warning ? Color.Warning : Color.Default)" OnClick="@(() => _consoleFilter = ConsoleFilter.Warning)">Warn</MudButton>
            <MudButton Color="@(_consoleFilter == ConsoleFilter.Error   ? Color.Error   : Color.Default)" OnClick="@(() => _consoleFilter = ConsoleFilter.Error)">Error</MudButton>
        </MudButtonGroup>
        <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />
        <MudTooltip Text='@(_followConsole ? "Auto-scroll on \u2014 click to disable" : "Auto-scroll off \u2014 click to enable")'>
            <MudIconButton Icon="@(_followConsole ? Icons.Material.Filled.LockOpen : Icons.Material.Outlined.VerticalAlignBottom)"
                           Color="@(_followConsole ? Color.Primary : Color.Default)"
                           Size="Size.Small"
                           OnClick="@(() => { _followConsole = !_followConsole; if (_followConsole) _scrollConsole = true; })" />
        </MudTooltip>
        <MudTooltip Text='@($"Clear {(_consoleFilter == ConsoleFilter.All ? "all" : _consoleFilter.ToString().ToLower())} entries")'>
            <MudIconButton Icon="@Icons.Material.Outlined.DeleteSweep"
                           Size="Size.Small"
                           OnClick="ClearConsole" />
        </MudTooltip>
    </div>
</div>
<div @ref="_consoleRef" class="kast-console"
     style="background:var(--mud-palette-background-grey); padding:8px; font-family:monospace; font-size:12px; border-radius:4px;">
    @foreach (var entry in FilteredConsoleLines)
    {
        <div style="@(entry.Type == ConsoleFilter.Error ? "color:var(--mud-palette-error-text);" : entry.Type == ConsoleFilter.Warning ? "color:var(--mud-palette-warning-text);" : "")">
            <span style="color:var(--mud-palette-text-secondary);">@entry.Timestamp.ToString("HH:mm:ss")</span>
            <span> @entry.Line</span>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public ServerInstance Instance { get; set; } = default!;
    [Parameter] public EventCallback OnStatusChanged { get; set; }

    private enum ConsoleFilter { All, Info, Warning, Error }
    private record ConsoleEntry(DateTime Timestamp, string Line, ConsoleFilter Type);

    private HubConnection? _hubConnection;
    private readonly List<ConsoleEntry> _consoleLines = new();
    private readonly List<ServerRuntimeEvent> _runtimeEvents = new();
    private ElementReference _consoleRef;
    private bool _followConsole = true;
    private bool _scrollConsole;
    private ConsoleFilter _consoleFilter = ConsoleFilter.All;
    private DateTime _lastConsoleRender = DateTime.MinValue;
    private const int ConsoleRenderThrottleMs = 100;
    private double _monitorCpu;
    private long _monitorMemory;
    private int _monitorPlayerCount;
    private bool _initialized;
    private bool _monitoringConnected;
    private string? _monitoringError;

    private IReadOnlyList<ConsoleEntry> FilteredConsoleLines =>
        _consoleFilter == ConsoleFilter.All
            ? _consoleLines.ToList()
            : _consoleLines.Where(e => e.Type == _consoleFilter).ToList();

    private IReadOnlyList<ServerRuntimeEvent> AlertEvents =>
        _runtimeEvents
            .Where(e => e.Severity is ServerRuntimeEventSeverity.Warning or ServerRuntimeEventSeverity.Error or ServerRuntimeEventSeverity.Critical)
            .ToList();

    private ServerRuntimeEvent? _latestMission;
    private ServerRuntimeEvent? _latestSteamEvent;
    private ServerRuntimeEvent? _latestAdminEvent;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized && Instance.Id > 0)
        {
            _initialized = true;
            foreach (var entry in ConsoleStore.GetHistory(Instance.Id))
                _consoleLines.Add(new ConsoleEntry(entry.Timestamp, entry.Line, ClassifyLine(entry.Line)));
            foreach (var runtimeEvent in RuntimeEventStore.GetHistory(Instance.Id))
                AddRuntimeEvent(runtimeEvent, showSnackbar: false);
            await InitializeSignalR();
        }

        if (_scrollConsole)
        {
            _scrollConsole = false;
            try { await JS.InvokeVoidAsync("KAST.scrollToBottom", _consoleRef); }
            catch (Microsoft.JSInterop.JSException) { _scrollConsole = false; }
            catch (InvalidOperationException) { _scrollConsole = false; }
        }
    }

    private async Task InitializeSignalR()
    {
        try
        {
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(InternalUrls.GetMonitoringHubUri(), options =>
                    options.Headers.Add(InternalHubAuthenticationDefaults.HeaderName, InternalHubToken.Token))
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.Reconnecting += _ =>
            {
                _monitoringConnected = false;
                _monitoringError = "Monitoring connection interrupted.";
                return InvokeAsync(StateHasChanged);
            };

            _hubConnection.Reconnected += _ =>
            {
                _monitoringConnected = true;
                _monitoringError = null;
                return InvokeAsync(StateHasChanged);
            };

            _hubConnection.Closed += error =>
            {
                _monitoringConnected = false;
                _monitoringError = "Monitoring connection closed.";
                if (error is not null)
                    Logger.LogWarning(error, "Monitoring SignalR hub connection closed.");
                return InvokeAsync(StateHasChanged);
            };

            _hubConnection.On<LogEntryEvent>("LogEntry", entry =>
            {
                if (entry.ServerInstanceId != Instance.Id) return;
                _consoleLines.Add(new ConsoleEntry(entry.Timestamp, entry.Line, ClassifyLine(entry.Line)));
                while (_consoleLines.Count > 1000) _consoleLines.RemoveAt(0);
                if (_followConsole) _scrollConsole = true;

                var now = DateTime.UtcNow;
                if ((now - _lastConsoleRender).TotalMilliseconds >= ConsoleRenderThrottleMs)
                {
                    _lastConsoleRender = now;
                    InvokeAsync(StateHasChanged);
                }
            });

            _hubConnection.On<ServerRuntimeEvent>("ServerRuntimeEvent", runtimeEvent =>
            {
                if (runtimeEvent.ServerInstanceId != Instance.Id) return;
                InvokeAsync(() =>
                {
                    AddRuntimeEvent(runtimeEvent, showSnackbar: true);
                    StateHasChanged();
                });
            });

            _hubConnection.On<ServerStatusChangedEvent>("ServerStatusChanged", async evt =>
            {
                if (evt.ServerInstanceId != Instance.Id) return;
                if (Enum.TryParse<ServerInstanceStatus>(evt.NewStatus, out var status))
                {
                    Instance.Status = status;
                    if (status is ServerInstanceStatus.Stopped or ServerInstanceStatus.Crashed)
                    {
                        Instance.ProcessId = null;
                        Instance.StartedAt = null;
                        _monitorCpu = 0;
                        _monitorMemory = 0;
                        _monitorPlayerCount = 0;
                    }
                    await OnStatusChanged.InvokeAsync();
                    await InvokeAsync(StateHasChanged);
                }
            });

            _hubConnection.On<InstanceMetricsUpdatedEvent>("InstanceMetricsUpdated", async evt =>
            {
                if (evt.ServerInstanceId != Instance.Id) return;
                _monitorCpu = evt.CpuPercent;
                _monitorMemory = evt.MemoryBytes;
                _monitorPlayerCount = evt.PlayerCount;
                await InvokeAsync(StateHasChanged);
            });

            await _hubConnection.StartAsync();
            _monitoringConnected = true;
            _monitoringError = null;
            await _hubConnection.InvokeAsync("SubscribeToInstance", Instance.Id);
        }
        catch (InvalidOperationException ex)
        {
            _monitoringConnected = false;
            _monitoringError = ex.Message;
            Logger.LogWarning(ex, "Failed to connect to monitoring SignalR hub.");
            if (_hubConnection is not null)
            {
                await _hubConnection.DisposeAsync();
                _hubConnection = null;
            }
        }
        catch (HttpRequestException ex)
        {
            _monitoringConnected = false;
            _monitoringError = ex.Message;
            Logger.LogWarning(ex, "Failed to connect to monitoring SignalR hub.");
            if (_hubConnection is not null)
            {
                await _hubConnection.DisposeAsync();
                _hubConnection = null;
            }
        }
    }

    private void ClearConsole()
    {
        if (_consoleFilter == ConsoleFilter.All)
        {
            _consoleLines.Clear();
            ConsoleStore.Clear(Instance.Id);
        }
        else
        {
            _consoleLines.RemoveAll(e => e.Type == _consoleFilter);
        }
        StateHasChanged();
    }

    private void ClearRuntimeEvents()
    {
        _runtimeEvents.Clear();
        _latestMission = null;
        _latestSteamEvent = null;
        _latestAdminEvent = null;
        RuntimeEventStore.Clear(Instance.Id);
        StateHasChanged();
    }

    private void AddRuntimeEvent(ServerRuntimeEvent runtimeEvent, bool showSnackbar)
    {
        _runtimeEvents.Add(runtimeEvent);
        while (_runtimeEvents.Count > 200) _runtimeEvents.RemoveAt(0);

        if (runtimeEvent.Kind == ServerRuntimeEventKind.MissionStarted)
            _latestMission = runtimeEvent;
        if (runtimeEvent.Kind is ServerRuntimeEventKind.SteamInitialized or ServerRuntimeEventKind.SteamConnected or ServerRuntimeEventKind.SteamQueryOverflow)
            _latestSteamEvent = runtimeEvent;
        if (runtimeEvent.Kind is ServerRuntimeEventKind.AdminLogin or ServerRuntimeEventKind.AdminLogout)
            _latestAdminEvent = runtimeEvent;

        if (!showSnackbar || runtimeEvent.Severity is not (ServerRuntimeEventSeverity.Warning or ServerRuntimeEventSeverity.Critical))
            return;

        Snackbar.Add($"{runtimeEvent.Title}: {runtimeEvent.Message}", ToMudSeverity(runtimeEvent.Severity));
    }

    private static Severity ToMudSeverity(ServerRuntimeEventSeverity severity)
        => severity switch
        {
            ServerRuntimeEventSeverity.Critical => Severity.Error,
            ServerRuntimeEventSeverity.Error => Severity.Error,
            ServerRuntimeEventSeverity.Warning => Severity.Warning,
            _ => Severity.Info
        };

    private static string FirstNonBlank(params string?[] values)
        => values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? "";

    private string GetUptime()
    {
        if (Instance.StartedAt is null) return "--";
        var e = DateTime.UtcNow - Instance.StartedAt.Value;
        if (e.TotalDays >= 1) return $"{e.Days}d {e.Hours}h";
        if (e.TotalHours >= 1) return $"{e.Hours}h {e.Minutes}m";
        return $"{e.Minutes}m {e.Seconds}s";
    }

    private static ConsoleFilter ClassifyLine(string line)
    {
        if (line.Contains("error",     StringComparison.OrdinalIgnoreCase) ||
            line.Contains("exception", StringComparison.OrdinalIgnoreCase) ||
            line.Contains("fatal",     StringComparison.OrdinalIgnoreCase) ||
            line.Contains("critical",  StringComparison.OrdinalIgnoreCase))
            return ConsoleFilter.Error;
        if (line.Contains("warning", StringComparison.OrdinalIgnoreCase) ||
            line.Contains("warn",    StringComparison.OrdinalIgnoreCase))
            return ConsoleFilter.Warning;
        return ConsoleFilter.Info;
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
            await _hubConnection.DisposeAsync();
    }
}
