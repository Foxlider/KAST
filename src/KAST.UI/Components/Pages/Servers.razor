@page "/servers"
@attribute [Authorize]
@using KAST.Infrastructure.Services.Content
@inject IServerInstanceService ServerService
@inject IOutputSanitizer OutputSanitizer
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject ContentProgressTracker ContentProgress
@inject IJSRuntime JS

<PageTitle>KAST — Servers</PageTitle>

<div class="d-flex align-center justify-space-between mb-4">
    <MudText Typo="Typo.h5">Server Instances</MudText>
    <div class="d-flex align-center" style="gap: 8px;">
        <MudFileUpload T="IBrowserFile" Accept=".json" FilesChanged="OnImportFileSelected">
            <CustomContent>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.FileUpload">
                    Import
                </MudButton>
            </CustomContent>
        </MudFileUpload>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@(() => Nav.NavigateTo("/servers/new"))">
            New Instance
        </MudButton>
    </div>
</div>

@if (_instances.Count == 0)
{
    <MudPaper Class="pa-8 d-flex flex-column align-center" Elevation="1">
        <MudIcon Icon="@Icons.Material.Filled.Storage" Size="Size.Large" Color="Color.Secondary" Class="mb-3" />
        <MudText Typo="Typo.h6" Color="Color.Secondary">No server instances</MudText>
        <MudText Color="Color.Secondary" Class="mb-3">Create your first Arma 3 server instance to get started.</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Nav.NavigateTo("/servers/new"))">
            Create Instance
        </MudButton>
    </MudPaper>
}
else
{
    <MudGrid Spacing="3">
        @foreach (var instance in _instances)
        {
            <MudItem xs="12" sm="6" lg="4">
                <MudCard Elevation="2" Style="cursor:pointer;" @onclick="@(() => Nav.NavigateTo($"/servers/{instance.Id}"))">
                    <MudCardContent>
                        <div class="d-flex align-center gap-2 mb-2">
                            <MudIcon Icon="@UiHelpers.GetStatusIcon(instance.Status)" Color="@UiHelpers.GetStatusColor(instance.Status)" />
                            <MudText Typo="Typo.subtitle1" Style="font-weight:600; flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                @instance.Name
                            </MudText>
                            <MudChip T="string" Size="Size.Small" Color="@UiHelpers.GetStatusColor(instance.Status)" Variant="Variant.Filled">
                                @instance.Status
                            </MudChip>
                        </div>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Port: @instance.Port | Mods: @instance.Mods.Count | HC: @instance.HeadlessClientCount
                        </MudText>
                        @if (instance.Status == ServerInstanceStatus.Downloading)
                        {
                            <MudProgressLinear Indeterminate="true" Color="Color.Warning" Class="mt-2" />
                            <MudText Typo="Typo.caption" Color="Color.Warning">Installing server files...</MudText>
                        }
                        @if (instance.StartedAt.HasValue)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Running since @instance.StartedAt.Value.ToString("g")
                            </MudText>
                        }
                    </MudCardContent>
                    <MudCardActions @onclick:stopPropagation="true">
                        @if (instance.Status == ServerInstanceStatus.Running)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning"
                                       StartIcon="@Icons.Material.Filled.Stop"
                                       OnClick="@(() => StopInstance(instance.Id))">Stop</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text"
                                       StartIcon="@Icons.Material.Filled.Refresh"
                                       OnClick="@(() => RestartInstance(instance.Id))">Restart</MudButton>
                        }
                        else if (instance.Status == ServerInstanceStatus.Stopped)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success"
                                       StartIcon="@Icons.Material.Filled.PlayArrow"
                                       OnClick="@(() => StartInstance(instance.Id))"
                                       Disabled="@(!instance.InstalledAt.HasValue || instance.Status == ServerInstanceStatus.Downloading)">Start</MudButton>
                        }
                        <MudSpacer />
                        <MudIconButton Icon="@Icons.Material.Filled.FileDownload" Size="Size.Small"
                                       OnClick="@(() => ExportInstance(instance.Id))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => PromptDelete(instance))" />
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

<MudDialog @bind-Visible="_deleteDialogVisible">
    <TitleContent>
        <MudText Typo="Typo.h6">Delete Server Instance</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>
            Permanently delete @(_instancePendingDelete?.Name ?? "this instance") from KAST?
        </MudText>
        <MudCheckBox @bind-Value="_deleteInstanceFiles"
                     Label="Also delete server files from disk"
                     Color="Color.Error"
                     Class="mt-3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@CancelDelete">Cancel</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="@(() => DeleteInstance(_instancePendingDelete!.Id))">Delete</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private IReadOnlyList<ServerInstance> _instances = [];
    private ServerInstance? _instancePendingDelete;
    private bool _deleteDialogVisible;
    private bool _deleteInstanceFiles;

    protected override async Task OnInitializedAsync() => await RefreshInstances();

    private async Task RefreshInstances()
        => _instances = await ServerService.GetAllInstancesAsync();

    private void PromptDelete(ServerInstance instance)
    {
        _instancePendingDelete = instance;
        _deleteInstanceFiles = false;
        _deleteDialogVisible = true;
    }

    private void CancelDelete()
    {
        _deleteDialogVisible = false;
        _instancePendingDelete = null;
        _deleteInstanceFiles = false;
    }

    private async Task StartInstance(int id)
    {
        try { await ServerService.StartInstanceAsync(id); Nav.NavigateTo($"/servers/{id}"); }
        catch (InvalidOperationException ex) { Snackbar.Add($"Failed to start: {OutputSanitizer.SanitizeException(ex)}", Severity.Error); await RefreshInstances(); }
        catch (System.ComponentModel.Win32Exception ex) { Snackbar.Add($"Failed to start: {OutputSanitizer.SanitizeException(ex)}", Severity.Error); await RefreshInstances(); }
    }

    private async Task StopInstance(int id)
    {
        try { await ServerService.StopInstanceAsync(id); Snackbar.Add("Server stopped", Severity.Success); }
        catch (InvalidOperationException ex) { Snackbar.Add($"Failed to stop: {OutputSanitizer.SanitizeException(ex)}", Severity.Error); }
        catch (System.ComponentModel.Win32Exception ex) { Snackbar.Add($"Failed to stop: {OutputSanitizer.SanitizeException(ex)}", Severity.Error); }
        finally { await RefreshInstances(); }
    }

    private async Task RestartInstance(int id)
    {
        try { await ServerService.RestartInstanceAsync(id); Snackbar.Add("Server restarted", Severity.Success); }
        catch (InvalidOperationException ex) { Snackbar.Add($"Failed to restart: {OutputSanitizer.SanitizeException(ex)}", Severity.Error); }
        catch (System.ComponentModel.Win32Exception ex) { Snackbar.Add($"Failed to restart: {OutputSanitizer.SanitizeException(ex)}", Severity.Error); }
        finally { await RefreshInstances(); }
    }

    private async Task DeleteInstance(int id)
    {
        await ServerService.DeleteInstanceAsync(id, _deleteInstanceFiles);
        _deleteDialogVisible = false;
        _instancePendingDelete = null;
        _deleteInstanceFiles = false;
        await RefreshInstances();
        Snackbar.Add("Instance deleted", Severity.Success);
    }

    private async Task ExportInstance(int id)
    {
        try
        {
            var instance = await ServerService.GetInstanceByIdAsync(id);
            if (instance is null)
            {
                Snackbar.Add("Instance not found", Severity.Error);
                return;
            }

            var json = System.Text.Json.JsonSerializer.Serialize(instance, new System.Text.Json.JsonSerializerOptions
            {
                WriteIndented = true,
                ReferenceHandler = System.Text.Json.Serialization.ReferenceHandler.IgnoreCycles
            });

            var filename = $"{instance.Name.Replace(" ", "_")}_{instance.Id}.json";
            await JS.InvokeVoidAsync("KAST.downloadFile", filename, json);
            Snackbar.Add($"Exported {instance.Name}", Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add($"Export failed: {ex.Message}", Severity.Error);
        }
        catch (System.Text.Json.JsonException ex)
        {
            Snackbar.Add($"Export failed: {ex.Message}", Severity.Error);
        }
        catch (Microsoft.JSInterop.JSException ex)
        {
            Snackbar.Add($"Export failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task OnImportFileSelected(IBrowserFile file)
    {
        if (file is null) return;
        try
        {

            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();

            var options = new System.Text.Json.JsonSerializerOptions
            {
                ReferenceHandler = System.Text.Json.Serialization.ReferenceHandler.IgnoreCycles,
                PropertyNameCaseInsensitive = true
            };
            var instance = System.Text.Json.JsonSerializer.Deserialize<ServerInstance>(json, options);
            if (instance is null)
            {
                Snackbar.Add("Failed to parse instance file", Severity.Error);
                return;
            }

            // Reset fields for a fresh import
            instance.Id = 0;
            instance.Status = ServerInstanceStatus.Stopped;
            instance.ProcessId = null;
            instance.StartedAt = null;
            instance.InstalledAt = null;
            instance.InstalledBuildId = null;
            instance.LastModified = null;

            // Clear relational IDs and rewire navigations so EF creates new child rows
            foreach (var mod in instance.Mods)
            {
                mod.ServerInstanceId = 0;
                mod.ServerInstance = instance;
            }
            foreach (var hc in instance.HeadlessClients)
            {
                hc.Id = 0;
                hc.ServerInstanceId = 0;
                hc.ServerInstance = instance;
                hc.Status = ServerInstanceStatus.Stopped;
                hc.ProcessId = null;
                hc.StartedAt = null;
            }

            await ServerService.CreateInstanceAsync(instance);
            await RefreshInstances();
            Snackbar.Add("Instance imported successfully", Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add($"Import failed: {ex.Message}", Severity.Error);
        }
        catch (IOException ex)
        {
            Snackbar.Add($"Import failed: {ex.Message}", Severity.Error);
        }
        catch (System.Text.Json.JsonException ex)
        {
            Snackbar.Add($"Import failed: {ex.Message}", Severity.Error);
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException ex)
        {
            Snackbar.Add($"Import failed: {ex.Message}", Severity.Error);
        }
    }

}
