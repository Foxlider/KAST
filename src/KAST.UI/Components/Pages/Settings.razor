    {
        const string defaultAccent = "#FF7043"; // Deep Orange 400
        const bool   defaultDark   = true;
        _accentMud  = defaultAccent;
        _isDarkMode = defaultDark;
        await ThemeService.SetAccentAsync(defaultAccent);
        await ThemeService.SetDarkModeAsync(defaultDark);
        Snackbar.Add("Theme reset to defaults", Severity.Success);
    }

    private async Task CreateApiKey()
    {
        if (string.IsNullOrWhiteSpace(_newKeyName)) return;
        var (key, raw) = await ApiKeyService.CreateApiKeyAsync(_newKeyName.Trim());
        _newRawKey = raw;
        _ = key;
        _newKeyName = "";
        _apiKeys = await ApiKeyService.GetAllKeysAsync();
    }

    private async Task RevokeKey(int id)
    {
        await ApiKeyService.RevokeKeyAsync(id);
        _apiKeys = await ApiKeyService.GetAllKeysAsync();
        Snackbar.Add("API key revoked", Severity.Success);
    }

    public void Dispose()
    {
        SteamService.AuthStateChanged -= OnAuthStateChanged;
        _qrCts?.Cancel();
        _qrCts?.Dispose();
        _credentialCts?.Cancel();
        _credentialCts?.Dispose();
    }
