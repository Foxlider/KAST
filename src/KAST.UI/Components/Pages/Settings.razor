@page "/settings"
@attribute [Authorize]
@implements IDisposable
@inject IApiKeyService ApiKeyService
@inject IUserAccountService AccountService
@inject ISettingsService SettingsService
@inject ISteamService SteamService
@inject IOutputSanitizer OutputSanitizer
@inject ISnackbar Snackbar
@inject ThemeService ThemeService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IConfiguration Configuration
@using MudBlazor.Utilities

<PageTitle>KAST -- Settings</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Settings</MudText>

<MudTabs @bind-ActivePanelIndex="_activePanelIndex" Elevation="2" Rounded="true" ApplyEffectsToContainer="true">

    @* ════ General ════ *@
    <MudTabPanel Text="General">
        <MudCard Elevation="1" Class="mt-3">
            <MudCardContent>
                <MudText Typo="Typo.subtitle1" Class="mb-3">Downloads</MudText>
                <div class="d-flex align-center gap-4 flex-wrap">
                    <MudNumericField @bind-Value="_parallelDownloads" Label="Parallel workers"
                                     Min="1" Max="64" Step="1" Style="width:160px;" />
                    <MudNumericField @bind-Value="_parallelModDownloads" Label="Parallel mod downloads"
                                     Min="1" Max="16" Step="1" Style="width:190px;" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Workers download files inside each Steam install. Parallel mod downloads controls how many Workshop mods run at once.
                    </MudText>
                </div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="SaveGeneralSettings">Save</MudButton>

                <MudDivider Class="my-4" />

                <MudText Typo="Typo.subtitle2" Class="mb-1">Speed Benchmark</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                    Downloads ~30 MB from Steam CDN at different worker levels to find the optimal per-install worker count.
                </MudText>

                @if (_benchmarkRunning)
                {
                    <div class="d-flex align-center gap-2">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <MudText Typo="Typo.body2">@(_benchmarkStatus ?? "Running benchmark...")</MudText>
                    </div>
                }
                else
                {
                    <MudButton Variant="Variant.Outlined" OnClick="RunBenchmark" Disabled="@(!SteamService.IsConnected)">
                        Run Benchmark
                    </MudButton>
                    @if (!SteamService.IsConnected)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2">Connect to Steam first.</MudText>
                    }
                }

                @if (_benchmarkResults is { Count: > 0 })
                {
                    <MudSimpleTable Style="margin-top:12px; max-width:480px;" Dense="true" Hover="true">
                        <thead><tr><th>Workers</th><th>Speed</th><th>Time</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var r in _benchmarkResults)
                            {
                                <tr>
                                    <td>@r.Parallelism</td>
                                    <td>@r.MbPerSecond.ToString("F1") MB/s</td>
                                    <td>@r.ElapsedSeconds.ToString("F1")s</td>
                                    <td>
                                        @if (r.Parallelism == GetBestBenchmark().Parallelism)
                                        { <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">Best</MudChip> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3"
                               OnClick="@(() => ApplyBenchmark(GetBestBenchmark().Parallelism))">
                        Apply @GetBestBenchmark().Parallelism parallel workers (@GetBestBenchmark().MbPerSecond.ToString("F1") MB/s)
                    </MudButton>
                }

                <MudDivider Class="my-4" />

                <MudText Typo="Typo.subtitle1" Class="mb-3">Appearance</MudText>

                @* ── Dark / Light mode ── *@
                <MudText Typo="Typo.body2" Class="mb-1">Theme</MudText>
                <div class="d-flex align-center gap-3 mb-4 flex-wrap">
                    <MudIcon Icon="@(_isDarkMode ? Icons.Material.Filled.DarkMode : Icons.Material.Filled.WbSunny)" />
                    <MudSwitch @bind-Value="_isDarkMode" Label="@(_isDarkMode ? "Dark" : "Light")" Color="Color.Primary" />
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="SaveDarkMode">Apply</MudButton>
                </div>

                @* ── Accent colour swatches ── *@
                <MudText Typo="Typo.body2" Class="mb-2">Accent Color</MudText>
                <div class="d-flex flex-wrap gap-2 mb-3">
                    @foreach (var opt in _accentOptions)
                    {
                        var selected = IsAccentSelected(opt.Value);
                        <MudTooltip Text="@opt.Label" Placement="Placement.Top">
                            <div @onclick="@(() => SelectAccent(opt.Value))"
                                 style="@SwatchStyle(opt.Value, selected)" />
                        </MudTooltip>
                    }
                </div>

                @* ── Custom colour picker ── *@
                <div class="d-flex align-center gap-3 flex-wrap">
                    <MudColorPicker @bind-Value="_accentMud" ShowAlpha="false" ShowModeSwitch="false"
                                    Label="Custom color" PickerVariant="PickerVariant.Dialog"
                                    Style="max-width:220px;" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAccent">Apply Accent</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.SettingsBackupRestore"
                               OnClick="ResetToDefaults">Reset Defaults</MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    </MudTabPanel>

    <MudTabPanel Text="Accounts">
        <MudGrid Class="mt-3" Spacing="3">
            <MudItem xs="12">
                <MudCard Elevation="1">
                    <MudCardContent>
                        <div class="d-flex align-center justify-space-between gap-3 flex-wrap">
                            <div>
                                <MudText Typo="Typo.subtitle1">Authentication</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Mode: @_authSettings.Mode
                                </MudText>
                            </div>
                            <MudChip T="string" Color="@(_authSettings.IsOidcConfigured ? Color.Success : Color.Default)"
                                     Variant="Variant.Outlined">
                                @(_authSettings.IsOidcConfigured ? "OIDC configured" : "OIDC not configured")
                            </MudChip>
                        </div>
                        <MudSimpleTable Dense="true" Class="mt-3">
                            <tbody>
                                <tr><td>Provider</td><td>@_authSettings.DisplayName</td></tr>
                                <tr><td>Callback URL</td><td>@OidcCallbackUrl</td></tr>
                                <tr><td>Group claim</td><td>@_authSettings.GroupClaim</td></tr>
                                <tr><td>Allowed groups</td><td>@string.Join(", ", _authSettings.AllowedGroups)</td></tr>
                            </tbody>
                        </MudSimpleTable>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="5">
                <MudCard Elevation="1">
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle1" Class="mb-3">My Profile</MudText>
                        @if (_currentUser is not null)
                        {
                            <div class="d-flex align-center gap-3 mb-4">
                                @if (!string.IsNullOrWhiteSpace(_currentUser.AvatarFileName))
                                {
                                    <MudAvatar Size="Size.Large">
                                        <MudImage Src="@($"/account/avatars/{_currentUser.AvatarFileName}")" Alt="@_currentUser.Username" />
                                    </MudAvatar>
                                }
                                else
                                {
                                    <MudAvatar Size="Size.Large" Color="Color.Secondary">@GetInitial(_currentUser.Username)</MudAvatar>
                                }
                                <div>
                                    <MudText Typo="Typo.subtitle2">@_currentUser.Username</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@AccountTypeLabel(_currentUser)</MudText>
                                </div>
                            </div>

                            @if (_currentUser.IsExternallyManaged)
                            {
                                <MudAlert Severity="Severity.Info" Dense="true">
                                    This account is managed by @_currentUser.ExternalProvider.
                                </MudAlert>
                            }
                            else
                            {
                                <div class="d-flex flex-column gap-3">
                                    <MudTextField @bind-Value="_profileUsername" Label="Username" Variant="Variant.Outlined" />
                                    <MudTextField @bind-Value="_profilePassword" Label="New password" Variant="Variant.Outlined" InputType="InputType.Password" />
                                    <div>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Avatar image</MudText>
                                        <InputFile OnChange="OnProfileAvatarSelected" accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp" />
                                    </div>
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveProfile">
                                        Save Profile
                                    </MudButton>
                                </div>
                            }
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="7">
                <MudCard Elevation="1">
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle1" Class="mb-3">Administrators</MudText>
                        @if (_accounts.Count > 0)
                        {
                            <MudDataGrid T="KastUser" Items="@_accounts" Dense="true" Hover="true" Class="mb-4">
                                <Columns>
                                    <TemplateColumn Title="">
                                        <CellTemplate>
                                            @if (!string.IsNullOrWhiteSpace(context.Item.AvatarFileName))
                                            {
                                                <MudAvatar Size="Size.Small">
                                                    <MudImage Src="@($"/account/avatars/{context.Item.AvatarFileName}")" Alt="@context.Item.Username" />
                                                </MudAvatar>
                                            }
                                            else
                                            {
                                                <MudAvatar Size="Size.Small" Color="Color.Secondary">@GetInitial(context.Item.Username)</MudAvatar>
                                            }
                                        </CellTemplate>
                                    </TemplateColumn>
                                    <PropertyColumn Property="u => u.Username" Title="Username" />
                                    <TemplateColumn Title="Source">
                                        <CellTemplate>@AccountTypeLabel(context.Item)</CellTemplate>
                                    </TemplateColumn>
                                    <TemplateColumn Title="Created">
                                        <CellTemplate>@context.Item.CreatedAt.ToLocalTime().ToString("g")</CellTemplate>
                                    </TemplateColumn>
                                    <TemplateColumn Title="Last Login">
                                        <CellTemplate>@(context.Item.LastLoginAt?.ToLocalTime().ToString("g") ?? "Never")</CellTemplate>
                                    </TemplateColumn>
                                </Columns>
                            </MudDataGrid>
                        }

                        <MudDivider Class="my-3" />
                        @if (_authSettings.IsLocalEnabled)
                        {
                            <MudText Typo="Typo.subtitle2" Class="mb-3">Create administrator</MudText>
                            <div class="d-flex flex-column gap-3">
                                <MudTextField @bind-Value="_newAdminUsername" Label="Username" Variant="Variant.Outlined" />
                                <MudTextField @bind-Value="_newAdminPassword" Label="Password" Variant="Variant.Outlined" InputType="InputType.Password" />
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Avatar image</MudText>
                                    <InputFile OnChange="OnNewAdminAvatarSelected" accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp" />
                                </div>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateAdmin">
                                    Create Administrator
                                </MudButton>
                            </div>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Local administrator creation is disabled by the current auth mode.
                            </MudText>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    @* ════ Steam ════ *@
    <MudTabPanel Text="Steam">
        <MudCard Elevation="1" Class="mt-3">
            <MudCardContent>
                <MudText Typo="Typo.subtitle1" Class="mb-3">Steam Account</MudText>

                @if (SteamService.IsAuthenticated)
                {
                    <div class="d-flex align-center gap-4 flex-wrap pa-3"
                         style="border-radius:8px; background:rgba(255,255,255,.04);">
                        @if (!string.IsNullOrEmpty(SteamService.Profile?.AvatarUrl))
                        {
                            <img src="@SteamService.Profile.AvatarUrl" alt="Steam avatar"
                                 style="width:64px;height:64px;border-radius:50%;object-fit:cover;" />
                        }
                        <div>
                            <MudText Typo="Typo.h6">@(SteamService.Profile?.PersonaName ?? SteamService.CurrentUsername)</MudText>
                            @if (SteamService.Profile?.PersonaName != SteamService.CurrentUsername)
                            { <MudText Typo="Typo.body1" Color="Color.Secondary">@SteamService.CurrentUsername</MudText> }
                            @if (SteamService.Profile?.SteamId > 0)
                            { <MudText Typo="Typo.caption" Color="Color.Secondary">SteamID: @SteamService.Profile.SteamId</MudText> }
                        </div>
                        <MudButton Variant="Variant.Outlined" Class="ml-auto" OnClick="Logout">Sign out</MudButton>
                    </div>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Sign in to download and manage mods with your Steam account.
                    </MudText>

                    <MudPaper Elevation="0" Class="pa-3 mb-3" Style="border:1px solid rgba(255,255,255,.12); border-radius:8px;">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Sign in with Username + Password</MudText>
                        <div class="d-flex gap-2 flex-wrap align-end">
                            <MudTextField @bind-Value="_steamUsername" Label="Steam Username" Style="min-width:220px;" Disabled="@_loggingIn" />
                            <MudTextField @bind-Value="_steamPassword" Label="Steam Password" InputType="InputType.Password" Style="min-width:220px;" Disabled="@_loggingIn" />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartCredentialLogin" Disabled="@_loggingIn">
                                Sign in
                            </MudButton>
                        </div>

                        @if (_credentialSession?.RequiresGuardCode == true)
                        {
                            <div class="d-flex gap-2 flex-wrap align-end mt-3">
                                <MudTextField @bind-Value="_steamGuardCode" Label="Steam Guard Code" Style="min-width:220px;" />
                                <MudButton Variant="Variant.Filled" OnClick="SubmitGuardCode">Submit Code</MudButton>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_credentialSession.GuardCodePrompt))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">@_credentialSession.GuardCodePrompt</MudText>
                            }
                        }
                        else if (_credentialSession?.WaitingForDeviceConfirmation == true)
                        {
                            <div class="d-flex align-center gap-2 mt-2">
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                <MudText Typo="Typo.body2">@(_credentialSession.GuardCodePrompt ?? "Approve the sign-in request in Steam, then return here.")</MudText>
                            </div>
                        }
                    </MudPaper>

                    @if (_qrCodeBase64 == null && !_loggingIn)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartQrLogin">
                            Sign in with QR Code
                        </MudButton>
                    }
                    else if (_loggingIn && _qrCodeBase64 == null)
                    {
                        <div class="d-flex align-center gap-2 mt-2">
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            <MudText Typo="Typo.body2">Connecting to Steam...</MudText>
                        </div>
                    }
                    else if (_qrCodeBase64 != null)
                    {
                        <div class="d-flex gap-6 flex-wrap align-center mt-2">
                            <img src="data:image/png;base64,@_qrCodeBase64" alt="Steam QR Login"
                                 style="width:200px;height:200px;image-rendering:pixelated;border-radius:8px;" />
                            <div>
                                <MudText Typo="Typo.subtitle2" Class="mb-1">Scan with the Steam mobile app</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                                    Open Steam Guard &rarr; tap <b>Confirm sign-in</b>
                                </MudText>
                                @if (!string.IsNullOrEmpty(_challengeUrl))
                                {
                                    <MudText Typo="Typo.body2" Class="mb-3">
                                        Prefer browser login? <MudLink Href="@_challengeUrl" Target="_blank">Open Steam sign-in page</MudLink>
                                        in a new tab.
                                    </MudText>
                                }
                                @if (_qrPolling)
                                {
                                    <div class="d-flex align-center gap-2">
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                        <MudText Typo="Typo.body2">Waiting for confirmation...</MudText>
                                    </div>
                                }
                                else
                                {
                                    <MudButton Variant="Variant.Text" OnClick="StartQrLogin">Refresh QR Code</MudButton>
                                }
                            </div>
                        </div>
                    }
                }
            </MudCardContent>
        </MudCard>
    </MudTabPanel>

    @* ════ API Keys ════ *@
    <MudTabPanel Text="API Keys">
        <MudCard Elevation="1" Class="mt-3">
            <MudCardContent>
                <MudText Typo="Typo.subtitle1" Class="mb-1">API Keys</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                    Generate API keys for bot integrations or custom frontends. Keys are shown only once upon creation.
                </MudText>

                <div class="d-flex gap-2 mb-3 flex-wrap">
                    <MudTextField @bind-Value="_newKeyName" Label="Key name (e.g. Discord Bot)"
                                  Style="width:300px;" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateApiKey">Generate Key</MudButton>
                </div>

                @if (!string.IsNullOrEmpty(_newRawKey))
                {
                    <MudAlert Severity="Severity.Warning" Class="mb-3">
                        Copy this key — it won't be shown again:
                        <code style="margin-left:8px; font-family:monospace;">@_newRawKey</code>
                    </MudAlert>
                }

                @if (_apiKeys.Count > 0)
                {
                    <MudDataGrid T="ApiKey" Items="@_apiKeys" Dense="true" Hover="true">
                        <Columns>
                            <PropertyColumn Property="k => k.Name" Title="Name" />
                            <TemplateColumn Title="Prefix">
                                <CellTemplate>@context.Item.KeyPrefix...</CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Created">
                                <CellTemplate>@context.Item.CreatedAt.ToString("g")</CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Last Used">
                                <CellTemplate>@(context.Item.LastUsedAt?.ToString("g") ?? "Never")</CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Status">
                                <CellTemplate>
                                    <MudChip T="string" Size="Size.Small"
                                             Color="@(context.Item.IsActive ? Color.Success : Color.Default)"
                                             Variant="Variant.Outlined">
                                        @(context.Item.IsActive ? "Active" : "Revoked")
                                    </MudChip>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Actions">
                                <CellTemplate>
                                    @if (context.Item.IsActive)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                                   OnClick="@(() => RevokeKey(context.Item.Id))">
                                            Revoke
                                        </MudButton>
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                    </MudDataGrid>
                }
            </MudCardContent>
        </MudCard>
    </MudTabPanel>
</MudTabs>

@code {
    private bool _loggingIn;
    private string? _qrCodeBase64;
    private string? _challengeUrl;
    private SteamQrAuthSession? _qrSession;
    private bool _qrPolling;
    private CancellationTokenSource? _qrCts;
    private SteamCredentialAuthSession? _credentialSession;
    private CancellationTokenSource? _credentialCts;
    private string _steamUsername = "";
    private string _steamPassword = "";
    private string _steamGuardCode = "";

    private IReadOnlyList<ApiKey> _apiKeys = [];
    private string _newKeyName = "";
    private string _newRawKey = "";
    private int _parallelDownloads = 4;
    private int _parallelModDownloads = 1;

    private KastUser? _currentUser;
    private IReadOnlyList<KastUser> _accounts = [];
    private string _profileUsername = "";
    private string _profilePassword = "";
    private IBrowserFile? _profileAvatar;
    private string _newAdminUsername = "";
    private string _newAdminPassword = "";
    private IBrowserFile? _newAdminAvatar;
    private const long MaxAvatarBytes = 2 * 1024 * 1024;
    private KastAuthSettings _authSettings = new(KastAuthMode.Local, "OpenID Connect", null, null, null, "groups", "preferred_username", ["KAST Admins"]);
    private string OidcCallbackUrl => new Uri(new Uri(Navigation.BaseUri), "auth/oidc/callback").ToString();

    private bool _benchmarkRunning;
    private string? _benchmarkStatus;
    private IReadOnlyList<BenchmarkResult>? _benchmarkResults;

    private int _activePanelIndex = 0;
    private bool _isDarkMode;

    protected override async Task OnInitializedAsync()
    {
        _authSettings = Configuration.GetKastAuthSettings();
        SteamService.AuthStateChanged += OnAuthStateChanged;
        _apiKeys = await ApiKeyService.GetAllKeysAsync();
        await LoadAccountsAsync();
        var settings = await SettingsService.GetSettingsAsync();
        _parallelDownloads = settings.ParallelDownloads;
        _parallelModDownloads = settings.ParallelModDownloads;
        _accentMud  = ThemeService.AccentColor;
        _isDarkMode = ThemeService.IsDarkMode;

        // Check if we should navigate to a specific tab.
        var uri = new Uri(Navigation.Uri);
        var queryParams = System.Web.HttpUtility.ParseQueryString(uri.Query);
        _activePanelIndex = queryParams["tab"] switch
        {
            "accounts" => 1,
            "steam" => 2,
            "api-keys" => 3,
            _ => _activePanelIndex
        };
    }

    private void OnAuthStateChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadAccountsAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.GetUserId();
        if (userId is not null)
        {
            _currentUser = await AccountService.GetByIdAsync(userId.Value);
            _profileUsername = _currentUser?.Username ?? "";
        }

        _accounts = await AccountService.GetAllUsersAsync();
    }

    private void OnProfileAvatarSelected(InputFileChangeEventArgs e)
        => _profileAvatar = e.File;

    private void OnNewAdminAvatarSelected(InputFileChangeEventArgs e)
        => _newAdminAvatar = e.File;

    private async Task SaveProfile()
    {
        if (_currentUser is null)
            return;
        if (_currentUser.IsExternallyManaged)
            return;

        try
        {
            await using var avatarStream = _profileAvatar?.OpenReadStream(MaxAvatarBytes);
            _currentUser = await AccountService.UpdateProfileAsync(
                _currentUser.Id,
                _profileUsername,
                string.IsNullOrWhiteSpace(_profilePassword) ? null : _profilePassword,
                avatarStream,
                _profileAvatar?.Name,
                _profileAvatar?.Size ?? 0);

            _profilePassword = "";
            _profileAvatar = null;
            await LoadAccountsAsync();
            Snackbar.Add("Profile updated", Severity.Success);
        }
        catch (Exception ex) when (ex is InvalidOperationException or IOException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task CreateAdmin()
    {
        try
        {
            await using var avatarStream = _newAdminAvatar?.OpenReadStream(MaxAvatarBytes);
            await AccountService.CreateAdminAsync(
                _newAdminUsername,
                _newAdminPassword,
                avatarStream,
                _newAdminAvatar?.Name,
                _newAdminAvatar?.Size ?? 0);

            _newAdminUsername = "";
            _newAdminPassword = "";
            _newAdminAvatar = null;
            await LoadAccountsAsync();
            Snackbar.Add("Administrator account created", Severity.Success);
        }
        catch (Exception ex) when (ex is InvalidOperationException or IOException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private static string GetInitial(string username)
        => string.IsNullOrWhiteSpace(username)
            ? "?"
            : username.Trim()[0].ToString().ToUpperInvariant();

    private static string AccountTypeLabel(KastUser user)
        => user.IsExternallyManaged
            ? $"{user.ExternalProvider ?? "External"} administrator"
            : "Local administrator";

    private async Task StartQrLogin()
    {
        if (_loggingIn || _qrPolling) return;
        _credentialCts?.Cancel();
        _credentialSession = null;
        _loggingIn = true;
        _qrCodeBase64 = null; _challengeUrl = null; _qrSession = null; _qrPolling = false;
        StateHasChanged();

        var session = await SteamService.BeginQrLoginAsync();
        if (!string.IsNullOrEmpty(session.ErrorMessage))
        {
            _loggingIn = false;
            Snackbar.Add($"QR error: {OutputSanitizer.Sanitize(session.ErrorMessage)}", Severity.Error);
            StateHasChanged();
            return;
        }

        _challengeUrl = session.ChallengeUrl;
        _qrCodeBase64 = GenerateQrCodeBase64(session.ChallengeUrl);
        _qrSession = session;
        _qrPolling = true;
        _loggingIn = false;

        session.ChallengeUrlChanged = newUrl =>
            InvokeAsync(() => { _challengeUrl = newUrl; _qrCodeBase64 = GenerateQrCodeBase64(newUrl); StateHasChanged(); });

        StateHasChanged();
        _qrCts?.Cancel();
        _qrCts = new CancellationTokenSource(TimeSpan.FromMinutes(3));
        _ = PollQrAsync(_qrCts.Token);
    }

    private async Task StartCredentialLogin()
    {
        if (_loggingIn || _qrPolling) return;
        _loggingIn = true;
        _qrCts?.Cancel();
        _qrCodeBase64 = null; _challengeUrl = null; _qrSession = null; _qrPolling = false;
        _credentialSession = null;
        StateHasChanged();

        var session = await SteamService.BeginCredentialLoginAsync(_steamUsername.Trim(), _steamPassword);
        if (!string.IsNullOrEmpty(session.ErrorMessage))
        {
            _loggingIn = false;
            Snackbar.Add($"Credential login error: {OutputSanitizer.Sanitize(session.ErrorMessage)}", Severity.Error);
            StateHasChanged();
            return;
        }

        _credentialSession = session;
        _steamGuardCode = "";
        session.StateChanged = () => InvokeAsync(StateHasChanged);
        _loggingIn = false;
        StateHasChanged();

        _credentialCts?.Cancel();
        _credentialCts = new CancellationTokenSource(TimeSpan.FromMinutes(5));
        _ = PollCredentialAsync(_credentialCts.Token);
    }

    private async Task SubmitGuardCode()
    {
        if (_credentialSession is null)
            return;

        var accepted = await SteamService.SubmitCredentialGuardCodeAsync(_credentialSession, _steamGuardCode);
        if (!accepted)
        {
            Snackbar.Add("No Steam Guard code was requested yet", Severity.Warning);
            return;
        }

        _steamGuardCode = "";
        StateHasChanged();
    }

    private async Task PollQrAsync(CancellationToken ct)
    {
        try
        {
            var success = await SteamService.PollQrLoginAsync(_qrSession!, ct);
            await InvokeAsync(() =>
            {
                _qrPolling = false; _qrCodeBase64 = null; _challengeUrl = null; _qrSession = null;
                Snackbar.Add(success
                    ? $"Signed in as {SteamService.Profile?.PersonaName ?? SteamService.CurrentUsername}"
                    : "QR login expired or failed", success ? Severity.Success : Severity.Error);
                StateHasChanged();
            });
        }
        catch (OperationCanceledException)
        {
            await InvokeAsync(() => { _qrPolling = false; _qrCodeBase64 = null; _challengeUrl = null; StateHasChanged(); });
        }
    }

    private async Task PollCredentialAsync(CancellationToken ct)
    {
        try
        {
            var success = await SteamService.PollCredentialLoginAsync(_credentialSession!, ct);
            await InvokeAsync(() =>
            {
                _credentialSession = null;
                _steamPassword = "";
                Snackbar.Add(success
                    ? $"Signed in as {SteamService.Profile?.PersonaName ?? SteamService.CurrentUsername}"
                    : "Credential login expired or failed", success ? Severity.Success : Severity.Error);
                StateHasChanged();
            });
        }
        catch (OperationCanceledException)
        {
            await InvokeAsync(() => { _credentialSession = null; StateHasChanged(); });
        }
    }

    private static string GenerateQrCodeBase64(string url)
    {
        using var qrGenerator = new QRCoder.QRCodeGenerator();
        using var qrData = qrGenerator.CreateQrCode(url, QRCoder.QRCodeGenerator.ECCLevel.M);
        using var qrCode = new QRCoder.PngByteQRCode(qrData);
        return Convert.ToBase64String(qrCode.GetGraphic(8));
    }



    private async Task Logout()
    {
        _qrCts?.Cancel();
        _credentialCts?.Cancel();
        _credentialSession = null;
        _steamGuardCode = "";
        _steamPassword = "";
        _qrCodeBase64 = null; _challengeUrl = null; _qrSession = null; _qrPolling = false;
        await SteamService.LogoutAsync();
        Snackbar.Add("Signed out of Steam", Severity.Info);
    }

    private async Task SaveGeneralSettings()
    {
        var settings = await SettingsService.GetSettingsAsync();
        settings.ParallelDownloads = Math.Clamp(_parallelDownloads, 1, 64);
        settings.ParallelModDownloads = Math.Clamp(_parallelModDownloads, 1, 16);
        await SettingsService.UpdateSettingsAsync(settings);
        Snackbar.Add("Settings saved", Severity.Success);
    }

    private async Task RunBenchmark()
    {
        _benchmarkRunning = true; _benchmarkResults = null; _benchmarkStatus = "Preparing...";
        StateHasChanged();
        try
        {
            if (!SteamService.IsConnected)
            { _benchmarkStatus = "Connecting to Steam..."; StateHasChanged(); await SteamService.LoginAnonymousAsync(); }
            var log = new Progress<string>(msg => InvokeAsync(() => { _benchmarkStatus = OutputSanitizer.Sanitize(msg); StateHasChanged(); }));
            _benchmarkResults = await SteamService.BenchmarkDownloadAsync(log);
        }
        catch (Exception ex) { Snackbar.Add($"Benchmark failed: {OutputSanitizer.SanitizeException(ex)}", Severity.Error); }
        finally { _benchmarkRunning = false; _benchmarkStatus = null; StateHasChanged(); }
    }

    private async Task ApplyBenchmark(int parallelism) { _parallelDownloads = parallelism; await SaveGeneralSettings(); }

    private BenchmarkResult GetBestBenchmark() => _benchmarkResults!.OrderByDescending(r => r.MbPerSecond).First();

