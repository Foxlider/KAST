    private bool CanChangeService =>
        _serviceStatus is { IsSupported: true, IsAdministrator: true } && !_serviceBusy;

    private bool CanConfigureService =>
        CanChangeService && _serviceStatus!.State != HostServiceRunState.NotInstalled;

    private bool CanStartService =>
        CanConfigureService && _serviceStatus!.State is HostServiceRunState.Stopped;

    private bool CanStopService =>
        CanConfigureService && _serviceStatus!.State is HostServiceRunState.Running;

    private Severity ServiceAlertSeverity =>
        _serviceStatus is null ? Severity.Info :
        !_serviceStatus.IsSupported ? Severity.Warning :
        !_serviceStatus.IsAdministrator ? Severity.Warning :
        _serviceStatus.State == HostServiceRunState.NotInstalled ? Severity.Info :
        Severity.Success;

    private string ServiceStatusText =>
        _serviceStatus is null ? "Loading service status." :
        _serviceStatus.State == HostServiceRunState.NotInstalled ? "KAST is not installed as a Windows service." :
        $"KAST service is {_serviceStatus.State}.";

    private string ApplyUpdateConfirmationText => _updateCheck?.RestartMode == AppUpdateRestartMode.WindowsService
        ? "I understand KAST will stop and the Windows service will restart after the update is applied."
        : "I understand KAST will stop and restart to apply the staged update.";

    private HostServiceConfigureRequest CurrentServiceRequest()
        => new(
            _serviceStartupMode,
            new HostServiceRecoveryOptions(
                _serviceRestartOnCrash,
                Math.Clamp(_serviceRestartDelaySeconds, 5, 3600),
                Math.Clamp(_serviceResetFailureDays, 0, 365)));

    private async Task LoadServiceStatus()
    {
        _serviceStatus = await HostServiceManager.GetStatusAsync();
        _serviceStartupMode = _serviceStatus.StartupMode;
        _serviceRestartOnCrash = _serviceStatus.Recovery.RestartOnCrash;
        _serviceRestartDelaySeconds = _serviceStatus.Recovery.RestartDelaySeconds;
        _serviceResetFailureDays = _serviceStatus.Recovery.ResetFailureCountAfterDays;
        StateHasChanged();
    }

    private void LoadCrashReports()
    {
        _crashReports = CrashReportService.GetRecentReports(20);
        StateHasChanged();
    }

    private async Task RunServiceOperation(Func<CancellationToken, Task<HostServiceOperationResult>> operation)
    {
        _serviceBusy = true;
        StateHasChanged();
        try
        {
            var result = await operation(CancellationToken.None);
            if (result.Status is not null)
                ApplyServiceStatus(result.Status);
            else
                await LoadServiceStatus();

            Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Error);
        }
        catch (Exception ex) when (ex is InvalidOperationException or IOException)
        {
            Snackbar.Add($"Service operation failed: {OutputSanitizer.SanitizeException(ex)}", Severity.Error);
            await LoadServiceStatus();
        }
        finally
        {
            _serviceBusy = false;
            StateHasChanged();
        }
    }

    private void ApplyServiceStatus(HostServiceStatus status)
    {
        _serviceStatus = status;
        _serviceStartupMode = status.StartupMode;
        _serviceRestartOnCrash = status.Recovery.RestartOnCrash;
        _serviceRestartDelaySeconds = status.Recovery.RestartDelaySeconds;
        _serviceResetFailureDays = status.Recovery.ResetFailureCountAfterDays;
    }

    private Task InstallService()
        => RunServiceOperation(ct => HostServiceManager.InstallAsync(CurrentServiceRequest(), ct));

    private Task ConfigureService()
        => RunServiceOperation(ct => HostServiceManager.ConfigureAsync(CurrentServiceRequest(), ct));

    private Task StartService()
        => RunServiceOperation(HostServiceManager.StartAsync);

    private Task StopService()
        => RunServiceOperation(HostServiceManager.StopAsync);

    private Task UninstallService()
        => RunServiceOperation(HostServiceManager.UninstallAsync);

    private async Task CheckForUpdate(bool showSnackbar = true)
    {
        _checkingUpdate = true;
        _downloadResult = null;
        _confirmApplyUpdate = false;
        StateHasChanged();

        try
        {
            _updateCheck = await AppUpdateService.CheckForUpdatesAsync(_updateChannelId);
            if (showSnackbar)
                Snackbar.Add(_updateCheck.Message, _updateCheck.IsChannelAvailable ? Severity.Info : Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Update check failed: {OutputSanitizer.SanitizeException(ex)}", Severity.Error);
        }
        finally
        {
            _checkingUpdate = false;
            StateHasChanged();
        }
    }

    private async Task DownloadUpdate()
    {
        _downloadingUpdate = true;
        _downloadResult = null;
        _confirmApplyUpdate = false;
        _updateProgressPercent = null;
        _updateProgressMessage = "Preparing...";
        StateHasChanged();

        try
        {
            var progress = new Progress<AppUpdateProgress>(p => InvokeAsync(() =>
            {
                _updateProgressPercent = p.Percent;
                _updateProgressMessage = p.Message;
                StateHasChanged();
            }));

            _downloadResult = await AppUpdateService.DownloadUpdateAsync(_updateChannelId, progress);
            Snackbar.Add(_downloadResult.Message, _downloadResult.Success ? Severity.Success : Severity.Error);
        }
        catch (Exception ex)
        {
            _downloadResult = new(false, $"Update download failed: {OutputSanitizer.SanitizeException(ex)}", null, null, false);
            Snackbar.Add(_downloadResult.Message, Severity.Error);
        }
        finally
        {
            _downloadingUpdate = false;
            _updateProgressPercent = null;
            StateHasChanged();
        }
    }

    private async Task ApplyStagedUpdate()
    {
        if (_downloadResult?.StagedUpdateId is null)
            return;

        _applyingUpdate = true;
        StateHasChanged();

        try
        {
            var result = await AppUpdateService.ApplyStagedUpdateAsync(_downloadResult.StagedUpdateId);
            Snackbar.Add(result.Message, result.Success ? Severity.Info : Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Applying update failed: {OutputSanitizer.SanitizeException(ex)}", Severity.Error);
        }
        finally
        {
            _applyingUpdate = false;
            StateHasChanged();
        }
    }

    private static string FormatBytes(long bytes)
    {
        string[] suffixes = ["B", "KB", "MB", "GB"];
        double value = bytes;
        var suffix = 0;
        while (value >= 1024 && suffix < suffixes.Length - 1)
        {
            value /= 1024;
            suffix++;
        }
        return $"{value:0.0} {suffixes[suffix]}";
    }

    private async Task RunBenchmark()
    {
        _benchmarkRunning = true; _benchmarkResults = null; _benchmarkStatus = "Preparing...";
        StateHasChanged();
        try
        {
            if (!SteamService.IsConnected)
            { _benchmarkStatus = "Connecting to Steam..."; StateHasChanged(); await SteamService.LoginAnonymousAsync(); }
            var log = new Progress<string>(msg => InvokeAsync(() => { _benchmarkStatus = OutputSanitizer.Sanitize(msg); StateHasChanged(); }));
            _benchmarkResults = await SteamService.BenchmarkDownloadAsync(log);
        }
        catch (Exception ex) { Snackbar.Add($"Benchmark failed: {OutputSanitizer.SanitizeException(ex)}", Severity.Error); }
        finally { _benchmarkRunning = false; _benchmarkStatus = null; StateHasChanged(); }
    }

    private async Task ApplyBenchmark(int parallelism) { _parallelDownloads = parallelism; await SaveGeneralSettings(); }

    private BenchmarkResult GetBestBenchmark() => _benchmarkResults!.OrderByDescending(r => r.MbPerSecond).First();

