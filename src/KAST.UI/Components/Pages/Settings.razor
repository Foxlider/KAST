    private async Task SaveGeneralSettings()
    {
        if (string.IsNullOrWhiteSpace(_modsDirectory) || string.IsNullOrWhiteSpace(_serversDirectory))
        {
            Snackbar.Add("Storage directories are required", Severity.Error);
            return;
        }

        try
        {
            var modsDirectory = ResolveStoragePath(_modsDirectory);
            var serversDirectory = ResolveStoragePath(_serversDirectory);
            var settings = await SettingsService.GetSettingsAsync();

            if (!PathsEqual(settings.ModsDirectory, modsDirectory) ||
                !PathsEqual(settings.ServersDirectory, serversDirectory))
            {
                _storageBusy = true;
                _storageDialogOpen = true;
                StateHasChanged();

                _storageScan = await StorageService.ScanStorageAsync(new StorageScanRequest(modsDirectory, serversDirectory));
                _storageActions.Clear();
                foreach (var candidate in _storageScan.Servers.Concat(_storageScan.Mods))
                    _storageActions[StorageCandidateKey(candidate)] = DefaultStorageAction(candidate);

                _storageBusy = false;
                StateHasChanged();
                return;
            }

            settings.ParallelDownloads = Math.Clamp(_parallelDownloads, 1, 64);
            settings.ParallelModDownloads = Math.Clamp(_parallelModDownloads, 1, 16);
            await SettingsService.UpdateSettingsAsync(settings);

            _modsDirectory = settings.ModsDirectory;
            _serversDirectory = settings.ServersDirectory;
            Snackbar.Add("Settings saved", Severity.Success);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or ArgumentException or NotSupportedException)
        {
            Snackbar.Add($"Storage path update failed: {OutputSanitizer.SanitizeException(ex)}", Severity.Error);
        }
    }

    private async Task ApplyStorageChanges()
    {
        if (_storageScan is null)
            return;

        _storageBusy = true;
        StateHasChanged();

        try
        {
            if (_migrateStorage)
            {
                var migrated = await StorageService.MigrateStorageAsync(
                    new StorageMigrationRequest(_storageScan.ProposedModsDirectory, _storageScan.ProposedServersDirectory));
                Snackbar.Add(
                    $"Migrated {migrated.ServersMigrated} server(s) and {migrated.ModsMigrated} mod(s). {migrated.Skipped.Count} skipped.",
                    migrated.Skipped.Count == 0 ? Severity.Success : Severity.Warning);
            }
            else
            {
                var selections = _storageScan.Servers.Concat(_storageScan.Mods)
                    .Select(candidate => new StorageResolutionSelection(
                        candidate.Kind,
                        candidate.Path,
                        GetStorageAction(candidate),
                        candidate.ExistingId))
                    .ToList();

                var applied = await StorageService.ApplyStorageChangesAsync(new StorageApplyRequest(
                    _storageScan.ProposedModsDirectory,
                    _storageScan.ProposedServersDirectory,
                    selections));
                Snackbar.Add(
                    $"Storage saved. Adopted {applied.ServersAdopted + applied.ModsAdopted} item(s), switched {applied.ServersSwitched + applied.ModsSwitched} path(s).",
                    Severity.Success);
            }

            var settings = await SettingsService.GetSettingsAsync();
            settings.ParallelDownloads = Math.Clamp(_parallelDownloads, 1, 64);
            settings.ParallelModDownloads = Math.Clamp(_parallelModDownloads, 1, 16);
            await SettingsService.UpdateSettingsAsync(settings);
            _modsDirectory = settings.ModsDirectory;
            _serversDirectory = settings.ServersDirectory;
            _storageDialogOpen = false;
            _storageScan = null;
            _storageActions.Clear();
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or ArgumentException or NotSupportedException or InvalidOperationException)
        {
            Snackbar.Add($"Storage update failed: {OutputSanitizer.SanitizeException(ex)}", Severity.Error);
        }
        finally
        {
            _storageBusy = false;
            StateHasChanged();
        }
    }

    private string ResolveStoragePath(string path)
    {
        var expanded = Environment.ExpandEnvironmentVariables(path.Trim());
        return Path.GetFullPath(
            Path.IsPathRooted(expanded)
                ? expanded
                : Path.Combine(HostEnvironment.ContentRootPath, expanded));
    }

    private static bool PathsEqual(string left, string right)
        => string.Equals(
            Path.GetFullPath(left),
            Path.GetFullPath(right),
            OperatingSystem.IsWindows() ? StringComparison.OrdinalIgnoreCase : StringComparison.Ordinal);

    private StorageResolutionAction GetStorageAction(StorageScanCandidate candidate)
        => _storageActions.TryGetValue(StorageCandidateKey(candidate), out var action)
            ? action
            : DefaultStorageAction(candidate);

    private void SetStorageAction(StorageScanCandidate candidate, StorageResolutionAction action)
        => _storageActions[StorageCandidateKey(candidate)] = action;

    private static string StorageCandidateKey(StorageScanCandidate candidate)
        => $"{candidate.Kind}:{candidate.Path}";

    private static StorageResolutionAction DefaultStorageAction(StorageScanCandidate candidate)
        => candidate.Status switch
        {
            StorageCandidateStatus.New => StorageResolutionAction.Skip,
            StorageCandidateStatus.IdenticalDuplicate => StorageResolutionAction.KeepCurrent,
            StorageCandidateStatus.SameNameDifferentData => StorageResolutionAction.KeepCurrent,
            _ => StorageResolutionAction.Skip
        };

    private static IEnumerable<StorageResolutionAction> GetStorageActions(StorageScanCandidate candidate)
        => candidate.Status switch
        {
            StorageCandidateStatus.New =>
                [StorageResolutionAction.Skip, StorageResolutionAction.AdoptDiscovered],
            StorageCandidateStatus.IdenticalDuplicate =>
                [StorageResolutionAction.KeepCurrent, StorageResolutionAction.UseDiscovered],
            StorageCandidateStatus.SameNameDifferentData =>
                [StorageResolutionAction.KeepCurrent, StorageResolutionAction.UseDiscovered, StorageResolutionAction.AdoptDiscovered, StorageResolutionAction.Skip],
            _ => [StorageResolutionAction.Skip]
        };

    private static string StorageActionText(StorageResolutionAction action)
        => action switch
        {
            StorageResolutionAction.KeepCurrent => "Keep current",
            StorageResolutionAction.UseDiscovered => "Use discovered",
            StorageResolutionAction.AdoptDiscovered => "Adopt",
            _ => "Skip"
        };

    private static string StorageStatusText(StorageCandidateStatus status)
        => status switch
        {
            StorageCandidateStatus.IdenticalDuplicate => "Duplicate",
            StorageCandidateStatus.SameNameDifferentData => "Conflict",
            _ => "New"
        };

    private static Color StorageStatusColor(StorageCandidateStatus status)
        => status switch
        {
            StorageCandidateStatus.IdenticalDuplicate => Color.Info,
            StorageCandidateStatus.SameNameDifferentData => Color.Warning,
            _ => Color.Success
        };

