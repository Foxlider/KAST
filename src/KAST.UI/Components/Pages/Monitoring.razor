@page "/monitoring"
@implements IAsyncDisposable
@inject MonitoringStateService State
@inject IJSRuntime JS

<PageTitle>KAST -- Monitoring</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Monitoring</MudText>

@* ── Host stats ── *@
<MudText Typo="Typo.subtitle1" Class="mb-2">Host</MudText>
<MudGrid Spacing="3" Class="mb-4">
    <MudItem xs="12" sm="4">
        <MudCard Elevation="2">
            <MudCardContent>
                <MudText Typo="Typo.overline" Color="Color.Secondary">CPU</MudText>
                <MudText Typo="Typo.h5">@State.HostMetrics.CpuUsagePercent.ToString("F1")%</MudText>
                <MudProgressLinear Value="@State.HostMetrics.CpuUsagePercent" Min="0" Max="100" Color="Color.Warning" />
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudCard Elevation="2">
            <MudCardContent>
                <MudText Typo="Typo.overline" Color="Color.Secondary">Memory</MudText>
                <MudText Typo="Typo.h5">@State.HostMetrics.MemoryUsagePercent.ToString("F1")%</MudText>
                <MudProgressLinear Value="@State.HostMetrics.MemoryUsagePercent" Min="0" Max="100" Color="Color.Info" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @FormatBytes(State.HostMetrics.UsedMemoryBytes) / @FormatBytes(State.HostMetrics.TotalMemoryBytes)
                </MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudCard Elevation="2">
            <MudCardContent>
                <MudText Typo="Typo.overline" Color="Color.Secondary">Disk</MudText>
                <MudText Typo="Typo.h5">@State.HostMetrics.DiskUsagePercent.ToString("F1")%</MudText>
                <MudProgressLinear Value="@State.HostMetrics.DiskUsagePercent" Min="0" Max="100" Color="Color.Success" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @FormatBytes(State.HostMetrics.UsedDiskBytes) / @FormatBytes(State.HostMetrics.TotalDiskBytes)
                </MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@* ── Host charts ── *@
<MudGrid Spacing="3" Class="mb-6">
    <MudItem xs="12" md="6">
        <MudCard Elevation="1">
            <MudCardContent>
                <MudText Typo="Typo.subtitle2" Class="mb-2">CPU Usage</MudText>
                <div style="position:relative; height:160px;">
                    <canvas id="chart-host-cpu"></canvas>
                </div>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudCard Elevation="1">
            <MudCardContent>
                <MudText Typo="Typo.subtitle2" Class="mb-2">Memory Usage</MudText>
                <div style="position:relative; height:160px;">
                    <canvas id="chart-host-mem"></canvas>
                </div>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@* ── Instances ── *@
<MudText Typo="Typo.subtitle1" Class="mb-2">Instances</MudText>
@if (State.Instances.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Filled">No running instances to monitor.</MudAlert>
}
else
{
    @foreach (var instance in State.Instances)
    {
        var metrics = State.InstanceMetrics.GetValueOrDefault(instance.Id);
        <div class="mb-5">
            <div class="d-flex align-center gap-2 mb-2">
                <MudIcon Icon="@GetStatusIcon(instance.Status)" Color="@GetStatusColor(instance.Status)" />
                <MudText Typo="Typo.subtitle1">@instance.Name</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Port @instance.Port</MudText>
                @if (metrics != null)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                        @metrics.PlayerCount players
                    </MudChip>
                }
            </div>
            <MudGrid Spacing="3">
                <MudItem xs="12" md="6">
                    <MudCard Elevation="1">
                        <MudCardContent>
                            <MudText Typo="Typo.subtitle2" Class="mb-2">CPU</MudText>
                            <div style="position:relative; height:130px;">
                                <canvas id="chart-inst-@(instance.Id)-cpu"></canvas>
                            </div>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudCard Elevation="1">
                        <MudCardContent>
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Memory</MudText>
                            <div style="position:relative; height:130px;">
                                <canvas id="chart-inst-@(instance.Id)-mem"></canvas>
                            </div>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </div>
    }
}

@code {
    private bool _chartsInitialized;

    protected override void OnInitialized()
    {
        State.EnsureStarted();
        State.OnDataChanged += HandleDataChanged;
    }

    private void HandleDataChanged()
    {
        InvokeAsync(async () =>
        {
            StateHasChanged();
            if (_chartsInitialized) await UpdateChartsAsync();
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitChartsAsync();
            _chartsInitialized = true;
        }
    }

    private async Task InitChartsAsync()
    {
        await CreateLineChart("chart-host-cpu", "CPU %", "#ff6b35", 100);
        await CreateLineChart("chart-host-mem", "Memory %", "#4fc3f7", 100);
        foreach (var id in State.Instances.Select(i => i.Id))
        {
            await CreateLineChart($"chart-inst-{id}-cpu", "CPU %", "#ff6b35", 100);
            await CreateLineChart($"chart-inst-{id}-mem", "Memory (MB)", "#4fc3f7", null);
        }
        await UpdateChartsAsync();
    }

    private async Task CreateLineChart(string canvasId, string label, string color, int? maxY)
    {
        var config = new
        {
            type = "line",
            data = new { labels = Array.Empty<string>(), datasets = new[] { new { label, data = Array.Empty<double>(), borderColor = color, backgroundColor = color + "1A", borderWidth = 1.5, pointRadius = 0, fill = true, tension = 0.3 } } },
            options = new
            {
                responsive = true, maintainAspectRatio = false, animation = false,
                interaction = new { intersect = false, mode = "index" },
                plugins = new { legend = new { display = false }, tooltip = new { enabled = true } },
                scales = new
                {
                    x = new { ticks = new { maxTicksLimit = 12, color = "#9e9e9e", font = new { size = 10 } }, grid = new { color = "#333" } },
                    y = new { min = 0, max = maxY, ticks = new { color = "#9e9e9e", font = new { size = 10 } }, grid = new { color = "#333" } }
                }
            }
        };
        await JS.InvokeVoidAsync("kastCharts.create", canvasId, config);
    }

    private async Task UpdateChartsAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("kastCharts.update", "chart-host-cpu", State.HostLabels, new[] { State.HostCpu });
            await JS.InvokeVoidAsync("kastCharts.update", "chart-host-mem", State.HostLabels, new[] { State.HostMem });
            foreach (var id in State.Instances.Select(i => i.Id))
            {
                if (State.InstanceHistory.TryGetValue(id, out var hist))
                {
                    await JS.InvokeVoidAsync("kastCharts.update", $"chart-inst-{id}-cpu", State.HostLabels, new[] { hist.Cpu });
                    await JS.InvokeVoidAsync("kastCharts.update", $"chart-inst-{id}-mem", State.HostLabels, new[] { hist.Mem });
                }
            }
        }
        catch (JSDisconnectedException) { }
    }

    private static Color GetStatusColor(ServerInstanceStatus s) => s switch
    {
        ServerInstanceStatus.Running => Color.Success,
        ServerInstanceStatus.Crashed => Color.Error,
        ServerInstanceStatus.Starting => Color.Warning,
        _ => Color.Default
    };

    private static string GetStatusIcon(ServerInstanceStatus s) => s switch
    {
        ServerInstanceStatus.Running => Icons.Material.Filled.PlayCircle,
        ServerInstanceStatus.Crashed => Icons.Material.Filled.Error,
        _ => Icons.Material.Filled.StopCircle
    };

    private static string FormatBytes(long bytes)
    {
        string[] sizes = ["B", "KB", "MB", "GB", "TB"];
        int order = 0; double size = bytes;
        while (size >= 1024 && order < sizes.Length - 1) { order++; size /= 1024; }
        return $"{size:F1} {sizes[order]}";
    }

    public ValueTask DisposeAsync()
    {
        State.OnDataChanged -= HandleDataChanged;
        return ValueTask.CompletedTask;
    }
}
