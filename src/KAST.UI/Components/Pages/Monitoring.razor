@page "/monitoring"
@using Microsoft.AspNetCore.SignalR.Client
@using System.Text.Json
@implements IAsyncDisposable
@inject IMonitoringService MonitoringService
@inject IServerInstanceService ServerService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>KAST -- Monitoring</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Monitoring</MudText>

@* ── Host stats ── *@
<MudText Typo="Typo.subtitle1" Class="mb-2">Host</MudText>
<MudGrid Spacing="3" Class="mb-4">
    <MudItem xs="12" sm="4">
        <MudCard Elevation="2">
            <MudCardContent>
                <MudText Typo="Typo.overline" Color="Color.Secondary">CPU</MudText>
                <MudText Typo="Typo.h5">@_hostMetrics.CpuUsagePercent.ToString("F1")%</MudText>
                <MudProgressLinear Value="@_hostMetrics.CpuUsagePercent" Min="0" Max="100" Color="Color.Warning" />
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudCard Elevation="2">
            <MudCardContent>
                <MudText Typo="Typo.overline" Color="Color.Secondary">Memory</MudText>
                <MudText Typo="Typo.h5">@_hostMetrics.MemoryUsagePercent.ToString("F1")%</MudText>
                <MudProgressLinear Value="@_hostMetrics.MemoryUsagePercent" Min="0" Max="100" Color="Color.Info" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @FormatBytes(_hostMetrics.UsedMemoryBytes) / @FormatBytes(_hostMetrics.TotalMemoryBytes)
                </MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudCard Elevation="2">
            <MudCardContent>
                <MudText Typo="Typo.overline" Color="Color.Secondary">Disk</MudText>
                <MudText Typo="Typo.h5">@_hostMetrics.DiskUsagePercent.ToString("F1")%</MudText>
                <MudProgressLinear Value="@_hostMetrics.DiskUsagePercent" Min="0" Max="100" Color="Color.Success" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @FormatBytes(_hostMetrics.UsedDiskBytes) / @FormatBytes(_hostMetrics.TotalDiskBytes)
                </MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@* ── Host charts ── *@
<MudGrid Spacing="3" Class="mb-6">
    <MudItem xs="12" md="6">
        <MudCard Elevation="1">
            <MudCardContent>
                <MudText Typo="Typo.subtitle2" Class="mb-2">CPU Usage</MudText>
                <div style="position:relative; height:160px;">
                    <canvas id="chart-host-cpu"></canvas>
                </div>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudCard Elevation="1">
            <MudCardContent>
                <MudText Typo="Typo.subtitle2" Class="mb-2">Memory Usage</MudText>
                <div style="position:relative; height:160px;">
                    <canvas id="chart-host-mem"></canvas>
                </div>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@* ── Instances ── *@
<MudText Typo="Typo.subtitle1" Class="mb-2">Instances</MudText>
@if (_instances.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Filled">No running instances to monitor.</MudAlert>
}
else
{
    @foreach (var instance in _instances)
    {
        var metrics = _instanceMetrics.GetValueOrDefault(instance.Id);
        <div class="mb-5">
            <div class="d-flex align-center gap-2 mb-2">
                <MudIcon Icon="@GetStatusIcon(instance.Status)" Color="@GetStatusColor(instance.Status)" />
                <MudText Typo="Typo.subtitle1">@instance.Name</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Port @instance.Port</MudText>
                @if (metrics != null)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                        @metrics.PlayerCount players
                    </MudChip>
                }
            </div>
            <MudGrid Spacing="3">
                <MudItem xs="12" md="6">
                    <MudCard Elevation="1">
                        <MudCardContent>
                            <MudText Typo="Typo.subtitle2" Class="mb-2">CPU</MudText>
                            <div style="position:relative; height:130px;">
                                <canvas id="chart-inst-@(instance.Id)-cpu"></canvas>
                            </div>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudCard Elevation="1">
                        <MudCardContent>
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Memory</MudText>
                            <div style="position:relative; height:130px;">
                                <canvas id="chart-inst-@(instance.Id)-mem"></canvas>
                            </div>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </div>
    }
}

@code {
    private HostMetrics _hostMetrics = new();
    private IReadOnlyList<ServerInstance> _instances = [];
    private Dictionary<int, InstanceMetrics> _instanceMetrics = new();
    private HubConnection? _hubConnection;
    private CancellationTokenSource? _cts;
    private Task? _refreshTask;
    private bool _disposed;
    private bool _chartsInitialized;

    private const int MaxPoints = 1_440;
    private readonly List<string> _hostLabels = new(MaxPoints);
    private readonly List<double> _hostCpu = new(MaxPoints);
    private readonly List<double> _hostMem = new(MaxPoints);
    private readonly Dictionary<int, (List<double> Cpu, List<double> Mem)> _instanceHistory = new();

    protected override async Task OnInitializedAsync()
    {
        await RefreshData();
        PushHostSample();

        _cts = new CancellationTokenSource();
        _refreshTask = RunPeriodicRefresh(_cts.Token);

        _hubConnection = new HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri("/hubs/monitoring"))
            .WithAutomaticReconnect()
            .Build();

        try { await _hubConnection.StartAsync(); await _hubConnection.InvokeAsync("SubscribeToHost"); }
        catch { /* SignalR unavailable */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) { await InitChartsAsync(); _chartsInitialized = true; }
    }

    private async Task RunPeriodicRefresh(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                if (_disposed || ct.IsCancellationRequested) break;
                await InvokeAsync(async () =>
                {
                    if (_disposed || ct.IsCancellationRequested) return;
                    await RefreshData(ct);
                    if (_disposed || ct.IsCancellationRequested) return;
                    PushHostSample(); PushInstanceSamples();
                    StateHasChanged();
                    if (_chartsInitialized) await UpdateChartsAsync();
                });
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) { }
    }

    private async Task RefreshData(CancellationToken ct = default)
    {
        if (_disposed || ct.IsCancellationRequested) return;
        try
        {
            _hostMetrics = await MonitoringService.GetHostMetricsAsync(ct);
            var all = await ServerService.GetAllInstancesAsync(ct);
            _instances = all.Where(s => s.Status != ServerInstanceStatus.Stopped).ToList();
            var allMetrics = await MonitoringService.GetAllInstanceMetricsAsync(ct);
            _instanceMetrics = allMetrics.ToDictionary(m => m.ServerInstanceId);
        }
        catch (ObjectDisposedException) { }
        catch (OperationCanceledException) { }
        catch { }
    }

    private void PushHostSample()
    {
        var label = DateTime.Now.ToString("HH:mm:ss");
        if (_hostLabels.Count >= MaxPoints) { _hostLabels.RemoveAt(0); _hostCpu.RemoveAt(0); _hostMem.RemoveAt(0); }
        _hostLabels.Add(label);
        _hostCpu.Add(Math.Round(_hostMetrics.CpuUsagePercent, 1));
        _hostMem.Add(Math.Round(_hostMetrics.MemoryUsagePercent, 1));
    }

    private void PushInstanceSamples()
    {
        foreach (var (id, metrics) in _instanceMetrics)
        {
            if (!_instanceHistory.TryGetValue(id, out var hist))
            { hist = (new List<double>(MaxPoints), new List<double>(MaxPoints)); _instanceHistory[id] = hist; }
            if (hist.Cpu.Count >= MaxPoints) { hist.Cpu.RemoveAt(0); hist.Mem.RemoveAt(0); }
            hist.Cpu.Add(Math.Round(metrics.CpuUsagePercent, 1));
            hist.Mem.Add(Math.Round(metrics.MemoryUsageBytes / 1_048_576.0, 1));
        }
    }

    private async Task InitChartsAsync()
    {
        await CreateLineChart("chart-host-cpu", "CPU %", "#ff6b35", 100);
        await CreateLineChart("chart-host-mem", "Memory %", "#4fc3f7", 100);
        foreach (var id in _instances.Select(i => i.Id))
        {
            await CreateLineChart($"chart-inst-{id}-cpu", "CPU %", "#ff6b35", 100);
            await CreateLineChart($"chart-inst-{id}-mem", "Memory (MB)", "#4fc3f7", null);
        }
        await UpdateChartsAsync();
    }

    private async Task CreateLineChart(string canvasId, string label, string color, int? maxY)
    {
        var config = new
        {
            type = "line",
            data = new { labels = Array.Empty<string>(), datasets = new[] { new { label, data = Array.Empty<double>(), borderColor = color, backgroundColor = color + "1A", borderWidth = 1.5, pointRadius = 0, fill = true, tension = 0.3 } } },
            options = new
            {
                responsive = true, maintainAspectRatio = false, animation = false,
                interaction = new { intersect = false, mode = "index" },
                plugins = new { legend = new { display = false }, tooltip = new { enabled = true } },
                scales = new
                {
                    x = new { ticks = new { maxTicksLimit = 12, color = "#9e9e9e", font = new { size = 10 } }, grid = new { color = "#333" } },
                    y = new { min = 0, max = maxY, ticks = new { color = "#9e9e9e", font = new { size = 10 } }, grid = new { color = "#333" } }
                }
            }
        };
        await JS.InvokeVoidAsync("kastCharts.create", canvasId, JsonSerializer.Deserialize<object>(JsonSerializer.Serialize(config)));
    }

    private async Task UpdateChartsAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("kastCharts.update", "chart-host-cpu", _hostLabels, new[] { _hostCpu });
            await JS.InvokeVoidAsync("kastCharts.update", "chart-host-mem", _hostLabels, new[] { _hostMem });
            foreach (var id in _instances.Select(i => i.Id))
            {
                if (_instanceHistory.TryGetValue(id, out var hist))
                {
                    await JS.InvokeVoidAsync("kastCharts.update", $"chart-inst-{id}-cpu", _hostLabels, new[] { hist.Cpu });
                    await JS.InvokeVoidAsync("kastCharts.update", $"chart-inst-{id}-mem", _hostLabels, new[] { hist.Mem });
                }
            }
        }
        catch (JSDisconnectedException) { }
    }

    private static Color GetStatusColor(ServerInstanceStatus s) => s switch
    {
        ServerInstanceStatus.Running => Color.Success,
        ServerInstanceStatus.Crashed => Color.Error,
        ServerInstanceStatus.Starting => Color.Warning,
        _ => Color.Default
    };

    private static string GetStatusIcon(ServerInstanceStatus s) => s switch
    {
        ServerInstanceStatus.Running => Icons.Material.Filled.PlayCircle,
        ServerInstanceStatus.Crashed => Icons.Material.Filled.Error,
        _ => Icons.Material.Filled.StopCircle
    };

    private static string FormatBytes(long bytes)
    {
        string[] sizes = ["B", "KB", "MB", "GB", "TB"];
        int order = 0; double size = bytes;
        while (size >= 1024 && order < sizes.Length - 1) { order++; size /= 1024; }
        return $"{size:F1} {sizes[order]}";
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _cts?.Cancel();
        if (_refreshTask is not null) { try { await _refreshTask; } catch { } }
        if (_hubConnection is not null) await _hubConnection.DisposeAsync();
    }
}
