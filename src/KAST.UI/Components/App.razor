<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["KAST.UI.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="icon" type="image/ico" href="favicon.ico" />
    <HeadOutlet @rendermode="InteractiveServer" />
    <style id="ks">
      #kast-splash {
        position:fixed;inset:0;z-index:10000;
        background:radial-gradient(ellipse at 50% 55%, #1c1628 0%, #0a0912 70%);
        display:flex;flex-direction:column;align-items:center;justify-content:center;
        transition:opacity .55s cubic-bezier(.4,0,1,1);
      }
      #kast-splash.ks-out { opacity:0; pointer-events:none; }
      .ks-forge { position:relative; width:190px; height:168px; margin-bottom:14px; }
      .ks-spark {
        position:absolute; border-radius:50%;
        width:var(--s,4px); height:var(--s,4px); background:var(--c,#ffaa44);
        animation:ks-rise var(--d,1.3s) ease-in var(--t,0s) infinite;
      }
      @@keyframes ks-rise {
        0%   { opacity:1; transform:translate(0,0) scale(1); }
        60%  { opacity:.8; }
        100% { opacity:0; transform:translate(var(--x,0px),-80px) scale(.2); }
      }

      .ks-word {
        position:absolute;
        left:8px;
        top:18px;
        display:flex;
        align-items:center;
        transform-origin:28px 56px;
      }

      .ks-k-wrap {
        width:86px;
        height:86px;
        position:relative;
        transform:rotate(-88deg);
        transform-origin:50% 50%;
        transition:transform .52s cubic-bezier(.2,.7,.2,1);
      }

      .ks-k-base,
      .ks-k-fill {
        position:absolute;
        inset:0;
        width:100%;
        height:100%;
        object-fit:contain;
        filter:drop-shadow(0 0 10px rgba(255,120,0,.45));
      }

      .ks-k-base {
        opacity:.28;
        filter:grayscale(.2) brightness(.62) drop-shadow(0 0 4px rgba(255,90,0,.25));
      }

      .ks-k-fill {
        clip-path:inset(0 100% 0 0);
        animation:ks-fill 1s linear forwards;
      }

      @@keyframes ks-fill {
        from { clip-path:inset(0 100% 0 0); }
        to   { clip-path:inset(0 0 0 0); }
      }

      .ks-ast {
        margin-left:-4px;
        font-family:'Roboto',sans-serif;
        font-size:54px;
        font-weight:900;
        letter-spacing:.16em;
        line-height:1;
        color:#f3c27a;
        text-shadow:0 0 10px rgba(255,140,0,.35), 0 0 26px rgba(255,100,0,.2);
        transform:translateX(-26px);
        opacity:0;
        transition:transform .42s ease, opacity .36s ease;
      }

      #kast-splash.ks-ready .ks-k-wrap {
        transform:rotate(0deg);
      }

      #kast-splash.ks-ready .ks-ast {
        transform:translateX(0);
        opacity:1;
      }

      .ks-forge::after {
        content:'';
        position:absolute;
        left:16px;
        right:10px;
        bottom:18px;
        height:24px;
        border-radius:20px;
        background:radial-gradient(ellipse at 50% 50%, rgba(255,116,20,.28), rgba(255,116,20,0));
        filter:blur(6px);
        pointer-events:none;
      }

      .ks-tagline {
        font-family:'Roboto',sans-serif;
        font-size:11px; letter-spacing:.28em; text-transform:uppercase;
        color:rgba(255,255,255,.22); margin-top:4px; margin-bottom:28px;
      }
      .ks-dots { display:flex; gap:10px; }
      .ks-dot  { width:7px; height:7px; border-radius:50%; animation:ks-pulse 1.4s ease-in-out infinite; }
      .ks-dot:nth-child(1) { background:#c06010; animation-delay:0s;  }
      .ks-dot:nth-child(2) { background:#ff8c2a; animation-delay:.2s; }
      .ks-dot:nth-child(3) { background:#ffcc60; animation-delay:.4s; }
      @@keyframes ks-pulse {
        0%,80%,100% { transform:scale(.45); opacity:.25; }
        40%         { transform:scale(1.15); opacity:1; }
      }
    </style>
</head>

<body>
    <div id="kast-splash" aria-hidden="true">
      <div class="ks-forge">
        <!-- Sparks: lower arm tip -->
        <div class="ks-spark" style="left:124px;top:112px;--x:14px;--d:1.1s;--t:.00s;--c:#ffaa44"></div>
        <div class="ks-spark" style="left:137px;top:104px;--x:10px;--d:1.4s;--t:.28s;--s:5px;--c:#ffcc44"></div>
        <div class="ks-spark" style="left:130px;top:124px;--x:17px;--d:1.0s;--t:.55s;--s:3px;--c:#ff8800"></div>
        <div class="ks-spark" style="left:116px;top:116px;--x:-8px;--d:1.3s;--t:.82s;--c:#ff6600"></div>
        <div class="ks-spark" style="left:143px;top:111px;--x:20px;--d:1.5s;--t:.16s;--s:3px;--c:#ffaa44"></div>
        <!-- Sparks: upper arm tip -->
        <div class="ks-spark" style="left:128px;top:28px;--x:11px;--d:1.2s;--t:.44s;--s:3px;--c:#ffe080"></div>
        <div class="ks-spark" style="left:138px;top:20px;--x:-6px;--d:1.0s;--t:.72s;--s:4px;--c:#ffcc44"></div>

        <div class="ks-word">
          <div class="ks-k-wrap">
            <img class="ks-k-base" src="favicon.svg" alt="" draggable="false" />
            <img class="ks-k-fill" src="favicon.svg" alt="" draggable="false" />
          </div>
          <div class="ks-ast">AST</div>
        </div>
      </div>

      <div class="ks-tagline">Keelah's Arma Server Tool</div>
      <div class="ks-dots">
        <div class="ks-dot"></div>
        <div class="ks-dot"></div>
        <div class="ks-dot"></div>
      </div>
    </div>

    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
    <script>
        window.KAST = {
            scrollToBottom: function (el) {
                if (el) el.scrollTop = el.scrollHeight;
            }
        };

        // ── Dismiss loading splash once Blazor circuit is ready ──
        (function () {
            var splashStartedAt = performance.now();
            var minDurationMs = 1000;

            function hideSplash() {
                var s = document.getElementById('kast-splash');
                if (!s || s.classList.contains('ks-out')) return;
                s.classList.add('ks-out');
                setTimeout(function () { if (s.parentNode) s.parentNode.removeChild(s); }, 620);
            }

            function finishSequence() {
                var s = document.getElementById('kast-splash');
                if (!s || s.classList.contains('ks-out')) return;
                s.classList.add('ks-ready');
                setTimeout(hideSplash, 620);
            }

            document.addEventListener('blazor:afterstart', function onReady() {
                document.removeEventListener('blazor:afterstart', onReady);
                var elapsed = performance.now() - splashStartedAt;
                var wait = Math.max(0, minDurationMs - elapsed);
                setTimeout(finishSequence, wait);
            });

            // safety fallback if startup event never arrives
            setTimeout(finishSequence, 4000);
        })();

        window._kastChartInstances = {};

        window.kastCharts = {
            create: function (id, config) {
                var ctx = document.getElementById(id);
                if (!ctx) return;
                if (window._kastChartInstances[id]) window._kastChartInstances[id].destroy();
                window._kastChartInstances[id] = new Chart(ctx, config);
            },
            update: function (id, labels, dataArrays) {
                var chart = window._kastChartInstances[id];
                if (!chart) return;
                chart.data.labels = labels;
                for (var i = 0; i < dataArrays.length; i++) {
                    if (chart.data.datasets[i]) {
                        chart.data.datasets[i].data = dataArrays[i];
                    }
                }
                chart.update('none');
            },
            destroy: function (id) {
                if (window._kastChartInstances[id]) {
                    window._kastChartInstances[id].destroy();
                    delete window._kastChartInstances[id];
                }
            }
        };
    </script>
</body>

</html>
