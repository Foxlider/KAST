@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using System.Security.Cryptography
@inject ProtectedLocalStorage Storage

@if (_visible)
{
    <div id="kast-splash" aria-hidden="true" class="@_cssClass">
      <div class="ks-forge">
        <div class="ks-spark" style="left:124px;top:112px;--x:14px;--d:1.1s;--t:.00s;--c:#ffaa44"></div>
        <div class="ks-spark" style="left:137px;top:104px;--x:10px;--d:1.4s;--t:.28s;--s:5px;--c:#ffcc44"></div>
        <div class="ks-spark" style="left:130px;top:124px;--x:17px;--d:1.0s;--t:.55s;--s:3px;--c:#ff8800"></div>
        <div class="ks-spark" style="left:116px;top:116px;--x:-8px;--d:1.3s;--t:.82s;--c:#ff6600"></div>
        <div class="ks-spark" style="left:143px;top:111px;--x:20px;--d:1.5s;--t:.16s;--s:3px;--c:#ffaa44"></div>
        <div class="ks-spark" style="left:128px;top:28px;--x:11px;--d:1.2s;--t:.44s;--s:3px;--c:#ffe080"></div>
        <div class="ks-spark" style="left:138px;top:20px;--x:-6px;--d:1.0s;--t:.72s;--s:4px;--c:#ffcc44"></div>

        <div class="ks-word">
          <div class="ks-k-wrap">
            <img class="ks-k-base" src="favicon.svg" alt="" draggable="false" />
            <img class="ks-k-fill" src="favicon.svg" alt="" draggable="false" />
          </div>
          <div class="ks-ast">AST</div>
        </div>
      </div>

      <div class="ks-tagline">Keelah's Arma Server Tool</div>
      <div class="ks-dots">
        <div class="ks-dot"></div>
        <div class="ks-dot"></div>
        <div class="ks-dot"></div>
      </div>
    </div>
}

@code {
    private const string TimestampKey = "kast_splash_timestamp";
    private static readonly TimeSpan SuppressWindow = TimeSpan.FromSeconds(10);

    private bool _visible = true;
    private string _cssClass = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Check whether the splash was already shown recently (e.g. during a
        // SignalR reconnect that created a fresh circuit).  If the stored
        // timestamp is within the suppression window we hide the splash
        // immediately so the user doesn't sit through the full animation again.
        var skipAnimation = false;
        try
        {
            var result = await Storage.GetAsync<string>(TimestampKey);
            if (result.Success
                && !string.IsNullOrEmpty(result.Value)
                && DateTime.TryParse(result.Value, null, System.Globalization.DateTimeStyles.RoundtripKind, out var ts))
            {
                skipAnimation = DateTime.UtcNow - ts < SuppressWindow;
            }
        }
        catch (InvalidOperationException)
        {
            // Storage may be unavailable during pre-rendering; default to
            // playing the animation (safe fallback).
            skipAnimation = false;
        }
        catch (Microsoft.JSInterop.JSException)
        {
            skipAnimation = false;
        }
        catch (CryptographicException)
        {
            await TryDeleteTimestampAsync();
            skipAnimation = false;
        }

        if (skipAnimation)
        {
            _visible = false;
            StateHasChanged();
            return;
        }

        // Persist the current timestamp before starting the animation so that
        // a quick reconnect that follows will see a recent value and skip.
        try
        {
            await Storage.SetAsync(TimestampKey, DateTime.UtcNow.ToString("O"));
        }
        catch (InvalidOperationException)
        {
            // Non-critical — worst case the animation replays on reconnect.
        }
        catch (Microsoft.JSInterop.JSException)
        {
            // Non-critical - worst case the animation replays on reconnect.
        }
        catch (CryptographicException)
        {
            await TryDeleteTimestampAsync();
        }

        // ── Original animation sequence (unchanged) ─────────────────────────
        await Task.Delay(1000);

        _cssClass = "ks-ready";
        StateHasChanged();

        await Task.Delay(620);

        _cssClass = "ks-ready ks-out";
        StateHasChanged();

        await Task.Delay(620);

        _visible = false;
        StateHasChanged();
    }

    private async Task TryDeleteTimestampAsync()
    {
        try
        {
            await Storage.DeleteAsync(TimestampKey);
        }
        catch (InvalidOperationException) { }
        catch (Microsoft.JSInterop.JSException) { }
        catch (CryptographicException) { }
    }
}
