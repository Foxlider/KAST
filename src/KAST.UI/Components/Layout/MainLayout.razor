@inherits LayoutComponentBase
@implements IDisposable

@inject ThemeService ThemeService
@inject NavigationManager NavigationManager
@inject KeyboardShortcutService KeyboardShortcuts

<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@DrawerToggle" />
        <MudText Typo="Typo.h6" Class="ml-2 kast-title" Style="@($"letter-spacing:.08em; font-weight:700; color: {ThemeService.AccentColor};")">
            KAST
        </MudText>
        <MudText Typo="Typo.caption" Class="ml-1 mud-text-secondary" Style="opacity:.5">
            Keelah's Arma Server Tool
        </MudText>
        <MudMenu>
            <ActivatorContent>
                <MudIconButton Icon="@Icons.Material.Filled.FlashOn" Color="Color.Inherit" aria-label="Quick Actions" />
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem OnClick="@(() => NavigationManager.NavigateTo("/servers/new"))" Icon="@Icons.Material.Filled.Add">New Server Instance</MudMenuItem>
                <MudMenuItem OnClick="@(() => NavigationManager.NavigateTo("/mods"))" Icon="@Icons.Material.Filled.Extension">Add Workshop Mod</MudMenuItem>
                <MudMenuItem OnClick="@(() => NavigationManager.NavigateTo("/mods"))" Icon="@Icons.Material.Filled.Refresh">Check for Updates</MudMenuItem>
                <MudMenuItem OnClick="@(() => NavigationManager.NavigateTo("/servers"))" Icon="@Icons.Material.Filled.Storage">Server List</MudMenuItem>
            </ChildContent>
        </MudMenu>
        <MudSpacer />
        <SteamAccountWidget />
        <AccountWidget />
        <MudIconButton Icon="@(DarkLightModeButtonIcon)" Color="Color.Inherit" OnClick="@DarkModeToggle" aria-label="Toggle dark mode" />
    </MudAppBar>
    <MudDrawer id="nav-drawer" @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2"
               Breakpoint="Breakpoint.Md">
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="pt-16 pb-10 pa-4">
        <MudBreadcrumbs Items="@_breadcrumbItems" Class="mb-4" />
        @Body
    </MudMainContent>
    <FooterBar />
    </MudLayout>

    @* ── Keyboard Shortcuts Help Overlay ── *@
    @if (_showShortcutsHelp)
    {
        <MudOverlay Visible="true" OnClick="@(() => _showShortcutsHelp = false)" DarkBackground="true" ZIndex="2000">
            <MudPaper Class="pa-6" Style="max-width:420px; margin:12vh auto;" Elevation="25">
                <MudText Typo="Typo.h5" Class="mb-4" Style="font-weight:700;">
                    <MudIcon Icon="@Icons.Material.Filled.Keyboard" Size="Size.Small" Class="mr-2" />Keyboard Shortcuts
                </MudText>
                <MudDivider Class="mb-3" />
                <div style="display:flex; flex-direction:column; gap:8px;">
                    <div class="d-flex align-center" style="gap:12px;">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Style="font-family:monospace; min-width:100px; text-align:center;">Ctrl+Shift+L</MudChip>
                        <MudText Typo="Typo.body2">Toggle log console</MudText>
                    </div>
                    <div class="d-flex align-center" style="gap:12px;">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Style="font-family:monospace; min-width:100px; text-align:center;">?</MudChip>
                        <MudText Typo="Typo.body2">Show this help</MudText>
                    </div>
                </div>
                <MudDivider Class="my-3" />
                <div class="d-flex" style="justify-content:flex-end;">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => _showShortcutsHelp = false)">Close</MudButton>
                </div>
            </MudPaper>
        </MudOverlay>
    }

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = true;
    private MudTheme? _theme = null;
    private List<BreadcrumbItem> _breadcrumbItems = new();

    private bool _showShortcutsHelp;
    private bool _keyboardShortcutsInitialized;

    private Action? _themeChangeHandler;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await ThemeService.InitializeAsync();

        _isDarkMode = ThemeService.IsDarkMode;
        _lightPalette.Secondary = ThemeService.AccentColor;
        _darkPalette.Secondary  = ThemeService.AccentColor;

        _theme = new()
        {
            PaletteLight     = _lightPalette,
            PaletteDark      = _darkPalette,
            LayoutProperties = new LayoutProperties { DefaultBorderRadius = "4px" },
        };

        _themeChangeHandler = () =>
        {
            _isDarkMode                  = ThemeService.IsDarkMode;
            _lightPalette.Secondary      = ThemeService.AccentColor;
            _darkPalette.Secondary       = ThemeService.AccentColor;
            InvokeAsync(StateHasChanged);
        };
        ThemeService.OnChange += _themeChangeHandler;

        BuildBreadcrumbs(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _keyboardShortcutsInitialized)
            return;

        _keyboardShortcutsInitialized = true;
        await KeyboardShortcuts.InitializeAsync();
        KeyboardShortcuts.Register("ctrl+shift+l", async () =>
        {
            // The FooterBar owns the log toggle; this shortcut is handled
            // by the service.  Handlers from different components overlay
            // the same key-combo, so place component-specific toggles where
            // they live.  For now this serves as a placeholder for
            // centrally-triggered actions.
        });
        KeyboardShortcuts.Register("?", async () =>
        {
            _showShortcutsHelp = true;
            await InvokeAsync(StateHasChanged);
        });
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        BuildBreadcrumbs(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private void BuildBreadcrumbs(string uri)
    {
        _breadcrumbItems.Clear();

        var relativePath = NavigationManager.ToBaseRelativePath(uri);

        // Always start with Dashboard as the root
        _breadcrumbItems.Add(new BreadcrumbItem("Dashboard", href: "/"));

        if (string.IsNullOrEmpty(relativePath))
            return;

        var segments = relativePath.Trim('/').Split('/');

        switch (segments[0].ToLowerInvariant())
        {
            case "servers":
                _breadcrumbItems.Add(new BreadcrumbItem("Servers", href: "/servers"));

                if (segments.Length > 1)
                {
                    if (segments[1].Equals("new", StringComparison.OrdinalIgnoreCase))
                    {
                        _breadcrumbItems.Add(new BreadcrumbItem("New Instance", href: "/servers/new"));
                    }
                    else
                    {
                        _breadcrumbItems.Add(new BreadcrumbItem($"Instance {segments[1]}", href: $"/servers/{segments[1]}"));
                    }
                }
                break;

            case "mods":
                _breadcrumbItems.Add(new BreadcrumbItem("Mods", href: "/mods"));
                break;

            case "monitoring":
                _breadcrumbItems.Add(new BreadcrumbItem("Monitoring", href: "/monitoring"));
                break;

            case "settings":
                _breadcrumbItems.Add(new BreadcrumbItem("Settings", href: "/settings"));
                break;

            case "about":
                _breadcrumbItems.Add(new BreadcrumbItem("About", href: "/about"));
                break;

            default:
                // Unknown route — show the segment as-is
                _breadcrumbItems.Add(new BreadcrumbItem(segments[0], href: $"/{segments[0]}"));
                break;
        }
    }

    private void DrawerToggle() => _drawerOpen = !_drawerOpen;

    private async Task DarkModeToggle()
    {
        await ThemeService.SetDarkModeAsync(!_isDarkMode);
    }

    public void Dispose()
    {
        if (_themeChangeHandler != null)
            ThemeService.OnChange -= _themeChangeHandler;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    // ── Light palette — Material Design 700/600 tones ───────────────────────
    private readonly PaletteLight _lightPalette = new()
    {
        Primary               = "#1976D2",  // Blue 700
        PrimaryContrastText   = "#FFFFFF",
        Secondary             = "#FF7043",  // Deep Orange 400 — overridden by ThemeService
        SecondaryContrastText = "#FFFFFF",
        Tertiary              = "#00897B",  // Teal 600
        TertiaryContrastText  = "#FFFFFF",
        Info                  = "#0288D1",  // Light Blue 700
        InfoContrastText      = "#FFFFFF",
        Success               = "#388E3C",  // Green 700
        SuccessContrastText   = "#FFFFFF",
        Warning               = "#F57C00",  // Orange 700
        WarningContrastText   = "#FFFFFF",
        Error                 = "#D32F2F",  // Red 700
        ErrorContrastText     = "#FFFFFF",
        Background            = "#FAFAFA",  // Grey 50
        BackgroundGray        = "#F5F5F5",  // Grey 100
        Surface               = "#FFFFFF",
        AppbarBackground      = "rgba(255,255,255,0.92)",
        AppbarText            = "#212121",  // Grey 900
        DrawerBackground      = "#FAFAFA",
        DrawerText            = "#212121",
        DrawerIcon            = "#616161",  // Grey 700
        Black                 = "#212121",
        GrayLight             = "#E0E0E0",  // Grey 300
        GrayLighter           = "#F5F5F5",  // Grey 100
    };

    // ── Dark palette — Material Design 400 tones on near-black backgrounds ──
    private readonly PaletteDark _darkPalette = new()
    {
        Primary               = "#42A5F5",  // Blue 400
        PrimaryContrastText   = "#000000",
        Secondary             = "#FF7043",  // Deep Orange 400 — overridden by ThemeService
        SecondaryContrastText = "#000000",
        Tertiary              = "#4DB6AC",  // Teal 300
        TertiaryContrastText  = "#000000",
        Info                  = "#29B6F6",  // Light Blue 400
        InfoContrastText      = "#000000",
        Success               = "#66BB6A",  // Green 400
        SuccessContrastText   = "#000000",
        Warning               = "#FFA726",  // Orange 400
        WarningContrastText   = "#000000",
        Error                 = "#EF5350",  // Red 400
        ErrorContrastText     = "#FFFFFF",
        Background            = "#121212",  // Material dark spec
        BackgroundGray        = "#1C1C1C",
        Surface               = "#1E1E1E",
        AppbarBackground      = "rgba(18,18,18,0.92)",
        AppbarText            = "#E0E0E0",  // Grey 300
        DrawerBackground      = "#1C1C1C",
        DrawerText            = "#E0E0E0",
        DrawerIcon            = "#9E9E9E",  // Grey 500
        TextPrimary           = "#EEEEEE",  // Grey 200
        TextSecondary         = "#9E9E9E",  // Grey 500
        TextDisabled          = "#FFFFFF33",
        ActionDefault         = "#BDBDBD",  // Grey 400
        ActionDisabled        = "#9999994D",
        ActionDisabledBackground = "#3A3A3A4D",
        LinesDefault          = "#2E2E2E",
        TableLines            = "#2E2E2E",
        Divider               = "#2E2E2E",
        OverlayLight          = "#12121280",
        GrayLight             = "#2E2E2E",
        GrayLighter           = "#242424",
    };

    public string DarkLightModeButtonIcon => _isDarkMode switch
    {
        true  => Icons.Material.Rounded.AutoMode,
        false => Icons.Material.Outlined.DarkMode,
    };
}
