@using Microsoft.AspNetCore.SignalR.Client
@using KAST.Core.Events
@inject IServerInstanceService ServerService
@inject NavigationManager Nav
@inject KastInternalUrlProvider InternalUrls
@inject ILogger<NavMenu> Logger
@implements IAsyncDisposable

<MudNavMenu>
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
    <MudNavLink Href="/servers" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Storage">Servers</MudNavLink>
    @if (_servers.Count > 0)
    {
        <div class="kast-sub-nav">
            @foreach (var s in _servers)
            {
                <MudNavLink Href="@($"/servers/{s.Id}")" Match="NavLinkMatch.All"
                            Icon="@GetStatusIcon(s.Status)"
                            IconColor="@GetStatusColor(s.Status)">
                    @s.Name
                </MudNavLink>
            }
        </div>
    }
    <MudNavLink Href="mods" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Extension">Mods</MudNavLink>
    <MudNavLink Href="monitoring" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.BarChart"
                IconColor="@(_monitoringUnavailable ? Color.Warning : Color.Default)">Monitoring</MudNavLink>
    @if (_monitoringUnavailable)
    {
        <MudText Typo="Typo.caption" Color="Color.Warning" Class="px-4">Monitoring unavailable</MudText>
    }
    <MudNavLink Href="settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Settings">Settings</MudNavLink>
    <MudNavLink Href="about" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Info">About</MudNavLink>
</MudNavMenu>

@code {
    private IReadOnlyList<ServerInstance> _servers = [];
    private HubConnection? _hub;
    private bool _monitoringUnavailable;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        Nav.LocationChanged += OnLocationChanged;

        try
        {
            _hub = new HubConnectionBuilder()
                .WithUrl(InternalUrls.GetMonitoringHubUri())
                .WithAutomaticReconnect()
                .Build();

            _hub.Reconnecting += _ =>
            {
                _monitoringUnavailable = true;
                return InvokeAsync(StateHasChanged);
            };

            _hub.Reconnected += _ =>
            {
                _monitoringUnavailable = false;
                return InvokeAsync(StateHasChanged);
            };

            _hub.Closed += error =>
            {
                _monitoringUnavailable = true;
                if (error is not null)
                    Logger.LogWarning(error, "Monitoring SignalR hub connection closed.");
                return InvokeAsync(StateHasChanged);
            };

            _hub.On<ServerStatusChangedEvent>("ServerStatusChanged", async _ =>
            {
                await RefreshAsync();
                await InvokeAsync(StateHasChanged);
            });

            await _hub.StartAsync();
            _monitoringUnavailable = false;
        }
        catch (Exception ex)
        {
            _monitoringUnavailable = true;
            Logger.LogWarning(ex, "Failed to connect to monitoring SignalR hub.");
            if (_hub is not null)
            {
                await _hub.DisposeAsync();
                _hub = null;
            }
        }
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await RefreshAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshAsync()
        => _servers = await ServerService.GetAllInstancesAsync();

    public async ValueTask DisposeAsync()
    {
        Nav.LocationChanged -= OnLocationChanged;
        if (_hub is not null) await _hub.DisposeAsync();
    }

    private static Color GetStatusColor(ServerInstanceStatus status) => status switch
    {
        ServerInstanceStatus.Running                                      => Color.Success,
        ServerInstanceStatus.Crashed                                      => Color.Error,
        ServerInstanceStatus.Starting or ServerInstanceStatus.Downloading => Color.Warning,
        _                                                                 => Color.Default
    };

    private static string GetStatusIcon(ServerInstanceStatus status) => status switch
    {
        ServerInstanceStatus.Running     => Icons.Material.Filled.PlayCircle,
        ServerInstanceStatus.Crashed     => Icons.Material.Filled.Error,
        ServerInstanceStatus.Starting    => Icons.Material.Filled.HourglassTop,
        ServerInstanceStatus.Downloading => Icons.Material.Filled.Downloading,
        _                                => Icons.Material.Outlined.StopCircle
    };
}
