{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=kast.db"
  },
  "Kast": {
    "ModsDirectory": "./mods",
    "ServersDirectory": "./servers",
    "Arma3AppId": 233780
  },
  "Auth": {
    "Mode": "Local",
    "Oidc": {
      "DisplayName": "OpenID Connect",
      "GroupClaim": "groups",
      "NameClaim": "preferred_username",
      "AllowedGroups": [ "KAST Admins" ]
    }
  },
  "Telemetry": {
    "Enabled": false,
    "OtlpEndpoint": "http://jaeger:4317",
    "ServiceName": "KAST"
  }
}
