@page "/servers/new"
@page "/servers/{Id:int}"
@using KAST.Core.Enums
@using KAST.Core.Interfaces
@using KAST.Core.Models
@using Microsoft.FluentUI.AspNetCore.Components
@implements IDisposable
@inject IServerInstanceService ServerService
@inject IServerConfigService ConfigService
@inject IModService ModService
@inject ISettingsService SettingsService
@inject IToastService ToastService
@inject NavigationManager Nav

<PageTitle>KAST — @(_isNew ? "New Server" : _instance.Name)</PageTitle>

<div style="display: flex; justify-content: space-between; align-items: center;">
    <h1>@(_isNew ? "New Server Instance" : $"Edit: {_instance.Name}")</h1>
    <FluentButton Appearance="Appearance.Accent" OnClick="Save">Save</FluentButton>
</div>

<FluentTabs Style="margin-top: 20px;">

    @* ════════════ GENERAL TAB ════════════ *@
    <FluentTab Label="General">
        <div class="kast-card" style="margin-top: 16px;">
            <FluentGrid Spacing="3">
                <FluentGridItem xs="12" sm="6">
                    <FluentTextField @bind-Value="_instance.Name" @bind-Value:after="OnNameChanged" Label="Instance Name" Style="width: 100%;" />
                </FluentGridItem>
                <FluentGridItem xs="12" sm="6">
                    <FluentTextField @bind-Value="_instance.InstallPath" Label="Install Path" Style="width: 100%;" />
                </FluentGridItem>
                <FluentGridItem xs="6" sm="3">
                    <FluentNumberField @bind-Value="_instance.Port" Label="Game Port" Min="1" Max="65535" />
                </FluentGridItem>
                <FluentGridItem xs="6" sm="3">
                    <FluentNumberField @bind-Value="_instance.SteamQueryPort" Label="Steam Query Port" Min="1" Max="65535" />
                </FluentGridItem>
                <FluentGridItem xs="6" sm="3">
                    <FluentNumberField @bind-Value="_instance.HeadlessClientCount" Label="Headless Clients" Min="0" Max="10" />
                </FluentGridItem>
                <FluentGridItem xs="6" sm="3">
                    <FluentSelect TOption="string" @bind-Value="_restartPolicyStr" Label="Restart Policy">
                        <FluentOption TOption="string" Value="@("None")">None</FluentOption>
                        <FluentOption TOption="string" Value="@("OnCrash")">On Crash</FluentOption>
                        <FluentOption TOption="string" Value="@("Always")">Always</FluentOption>
                    </FluentSelect>
                </FluentGridItem>
            </FluentGrid>
        </div>

        <div class="kast-card" style="margin-top: 16px;">
            <h3>Creator DLC</h3>
            <FluentGrid Spacing="3">
                <FluentGridItem xs="6" sm="3"><FluentSwitch @bind-Value="_instance.ContactDlc" Label="Contact" /></FluentGridItem>
                <FluentGridItem xs="6" sm="3"><FluentSwitch @bind-Value="_instance.GmDlc" Label="Global Mobilization" /></FluentGridItem>
                <FluentGridItem xs="6" sm="3"><FluentSwitch @bind-Value="_instance.PfDlc" Label="Prairie Fire" /></FluentGridItem>
                <FluentGridItem xs="6" sm="3"><FluentSwitch @bind-Value="_instance.CslaDlc" Label="CSLA Iron Curtain" /></FluentGridItem>
                <FluentGridItem xs="6" sm="3"><FluentSwitch @bind-Value="_instance.WsDlc" Label="Western Sahara" /></FluentGridItem>
                <FluentGridItem xs="6" sm="3"><FluentSwitch @bind-Value="_instance.SpeDlc" Label="Spearhead 1944" /></FluentGridItem>
                <FluentGridItem xs="6" sm="3"><FluentSwitch @bind-Value="_instance.RfDlc" Label="Reaction Forces" /></FluentGridItem>
                <FluentGridItem xs="6" sm="3"><FluentSwitch @bind-Value="_instance.EfDlc" Label="Expeditionary Force" /></FluentGridItem>
            </FluentGrid>
        </div>

        <div class="kast-card" style="margin-top: 16px;">
            <h3>Schedule</h3>
            <FluentSwitch @bind-Value="_instance.ScheduleEnabled" Label="Enable Schedule" />
            @if (_instance.ScheduleEnabled)
            {
                <FluentGrid Spacing="3" Style="margin-top: 12px;">
                    <FluentGridItem xs="6">
                        <FluentTextField @bind-Value="_instance.AutoStartTime" Label="Auto-Start Time (HH:mm)" Placeholder="08:00" />
                    </FluentGridItem>
                    <FluentGridItem xs="6">
                        <FluentTextField @bind-Value="_instance.AutoStopTime" Label="Auto-Stop Time (HH:mm)" Placeholder="23:00" />
                    </FluentGridItem>
                </FluentGrid>
            }
        </div>

        <div class="kast-card" style="margin-top: 16px;">
            <h3>Performance</h3>
            <FluentGrid Spacing="3">
                <FluentGridItem xs="6" sm="3">
                    <FluentSwitch @bind-Value="_serverConfig.EnableHT" Label="Enable HT" />
                </FluentGridItem>
                <FluentGridItem xs="6" sm="3">
                    <FluentSwitch @bind-Value="_serverConfig.MaxMemOverride" Label="Override MaxMem" />
                </FluentGridItem>
                @if (_serverConfig.MaxMemOverride)
                {
                    <FluentGridItem xs="6" sm="3">
                        <FluentNumberField @bind-Value="_serverConfig.MaxMem" Label="MaxMem (MB)" Min="512" />
                    </FluentGridItem>
                }
                <FluentGridItem xs="6" sm="3">
                    <FluentSwitch @bind-Value="_serverConfig.CpuCountOverride" Label="Override CPU Count" />
                </FluentGridItem>
                @if (_serverConfig.CpuCountOverride)
                {
                    <FluentGridItem xs="6" sm="3">
                        <FluentNumberField @bind-Value="_serverConfig.CpuCount" Label="CPU Count" Min="1" />
                    </FluentGridItem>
                }
                <FluentGridItem xs="6" sm="3">
                    <FluentSwitch @bind-Value="_serverConfig.EnableRanking" Label="Enable Ranking" />
                </FluentGridItem>
            </FluentGrid>
        </div>

        <div class="kast-card" style="margin-top: 16px;">
            <FluentTextField @bind-Value="_instance.AdditionalParameters"
                            Label="Additional Launch Parameters"
                            Style="width: 100%;"
                            Placeholder="-hugepages" />
        </div>
    </FluentTab>

    @* ════════════ SERVER CONFIG TAB ════════════ *@
    <FluentTab Label="Server Config">
        <div style="margin-top: 16px; display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
            <div style="display: flex; flex-direction: column; gap: 16px;">

                <div class="kast-card">
                    <h3>Server Options</h3>
                    <FluentTextField @bind-Value="_serverConfig.Hostname" @bind-Value:after="OnServerConfigChanged"
                                    Label="Hostname" Style="width: 100%;" />
                    <FluentTextField @bind-Value="_serverConfig.Password" @bind-Value:after="OnServerConfigChanged"
                                    Label="Server Password" Style="width: 100%; margin-top: 8px;" />
                    <FluentTextField @bind-Value="_serverConfig.PasswordAdmin" @bind-Value:after="OnServerConfigChanged"
                                    Label="Admin Password" Style="width: 100%; margin-top: 8px;" />
                    <FluentTextField @bind-Value="_serverConfig.ServerCommandPassword" @bind-Value:after="OnServerConfigChanged"
                                    Label="Server Command Password" Style="width: 100%; margin-top: 8px;" />
                    <FluentNumberField @bind-Value="_serverConfig.MaxPlayers" @bind-Value:after="OnServerConfigChanged"
                                       Label="Max Players" Min="1" Max="128" Style="margin-top: 8px;" />
                    <FluentTextField @bind-Value="_serverConfig.LogFile" @bind-Value:after="OnServerConfigChanged"
                                    Label="Log File" Style="width: 100%; margin-top: 8px;" />
                </div>

                <div class="kast-card">
                    <h3>MOTD &amp; Admins</h3>
                    <FluentTextArea @bind-Value="_serverConfig.Motd" @bind-Value:after="OnServerConfigChanged"
                                   Label="MOTD (one line per entry)" Rows="3" Style="width: 100%;" />
                    <FluentNumberField @bind-Value="_serverConfig.MotdInterval" @bind-Value:after="OnServerConfigChanged"
                                       Label="MOTD Interval (seconds)" Style="margin-top: 8px;" />
                    <FluentTextArea @bind-Value="_serverConfig.Admins" @bind-Value:after="OnServerConfigChanged"
                                   Label="Admin UIDs (one per line)" Rows="3" Style="width: 100%; margin-top: 8px;" />
                </div>

                <div class="kast-card">
                    <h3>Joining Rules</h3>
                    <FluentGrid Spacing="3">
                        <FluentGridItem xs="6">
                            <FluentSwitch @bind-Value="_serverConfig.KickDuplicate" @bind-Value:after="OnServerConfigChanged" Label="Kick Duplicate IDs" />
                        </FluentGridItem>
                        <FluentGridItem xs="6">
                            <FluentSelect TOption="string" Value="@_serverConfig.VerifySignatures.ToString()" ValueChanged="@(v => { _serverConfig.VerifySignatures = int.Parse(v); OnServerConfigChanged(); })" Label="Verify Signatures">
                                <FluentOption TOption="string" Value="0">Disabled</FluentOption>
                                <FluentOption TOption="string" Value="1">Deprecated (v1+v2)</FluentOption>
                                <FluentOption TOption="string" Value="2">Activated (v2 only)</FluentOption>
                            </FluentSelect>
                        </FluentGridItem>
                        <FluentGridItem xs="6">
                            <FluentSelect TOption="string" Value="@_serverConfig.AllowedFilePatching.ToString()" ValueChanged="@(v => { _serverConfig.AllowedFilePatching = int.Parse(v); OnServerConfigChanged(); })" Label="File Patching">
                                <FluentOption TOption="string" Value="0">No Clients</FluentOption>
                                <FluentOption TOption="string" Value="1">HC Only</FluentOption>
                                <FluentOption TOption="string" Value="2">All Clients</FluentOption>
                            </FluentSelect>
                        </FluentGridItem>
                        <FluentGridItem xs="6">
                            <FluentNumberField @bind-Value="_serverConfig.SteamProtocolMaxDataSize" @bind-Value:after="OnServerConfigChanged" Label="Steam Protocol Max Data Size" />
                        </FluentGridItem>
                        <FluentGridItem xs="6">
                            <FluentSwitch @bind-Value="_serverConfig.Loopback" @bind-Value:after="OnServerConfigChanged" Label="LAN Mode (loopback)" />
                        </FluentGridItem>
                        <FluentGridItem xs="6">
                            <FluentSwitch @bind-Value="_serverConfig.Upnp" @bind-Value:after="OnServerConfigChanged" Label="UPnP" />
                        </FluentGridItem>
                    </FluentGrid>
                </div>

                <div class="kast-card">
                    <h3>Voting</h3>
                    <FluentSwitch @bind-Value="_serverConfig.VotingEnabled" @bind-Value:after="OnServerConfigChanged" Label="Voting Enabled" />
                    @if (_serverConfig.VotingEnabled)
                    {
                        <FluentGrid Spacing="3" Style="margin-top: 8px;">
                            <FluentGridItem xs="6">
                                <FluentNumberField @bind-Value="_serverConfig.VoteMissionPlayers" @bind-Value:after="OnServerConfigChanged" Label="Vote Mission Players" Min="1" />
                            </FluentGridItem>
                            <FluentGridItem xs="6">
                                <FluentNumberField @bind-Value="_serverConfig.VoteThreshold" @bind-Value:after="OnServerConfigChanged" Label="Vote Threshold" Step="0.01" />
                            </FluentGridItem>
                        </FluentGrid>
                    }
                    <FluentNumberField @bind-Value="_serverConfig.VotingTimeOut" @bind-Value:after="OnServerConfigChanged" Label="Voting Timeout (s)" Style="margin-top: 8px;" />
                </div>

                <div class="kast-card">
                    <h3>In-game Settings</h3>
                    <FluentGrid Spacing="3">
                        <FluentGridItem xs="6"><FluentSwitch @bind-Value="_serverConfig.BattlEye" @bind-Value:after="OnServerConfigChanged" Label="BattlEye" /></FluentGridItem>
                        <FluentGridItem xs="6"><FluentSwitch @bind-Value="_serverConfig.PersistentBattlefield" @bind-Value:after="OnServerConfigChanged" Label="Persistent" /></FluentGridItem>
                        <FluentGridItem xs="6"><FluentSwitch @bind-Value="_serverConfig.AutoInit" @bind-Value:after="OnServerConfigChanged" Label="Auto Init" /></FluentGridItem>
                        <FluentGridItem xs="6"><FluentSwitch @bind-Value="_serverConfig.SkipLobby" @bind-Value:after="OnServerConfigChanged" Label="Skip Lobby" /></FluentGridItem>
                        <FluentGridItem xs="6"><FluentSwitch @bind-Value="_serverConfig.DrawingInMap" @bind-Value:after="OnServerConfigChanged" Label="Drawing in Map" /></FluentGridItem>
                        <FluentGridItem xs="6">
                            <FluentSelect TOption="string" Value="@_serverConfig.ForcedDifficulty" ValueChanged="@(v => { _serverConfig.ForcedDifficulty = v; OnServerConfigChanged(); })" Label="Forced Difficulty">
                                <FluentOption TOption="string" Value="Recruit">Recruit</FluentOption>
                                <FluentOption TOption="string" Value="Regular">Regular</FluentOption>
                                <FluentOption TOption="string" Value="Veteran">Veteran</FluentOption>
                                <FluentOption TOption="string" Value="Custom">Custom</FluentOption>
                            </FluentSelect>
                        </FluentGridItem>
                        <FluentGridItem xs="6">
                            <FluentSelect TOption="string" Value="@_serverConfig.TimeStampFormat" ValueChanged="@(v => { _serverConfig.TimeStampFormat = v; OnServerConfigChanged(); })" Label="Timestamp Format">
                                <FluentOption TOption="string" Value="none">None</FluentOption>
                                <FluentOption TOption="string" Value="short">Short</FluentOption>
                                <FluentOption TOption="string" Value="full">Full</FluentOption>
                            </FluentSelect>
                        </FluentGridItem>
                    </FluentGrid>
                </div>

                <div class="kast-card">
                    <h3>Voice over Network</h3>
                    <FluentSwitch @bind-Value="_serverConfig.DisableVoN" @bind-Value:after="OnServerConfigChanged" Label="Disable VoN" />
                    @if (!_serverConfig.DisableVoN)
                    {
                        <FluentGrid Spacing="3" Style="margin-top: 8px;">
                            <FluentGridItem xs="6">
                                <FluentSelect TOption="string" Value="@_serverConfig.VonCodec.ToString()" ValueChanged="@(v => { _serverConfig.VonCodec = int.Parse(v); OnServerConfigChanged(); })" Label="VoN Codec">
                                    <FluentOption TOption="string" Value="0">SPEEX</FluentOption>
                                    <FluentOption TOption="string" Value="1">OPUS</FluentOption>
                                </FluentSelect>
                            </FluentGridItem>
                            <FluentGridItem xs="6">
                                <FluentNumberField @bind-Value="_serverConfig.VonCodecQuality" @bind-Value:after="OnServerConfigChanged" Label="VoN Quality (1-30)" Min="1" Max="30" />
                            </FluentGridItem>
                        </FluentGrid>
                    }
                </div>

                <div class="kast-card">
                    <h3>Timeouts &amp; Kick Thresholds</h3>
                    <FluentGrid Spacing="3">
                        <FluentGridItem xs="6"><FluentNumberField @bind-Value="_serverConfig.DisconnectTimeout" @bind-Value:after="OnServerConfigChanged" Label="Disconnect Timeout" Min="5" Max="90" /></FluentGridItem>
                        <FluentGridItem xs="6"><FluentNumberField @bind-Value="_serverConfig.MaxDesync" @bind-Value:after="OnServerConfigChanged" Label="Max Desync" /></FluentGridItem>
                        <FluentGridItem xs="6"><FluentNumberField @bind-Value="_serverConfig.MaxPing" @bind-Value:after="OnServerConfigChanged" Label="Max Ping" /></FluentGridItem>
                        <FluentGridItem xs="6"><FluentNumberField @bind-Value="_serverConfig.MaxPacketLoss" @bind-Value:after="OnServerConfigChanged" Label="Max Packet Loss" /></FluentGridItem>
                        <FluentGridItem xs="6"><FluentSwitch @bind-Value="_serverConfig.KickClientOnSlowNetwork" @bind-Value:after="OnServerConfigChanged" Label="Kick on Slow Network" /></FluentGridItem>
                        <FluentGridItem xs="6"><FluentNumberField @bind-Value="_serverConfig.LobbyIdleTimeout" @bind-Value:after="OnServerConfigChanged" Label="Lobby Idle Timeout" /></FluentGridItem>
                        <FluentGridItem xs="6"><FluentNumberField @bind-Value="_serverConfig.BriefingTimeOut" @bind-Value:after="OnServerConfigChanged" Label="Briefing Timeout" /></FluentGridItem>
                        <FluentGridItem xs="6"><FluentNumberField @bind-Value="_serverConfig.RoleTimeOut" @bind-Value:after="OnServerConfigChanged" Label="Role Timeout" /></FluentGridItem>
                        <FluentGridItem xs="6"><FluentNumberField @bind-Value="_serverConfig.DebriefingTimeOut" @bind-Value:after="OnServerConfigChanged" Label="Debriefing Timeout" /></FluentGridItem>
                    </FluentGrid>
                </div>

                <div class="kast-card">
                    <h3>Mission Rotation</h3>
                    <FluentGrid Spacing="3">
                        <FluentGridItem xs="6"><FluentSwitch @bind-Value="_serverConfig.AutoSelectMission" @bind-Value:after="OnServerConfigChanged" Label="Auto Select Mission" /></FluentGridItem>
                        <FluentGridItem xs="6"><FluentSwitch @bind-Value="_serverConfig.RandomMissionOrder" @bind-Value:after="OnServerConfigChanged" Label="Random Mission Order" /></FluentGridItem>
                    </FluentGrid>
                </div>

                <div class="kast-card">
                    <h3>Headless Clients</h3>
                    <FluentTextArea @bind-Value="_serverConfig.HeadlessClients" @bind-Value:after="OnServerConfigChanged"
                                   Label="HC IPs (one per line)" Rows="2" Style="width: 100%;" Placeholder="127.0.0.1" />
                    <FluentTextArea @bind-Value="_serverConfig.LocalClient" @bind-Value:after="OnServerConfigChanged"
                                   Label="Local Client IPs (one per line)" Rows="2" Style="width: 100%; margin-top: 8px;" Placeholder="127.0.0.1" />
                </div>

                <div class="kast-card">
                    <h3>Scripting Hooks</h3>
                    <FluentTextField @bind-Value="_serverConfig.OnUserConnected" @bind-Value:after="OnServerConfigChanged" Label="onUserConnected" Style="width: 100%;" />
                    <FluentTextField @bind-Value="_serverConfig.OnUserDisconnected" @bind-Value:after="OnServerConfigChanged" Label="onUserDisconnected" Style="width: 100%; margin-top: 8px;" />
                    <FluentTextField @bind-Value="_serverConfig.DoubleIdDetected" @bind-Value:after="OnServerConfigChanged" Label="doubleIdDetected" Style="width: 100%; margin-top: 8px;" />
                    <FluentTextField @bind-Value="_serverConfig.OnHackedData" @bind-Value:after="OnServerConfigChanged" Label="onHackedData" Style="width: 100%; margin-top: 8px;" />
                    <FluentTextField @bind-Value="_serverConfig.OnDifferentData" @bind-Value:after="OnServerConfigChanged" Label="onDifferentData" Style="width: 100%; margin-top: 8px;" />
                    <FluentTextField @bind-Value="_serverConfig.OnUnsignedData" @bind-Value:after="OnServerConfigChanged" Label="onUnsignedData" Style="width: 100%; margin-top: 8px;" />
                    <FluentTextField @bind-Value="_serverConfig.OnUserKicked" @bind-Value:after="OnServerConfigChanged" Label="onUserKicked" Style="width: 100%; margin-top: 8px;" />
                </div>

                <div class="kast-card">
                    <h3>Logging</h3>
                    <FluentGrid Spacing="3">
                        <FluentGridItem xs="6"><FluentSwitch @bind-Value="_serverConfig.NetlogEnabled" @bind-Value:after="OnServerConfigChanged" Label="Network Log (-netlog)" /></FluentGridItem>
                        <FluentGridItem xs="6"><FluentSwitch @bind-Value="_serverConfig.LogObjectNotFound" @bind-Value:after="OnServerConfigChanged" Label="Log Object Not Found" /></FluentGridItem>
                        <FluentGridItem xs="6"><FluentSwitch @bind-Value="_serverConfig.SkipDescriptionParsing" @bind-Value:after="OnServerConfigChanged" Label="Skip Description Parsing" /></FluentGridItem>
                        <FluentGridItem xs="6"><FluentSwitch @bind-Value="_serverConfig.IgnoreMissionLoadErrors" @bind-Value:after="OnServerConfigChanged" Label="Ignore Mission Load Errors" /></FluentGridItem>
                        <FluentGridItem xs="6"><FluentNumberField @bind-Value="_serverConfig.ArmaUnitsTimeout" @bind-Value:after="OnServerConfigChanged" Label="Arma Units Timeout" /></FluentGridItem>
                        <FluentGridItem xs="6"><FluentNumberField @bind-Value="_serverConfig.QueueSizeLogG" @bind-Value:after="OnServerConfigChanged" Label="Queue Size Log Threshold" /></FluentGridItem>
                    </FluentGrid>
                </div>
            </div>

            <div class="kast-card" style="position: sticky; top: 16px; align-self: start;">
                <h3>Raw server.cfg</h3>
                <FluentTextArea @bind-Value="_serverCfgRaw" @bind-Value:after="OnServerCfgRawChanged"
                               Label="" Rows="40" Style="width: 100%; font-family: monospace; font-size: 13px;" />
            </div>
        </div>
    </FluentTab>

    @* ════════════ BASIC CONFIG TAB ════════════ *@
    <FluentTab Label="Basic Config">
        <div style="margin-top: 16px; display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
            <div class="kast-card">
                <h3>View &amp; Terrain</h3>
                <FluentNumberField @bind-Value="_basicConfig.ViewDistance" @bind-Value:after="OnBasicConfigChanged" Label="View Distance" />
                <FluentNumberField @bind-Value="_basicConfig.TerrainGrid" @bind-Value:after="OnBasicConfigChanged" Label="Terrain Grid" Step="0.125" Style="margin-top: 8px;" />

                <h3 style="margin-top: 16px;">Network Performance</h3>
                <FluentNumberField @bind-Value="_basicConfig.MaxMsgSend" @bind-Value:after="OnBasicConfigChanged" Label="MaxMsgSend" />
                <FluentNumberField @bind-Value="_basicConfig.MaxSizeGuaranteed" @bind-Value:after="OnBasicConfigChanged" Label="MaxSizeGuaranteed" Style="margin-top: 8px;" />
                <FluentNumberField @bind-Value="_basicConfig.MaxSizeNonguaranteed" @bind-Value:after="OnBasicConfigChanged" Label="MaxSizeNonguaranteed" Style="margin-top: 8px;" />
                <FluentNumberField @bind-Value="_basicConfig.MinBandwidth" @bind-Value:after="OnBasicConfigChanged" Label="MinBandwidth (bps)" Style="margin-top: 8px;" />
                <FluentNumberField @bind-Value="_basicConfig.MaxBandwidth" @bind-Value:after="OnBasicConfigChanged" Label="MaxBandwidth (bps)" Style="margin-top: 8px;" />
                <FluentNumberField @bind-Value="_basicConfig.MinErrorToSend" @bind-Value:after="OnBasicConfigChanged" Label="MinErrorToSend" Step="0.001" Style="margin-top: 8px;" />
                <FluentNumberField @bind-Value="_basicConfig.MinErrorToSendNear" @bind-Value:after="OnBasicConfigChanged" Label="MinErrorToSendNear" Step="0.01" Style="margin-top: 8px;" />
                <FluentNumberField @bind-Value="_basicConfig.MaxCustomFileSize" @bind-Value:after="OnBasicConfigChanged" Label="MaxCustomFileSize (KB)" Style="margin-top: 8px;" />
                <FluentNumberField @bind-Value="_basicConfig.MaxPacketSize" @bind-Value:after="OnBasicConfigChanged" Label="MaxPacketSize" Style="margin-top: 8px;" />
            </div>
            <div class="kast-card" style="position: sticky; top: 16px; align-self: start;">
                <h3>Raw basic.cfg</h3>
                <FluentTextArea @bind-Value="_basicCfgRaw" @bind-Value:after="OnBasicCfgRawChanged"
                               Label="" Rows="20" Style="width: 100%; font-family: monospace; font-size: 13px;" />
            </div>
        </div>
    </FluentTab>

    @* ════════════ DIFFICULTY TAB ════════════ *@
    <FluentTab Label="Difficulty">
        <div style="margin-top: 16px; display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
            <div style="display: flex; flex-direction: column; gap: 16px;">
                <div class="kast-card">
                    <h3>Simulation</h3>
                    <FluentSelect TOption="string" Value="@_profileData.ReducedDamage.ToString()" ValueChanged="@(v => { _profileData.ReducedDamage = int.Parse(v); OnProfileChanged(); })" Label="Reduced Damage">
                        <FluentOption TOption="string" Value="0">Disabled</FluentOption>
                        <FluentOption TOption="string" Value="1">Enabled</FluentOption>
                    </FluentSelect>
                </div>

                <div class="kast-card">
                    <h3>Situational Awareness</h3>
                    <FluentGrid Spacing="3">
                        <FluentGridItem xs="6">
                            <FluentSelect TOption="string" Value="@_profileData.GroupIndicators.ToString()" ValueChanged="@(v => { _profileData.GroupIndicators = int.Parse(v); OnProfileChanged(); })" Label="Group Indicators">
                                <FluentOption TOption="string" Value="0">Never</FluentOption>
                                <FluentOption TOption="string" Value="1">Limited Distance</FluentOption>
                                <FluentOption TOption="string" Value="2">Always</FluentOption>
                            </FluentSelect>
                        </FluentGridItem>
                        <FluentGridItem xs="6">
                            <FluentSelect TOption="string" Value="@_profileData.FriendlyTags.ToString()" ValueChanged="@(v => { _profileData.FriendlyTags = int.Parse(v); OnProfileChanged(); })" Label="Friendly Tags">
                                <FluentOption TOption="string" Value="0">Never</FluentOption>
                                <FluentOption TOption="string" Value="1">Limited Distance</FluentOption>
                                <FluentOption TOption="string" Value="2">Always</FluentOption>
                            </FluentSelect>
                        </FluentGridItem>
                        <FluentGridItem xs="6">
                            <FluentSelect TOption="string" Value="@_profileData.EnemyTags.ToString()" ValueChanged="@(v => { _profileData.EnemyTags = int.Parse(v); OnProfileChanged(); })" Label="Enemy Tags">
                                <FluentOption TOption="string" Value="0">Never</FluentOption>
                                <FluentOption TOption="string" Value="1">Limited Distance</FluentOption>
                                <FluentOption TOption="string" Value="2">Always</FluentOption>
                            </FluentSelect>
                        </FluentGridItem>
                        <FluentGridItem xs="6">
                            <FluentSelect TOption="string" Value="@_profileData.DetectedMines.ToString()" ValueChanged="@(v => { _profileData.DetectedMines = int.Parse(v); OnProfileChanged(); })" Label="Detected Mines">
                                <FluentOption TOption="string" Value="0">Never</FluentOption>
                                <FluentOption TOption="string" Value="1">Limited Distance</FluentOption>
                                <FluentOption TOption="string" Value="2">Always</FluentOption>
                            </FluentSelect>
                        </FluentGridItem>
                        <FluentGridItem xs="6">
                            <FluentSelect TOption="string" Value="@_profileData.Commands.ToString()" ValueChanged="@(v => { _profileData.Commands = int.Parse(v); OnProfileChanged(); })" Label="Commands">
                                <FluentOption TOption="string" Value="0">Never</FluentOption>
                                <FluentOption TOption="string" Value="1">Fade Out</FluentOption>
                                <FluentOption TOption="string" Value="2">Always</FluentOption>
                            </FluentSelect>
