    @* ════════════ MODS TAB ════════════ *@
    <FluentTab Label="Mods">
        <div style="margin-top: 16px; display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; min-height: 400px;">

            @* ── Available Mods Column ── *@
            <div class="kast-card kast-drop-zone" @ref="_availableDropZone">
                <h3 style="margin-top: 0;">
                    <FluentIcon Value="@(new Icons.Regular.Size20.PuzzlePiece())" Style="vertical-align: middle;" />
                    Available Mods
                </h3>
                <p style="font-size: 12px; color: var(--kast-text-muted); margin: 0 0 12px;">Drag mods to assign them</p>
                @foreach (var mod in _unassignedMods)
                {
                    <div class="kast-mod-item" draggable="true"
                         @ondragstart="@(async () => await OnDragStart(mod.Id, ColAvailable))">
                        <span style="opacity: 0.4; cursor: grab; flex-shrink: 0;">⠿</span>
                        @if (!string.IsNullOrEmpty(mod.ThumbnailUrl))
                        {
                            <img src="@mod.ThumbnailUrl" alt="" style="width: 22px; height: 22px; object-fit: cover; border-radius: 3px; flex-shrink: 0;" />
                        }
                        else
                        {
                            <FluentIcon Value="@(new Icons.Regular.Size16.PuzzlePiece())" Style="flex-shrink: 0; opacity: 0.4;" />
                        }
                        <span style="flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@mod.Name</span>
                        <span style="font-size: 11px; color: var(--kast-text-muted); flex-shrink: 0;">@mod.WorkshopId</span>
                    </div>
                }
                @if (_unassignedMods.Count == 0)
                {
                    <p style="color: var(--kast-text-muted); text-align: center; padding: 40px 0;">All mods assigned</p>
                }
            </div>

            @* ── Client-Side Mods Column ── *@
            <div class="kast-card kast-drop-zone" @ref="_clientDropZone">
                <h3 style="margin-top: 0;">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Desktop())" Style="vertical-align: middle;" />
                    Client-Side Mods
                    <span class="kast-mod-count">@_clientMods.Count</span>
                </h3>
                <p style="font-size: 12px; color: var(--kast-text-muted); margin: 0 0 12px;">Loaded by server &amp; clients (-mod=)</p>
                @foreach (var sim in _clientMods)
                {
                    <div class="kast-mod-item" draggable="true"
                         @ondragstart="@(async () => await OnDragStart(sim.SteamModId, ColClient))">
                        <span style="opacity: 0.4; cursor: grab; flex-shrink: 0;">⠿</span>
                        @if (!string.IsNullOrEmpty(sim.SteamMod.ThumbnailUrl))
                        {
                            <img src="@sim.SteamMod.ThumbnailUrl" alt="" style="width: 22px; height: 22px; object-fit: cover; border-radius: 3px; flex-shrink: 0;" />
                        }
                        else
                        {
                            <FluentIcon Value="@(new Icons.Regular.Size16.PuzzlePiece())" Style="flex-shrink: 0; opacity: 0.4;" />
                        }
                        <span style="flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@sim.SteamMod.Name</span>
                        <span style="font-size: 11px; color: var(--kast-text-muted); margin-right: 4px; flex-shrink: 0;">#@sim.LoadOrder</span>
                        <FluentButton Size="ButtonSize.Small" Appearance="Appearance.Stealth"
                                      Title="Remove" OnClick="@(() => RemoveMod(sim.SteamModId))">
                            <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Color="Color.Error" />
                        </FluentButton>
                    </div>
                }
                @if (_clientMods.Count == 0)
                {
                    <div class="kast-drop-placeholder">Drop client mods here</div>
                }
            </div>

            @* ── Server-Side Mods Column ── *@
            <div class="kast-card kast-drop-zone" @ref="_serverDropZone">
                <h3 style="margin-top: 0;">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Server())" Style="vertical-align: middle;" />
                    Server-Side Mods
                    <span class="kast-mod-count">@_serverMods.Count</span>
                </h3>
                <p style="font-size: 12px; color: var(--kast-text-muted); margin: 0 0 12px;">Server only (-serverMod=)</p>
                @foreach (var sim in _serverMods)
                {
                    <div class="kast-mod-item" draggable="true"
                         @ondragstart="@(async () => await OnDragStart(sim.SteamModId, ColServer))">
                        <span style="opacity: 0.4; cursor: grab; flex-shrink: 0;">⠿</span>
                        @if (!string.IsNullOrEmpty(sim.SteamMod.ThumbnailUrl))
                        {
                            <img src="@sim.SteamMod.ThumbnailUrl" alt="" style="width: 22px; height: 22px; object-fit: cover; border-radius: 3px; flex-shrink: 0;" />
                        }
                        else
                        {
                            <FluentIcon Value="@(new Icons.Regular.Size16.PuzzlePiece())" Style="flex-shrink: 0; opacity: 0.4;" />
                        }
                        <span style="flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@sim.SteamMod.Name</span>
                        <span style="font-size: 11px; color: var(--kast-text-muted); margin-right: 4px; flex-shrink: 0;">#@sim.LoadOrder</span>
                        <FluentButton Size="ButtonSize.Small" Appearance="Appearance.Stealth"
                                      Title="Remove" OnClick="@(() => RemoveMod(sim.SteamModId))">
                            <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Color="Color.Error" />
                        </FluentButton>
                    </div>
                }
                @if (_serverMods.Count == 0)
                {
                    <div class="kast-drop-placeholder">Drop server mods here</div>
                }
            </div>
        </div>
    </FluentTab>

    @* ════════════ INSTALL TAB ════════════ *@
    <FluentTab Label="Install">
        <div class="kast-card" style="margin-top: 16px;">
            @if (_isNew)
            {
                <div style="display:flex; align-items:center; gap:8px; color: var(--kast-text-muted);">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Info())" />
                    <span>Save the server first before downloading server files.</span>
                </div>
            }
            else
            {
                @* ── Install status badge ── *@
                <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px; flex-wrap:wrap;">
                    @if (_installState?.IsDownloading == true)
                    {
                        <FluentIcon Value="@(new Icons.Regular.Size20.ArrowDownload())" Color="Color.Accent" />
                        <span><strong>Downloading…</strong> @(_installState.OverallProgress.ToString("F0"))%</span>
                    }
                    else if (_instance.InstalledAt.HasValue)
                    {
                        <FluentIcon Value="@(new Icons.Regular.Size20.CheckmarkCircle())" Color="Color.Success" />
                        <span>Installed <strong>@_instance.InstalledAt.Value.ToLocalTime().ToString("g")</strong></span>
                        @if (!string.IsNullOrEmpty(_instance.InstalledBuildId))
                        {
                            <FluentBadge Appearance="Appearance.Lightweight">Build @_instance.InstalledBuildId</FluentBadge>
                        }
                        <span style="color:var(--kast-text-muted); font-size:12px;">@_instance.InstallPath</span>
                    }
                    else
                    {
                        <FluentIcon Value="@(new Icons.Regular.Size20.Warning())" Color="Color.Warning" />
                        <span style="color:var(--kast-text-muted);">Not installed — server files have not been downloaded yet.</span>
                    }
                    @if (!string.IsNullOrEmpty(_installState?.ErrorMessage) && _installState.ErrorMessage != "Cancelled")
                    {
                        <span style="font-size:12px; color:var(--error); display:inline-flex; align-items:center; gap:4px;">
                            <FluentIcon Value="@(new Icons.Regular.Size12.Warning())" Color="Color.Error" />
                            Failed: @_installState.ErrorMessage
                        </span>
                    }
                </div>

                @* ── Stepper (active download or just completed this session) ── *@
                @if (_installState?.IsDownloading == true || _installState?.IsComplete == true)
                {
                    var _steps = _installState!.Steps;
                    bool _allDone = _installState.IsComplete;

                    <div style="margin-bottom:24px;">
                        <div style="font-size:12px; font-weight:600; color:var(--kast-text-muted); margin-bottom:8px; text-transform:uppercase; letter-spacing:.5px;">Download Progress</div>
                        <div class="kast-stepper">
                        @for (int _si = 0; _si < _steps.Count; _si++)
                        {
                            int _stepNum = _si + 1;
                            var _step = _steps[_si];
                            bool _done   = _step.Status == ContentStepStatus.Completed;
                            bool _active = _step.Status == ContentStepStatus.InProgress;
                            bool _skip   = _step.Status == ContentStepStatus.Skipped;
                            bool _failed = _step.Status == ContentStepStatus.Failed;

                            var _cls = _done   ? "kast-step kast-step--done"
                                     : _active ? "kast-step kast-step--active"
                                     : _skip   ? "kast-step kast-step--skip"
                                     : _failed ? "kast-step kast-step--failed"
                                     :           "kast-step kast-step--pending";

                            <div class="@_cls">
                                <div class="kast-step__circle">
                                    @if (_done)
                                    {
                                        <FluentIcon Value="@(new Icons.Regular.Size16.Checkmark())" Color="Color.Custom" CustomColor="#fff" />
                                    }
                                    else if (_skip)
                                    {
                                        <span>&mdash;</span>
                                    }
                                    else if (_failed)
                                    {
                                        <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Color="Color.Custom" CustomColor="#fff" />
                                    }
                                    else
                                    {
                                        <span>@_stepNum</span>
                                    }
                                </div>
                                <div class="kast-step__label">@_step.Name</div>
                                @if (_active)
                                {
                                    <div class="kast-step__detail">@(_step.Progress.ToString("F0"))%</div>
                                }
                                else if (_failed)
                                {
                                    <div class="kast-step__detail" style="color:var(--error);">@(_step.Error ?? "Failed")</div>
                                }
                                else if (!_done && !_skip)
                                {
                                    <div class="kast-step__detail">@_step.Detail</div>
                                }
                            </div>
                        }
                        </div>
                    </div>

                    @if (_installState.IsDownloading)
                    {
                        <FluentProgress Value="@((int)_installState.OverallProgress)" Max="100"
                                        Style="width:100%; margin-bottom:16px;" />
                    }
                }

                @* ── Action buttons ── *@
                <div style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:16px;">
                    @if (_installState?.IsDownloading == true)
                    {
                        <FluentButton Appearance="Appearance.Outline"
                                      IconStart="@(new Icons.Regular.Size16.Stop())"
                                      OnClick="CancelInstall">
                            Cancel Download
                        </FluentButton>
                    }
                    else
                    {
                        <FluentButton Appearance="Appearance.Accent"
                                      IconStart="@(new Icons.Regular.Size16.ArrowDownload())"
                                      OnClick="StartInstall"
                                      Disabled="@(_instance.Status == ServerInstanceStatus.Running)">
                            @(_instance.InstalledAt.HasValue ? "Re-download Server Files" : "Download Server Files")
                        </FluentButton>
                        <FluentButton Appearance="Appearance.Outline"
                                      IconStart="@(new Icons.Regular.Size16.Checkmark())"
                                      OnClick="ValidateInstall">
                            Validate Files
                        </FluentButton>
                    }
                </div>

                @* ── DLC enabled on this instance ── *@
                @if (_instance.ContactDlc || _instance.GmDlc || _instance.PfDlc ||
                     _instance.CslaDlc || _instance.WsDlc || _instance.SpeDlc ||
                     _instance.RfDlc || _instance.EfDlc)
                {
                    <div style="margin-bottom:16px;">
                        <div style="font-size:12px; font-weight:600; color:var(--kast-text-muted); margin-bottom:6px; text-transform:uppercase; letter-spacing:.5px;">Creator DLC</div>
                        <div style="display:flex; gap:6px; flex-wrap:wrap;">
                            @if (_instance.ContactDlc)  { <FluentBadge Appearance="Appearance.Neutral">Contact</FluentBadge> }
                            @if (_instance.GmDlc)       { <FluentBadge Appearance="Appearance.Neutral">Global Mobilization</FluentBadge> }
                            @if (_instance.PfDlc)       { <FluentBadge Appearance="Appearance.Neutral">S.O.G. Prairie Fire</FluentBadge> }
                            @if (_instance.CslaDlc)     { <FluentBadge Appearance="Appearance.Neutral">CSLA Iron Curtain</FluentBadge> }
                            @if (_instance.WsDlc)       { <FluentBadge Appearance="Appearance.Neutral">Western Sahara</FluentBadge> }
                            @if (_instance.SpeDlc)      { <FluentBadge Appearance="Appearance.Neutral">Spearhead 1944</FluentBadge> }
                            @if (_instance.RfDlc)       { <FluentBadge Appearance="Appearance.Neutral">Reaction Forces</FluentBadge> }
                            @if (_instance.EfDlc)       { <FluentBadge Appearance="Appearance.Neutral">Expeditionary Forces</FluentBadge> }
                        </div>
                    </div>
                }

                @* ── Validation results ── *@
                @if (_validationResults != null)
                {
                    <div style="margin-bottom:16px;">
                        <div style="font-size:12px; font-weight:600; color:var(--kast-text-muted); margin-bottom:8px; text-transform:uppercase; letter-spacing:.5px;">File Validation</div>
                        <div style="display:flex; flex-direction:column; gap:4px;">
                            @foreach (var r in _validationResults)
                            {
                                <div style="display:flex; align-items:center; gap:8px; font-size:13px;">
                                    @if (r.OK)
                                    {
                                        <FluentIcon Value="@(new Icons.Regular.Size16.Checkmark())" Color="Color.Success" />
                                    }
                                    else
                                    {
                                        <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Color="Color.Error" />
                                    }
                                    <span>@r.Label</span>
                                    @if (!string.IsNullOrEmpty(r.Detail))
                                    {
                                        <span style="color:var(--kast-text-muted); font-size:12px;">— @r.Detail</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                @* ── Install log console ── *@
                @if (_installState?.Log.Count > 0)
                {
                    var _logSnapshot = _installState.Log.ToArray();
                    <div>
                        <div style="font-size:12px; font-weight:600; color:var(--kast-text-muted); margin-bottom:6px; text-transform:uppercase; letter-spacing:.5px;">Install Log</div>
                        <div class="kast-install-log" @ref="_installLogRef">
                            @foreach (var line in _logSnapshot)
                            {
                                <div class="@(line.Contains("ERROR") ? "kast-install-log-error" : "")">@line</div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </FluentTab>

    @* ════════════ MONITOR TAB ════════════ *@
    @if (!_isNew)
    {
        <FluentTab Label="Monitor" Id="monitor-tab">
            <div style="margin-top: 16px;">

                @* ── Server Info Tiles ── *@
                <div class="kast-tiles" style="margin-bottom: 16px;">
                    <div class="kast-tile" style="min-height: auto; cursor: default;">
                        <div class="kast-tile-title">Status</div>
                        <div class="kast-tile-value" style="font-size: 20px;">
                            <span class="status-dot @_instance.Status.ToString().ToLowerInvariant()"></span>
                            @_instance.Status
                        </div>
                    </div>
                    <div class="kast-tile" style="min-height: auto; cursor: default;">
                        <div class="kast-tile-title">Port</div>
                        <div class="kast-tile-value" style="font-size: 20px;">@_instance.Port</div>
                        <div class="kast-tile-subtitle">Query: @_instance.SteamQueryPort</div>
                    </div>
                    <div class="kast-tile" style="min-height: auto; cursor: default;">
                        <div class="kast-tile-title">Players</div>
                        <div class="kast-tile-value" style="font-size: 20px;">@_monitorPlayerCount</div>
                    </div>
                    <div class="kast-tile" style="min-height: auto; cursor: default;">
                        <div class="kast-tile-title">Uptime</div>
                        <div class="kast-tile-value" style="font-size: 20px;">@GetUptime()</div>
                    </div>
                    <div class="kast-tile" style="min-height: auto; cursor: default;">
                        <div class="kast-tile-title">CPU</div>
                        <div class="kast-tile-value" style="font-size: 20px;">@_monitorCpu.ToString("F1")%</div>
                    </div>
                    <div class="kast-tile" style="min-height: auto; cursor: default;">
                        <div class="kast-tile-title">Memory</div>
                        <div class="kast-tile-value" style="font-size: 20px;">@FormatBytes(_monitorMemory)</div>
                    </div>
                </div>

                @* ── Server Details ── *@
                <div class="kast-card" style="margin-bottom: 16px;">
                    <h3 style="margin-top: 0;">Server Information</h3>
                    <FluentGrid Spacing="3">
                        <FluentGridItem xs="6" sm="3">
                            <div style="font-size: 12px; color: var(--kast-text-muted); text-transform: uppercase; letter-spacing: .5px;">PID</div>
                            <div style="font-size: 14px; font-weight: 500;">@(_instance.ProcessId?.ToString() ?? "—")</div>
                        </FluentGridItem>
                        <FluentGridItem xs="6" sm="3">
                            <div style="font-size: 12px; color: var(--kast-text-muted); text-transform: uppercase; letter-spacing: .5px;">Mods</div>
                            <div style="font-size: 14px; font-weight: 500;">@_instance.Mods.Count</div>
                        </FluentGridItem>
                        <FluentGridItem xs="6" sm="3">
                            <div style="font-size: 12px; color: var(--kast-text-muted); text-transform: uppercase; letter-spacing: .5px;">Headless Clients</div>
                            <div style="font-size: 14px; font-weight: 500;">@_instance.HeadlessClientCount</div>
                        </FluentGridItem>
                        <FluentGridItem xs="6" sm="3">
                            <div style="font-size: 12px; color: var(--kast-text-muted); text-transform: uppercase; letter-spacing: .5px;">Restart Policy</div>
                            <div style="font-size: 14px; font-weight: 500;">@_instance.RestartPolicy</div>
                        </FluentGridItem>
                        <FluentGridItem xs="6" sm="3">
                            <div style="font-size: 12px; color: var(--kast-text-muted); text-transform: uppercase; letter-spacing: .5px;">Install Path</div>
                            <div style="font-size: 13px; font-weight: 500; word-break: break-all;">@_instance.InstallPath</div>
                        </FluentGridItem>
                        <FluentGridItem xs="6" sm="3">
                            <div style="font-size: 12px; color: var(--kast-text-muted); text-transform: uppercase; letter-spacing: .5px;">Started At</div>
                            <div style="font-size: 14px; font-weight: 500;">@(_instance.StartedAt?.ToLocalTime().ToString("g") ?? "—")</div>
                        </FluentGridItem>
                    </FluentGrid>
                </div>

                @* ── Console Log ── *@
                <div class="kast-card" style="padding: 0; overflow: hidden;">
                    <div style="display: flex; align-items: center; justify-content: space-between; padding: 12px 20px; border-bottom: 1px solid var(--neutral-stroke-divider-rest);">
                        <FluentStack VerticalAlignment="VerticalAlignment.Center" Gap="8">
                            <FluentIcon Value="@(new Icons.Regular.Size20.TextBulletListSquare())" Color="Color.Neutral" />
                            <span style="font-weight: 600;">Server Console</span>
                            <FluentBadge Appearance="Appearance.Neutral" Style="font-size: 10px;">
                                @_consoleLines.Count lines
                            </FluentBadge>
                        </FluentStack>
                        <FluentButton Size="ButtonSize.Small" Appearance="Appearance.Stealth"
                                      Title="Clear" OnClick="ClearConsole">
                            <FluentIcon Value="@(new Icons.Regular.Size16.Delete())" Color="Color.Neutral" />
                        </FluentButton>
                    </div>
                    <div class="kast-server-console" @ref="_consoleRef">
                        @if (_consoleLines.Count == 0)
                        {
                            <div style="color: var(--kast-text-muted); text-align: center; padding: 60px 0;">
                                @if (_instance.Status == ServerInstanceStatus.Stopped || _instance.Status == ServerInstanceStatus.Crashed)
                                {
                                    <span>Server is not running. Start the server to see console output.</span>
                                }
                                else if (_instance.Status == ServerInstanceStatus.Starting)
                                {
                                    <span>Server is starting…</span>
                                }
                                else
                                {
                                    <span>Waiting for output…</span>
                                }
                            </div>
                        }
                        else
                        {
                            @foreach (var line in _consoleLines)
                            {
                                <div class="kast-console-line">
                                    <span class="kast-console-ts">@line.Timestamp.ToString("HH:mm:ss")</span>
                                    <span class="@(line.Line.Contains("ERROR", StringComparison.OrdinalIgnoreCase) ? "kast-console-error" : "")">@line.Line</span>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </FluentTab>
    }

</FluentTabs>

@* ════════════ COMMAND LINE FOOTER ════════════ *@
<div class="kast-cmdline-footer @(_cmdExpanded ? "kast-cmdline-footer--expanded" : "")">
    <div class="kast-cmdline-footer__bar" @onclick="() => _cmdExpanded = !_cmdExpanded">
        <FluentIcon Value="@(new Icons.Regular.Size16.Code())" Style="flex-shrink: 0; opacity: 0.6;" />
        <code class="kast-cmdline-footer__text">@GetCommandLinePreview()</code>
        @if (_cmdExpanded)
        {
            <FluentIcon Value="@(new Icons.Regular.Size12.ChevronDown())" Style="flex-shrink: 0; opacity: 0.5; cursor: pointer;" />
        }
        else
        {
            <FluentIcon Value="@(new Icons.Regular.Size12.ChevronUp())" Style="flex-shrink: 0; opacity: 0.5; cursor: pointer;" />
        }
    </div>
    @if (_cmdExpanded)
    {
        <div class="kast-cmdline-footer__detail">
            <code>@GetCommandLinePreview()</code>
        </div>
    }
</div>

@code {
    [Parameter] public int? Id { get; set; }

    private ServerInstance _instance = new();
    private bool _isNew => Id == null || Id == 0;
    private IReadOnlyList<SteamMod> _availableMods = [];
    private string _serversDirectory = "./servers";

    // ── Install state ──
    private ContentInstallState? _installState;
    private ElementReference _installLogRef;
    private IReadOnlyList<ContentValidationResult>? _validationResults;
    private bool _disposed;
    private bool _cmdExpanded;

    // ── Monitor state ──
    private HubConnection? _hubConnection;
    private readonly List<ConsoleEntry> _consoleLines = new();
    private ElementReference _consoleRef;
    private double _monitorCpu;
    private long _monitorMemory;
    private int _monitorPlayerCount;
    private string _activeTabId = "";

    private record ConsoleEntry(DateTime Timestamp, string Line);

    private string _restartPolicyStr
    {
        get => _instance.RestartPolicy.ToString();
        set => _instance.RestartPolicy = Enum.Parse<RestartPolicy>(value);
    }

    private ServerConfigData _serverConfig = new();
    private BasicConfigData _basicConfig = new();
    private Arma3ProfileData _profileData = new();
    private string _serverCfgRaw = "";
    private string _basicCfgRaw = "";
    private string _profileRaw = "";

    // ── Mod drag-drop state ──
    private const string ColAvailable = "available";
    private const string ColClient = "client";
    private const string ColServer = "server";
    private ElementReference _availableDropZone;
    private ElementReference _clientDropZone;
    private ElementReference _serverDropZone;
    private DotNetObjectReference<ServerEdit>? _selfRef;

    private List<SteamMod> _unassignedMods => _availableMods
        .Where(m => !_instance.Mods.Any(im => im.SteamModId == m.Id)).ToList();
    private List<ServerInstanceMod> _clientMods => _instance.Mods
        .Where(m => !m.IsServerSide).OrderBy(m => m.LoadOrder).ToList();
    private List<ServerInstanceMod> _serverMods => _instance.Mods
        .Where(m => m.IsServerSide).OrderBy(m => m.LoadOrder).ToList();

    [Inject] private IJSRuntime JS { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        if (!_isNew)
        {
            var instance = await ServerService.GetInstanceByIdAsync(Id!.Value);
            if (instance == null) { Nav.NavigateTo("/servers"); return; }
            _instance = instance;

            if (!string.IsNullOrEmpty(_instance.ServerCfgContent))
            { _serverConfig = ConfigService.ParseServerConfig(_instance.ServerCfgContent); _serverCfgRaw = _instance.ServerCfgContent; }
            if (!string.IsNullOrEmpty(_instance.BasicCfgContent))
            { _basicConfig = ConfigService.ParseBasicConfig(_instance.BasicCfgContent); _basicCfgRaw = _instance.BasicCfgContent; }
            if (!string.IsNullOrEmpty(_instance.ArmaProfileContent))
            { _profileData = ConfigService.ParseArma3Profile(_instance.ArmaProfileContent); _profileRaw = _instance.ArmaProfileContent; }

            // Set up SignalR for real-time monitoring
            await InitializeSignalR();
        }
        else
        {
            var settings = await SettingsService.GetSettingsAsync();
            _serversDirectory = settings.ServersDirectory;
            _instance.Name = $"Server-{DateTime.UtcNow:yyyyMMdd-HHmmss}";
            _instance.InstallPath = Path.Combine(_serversDirectory, _instance.Name);
            _serverConfig.Hostname = _instance.Name;
        }

        _availableMods = await ModService.GetAllModsAsync();

        // Subscribe to install progress for this instance (only when editing an existing server)
        if (!_isNew)
        {
            var key = ContentProgressTracker.ServerKey(_instance.Id);
            _installState = ContentTracker.Get(key);
            if (_installState is not null)
                _installState.Changed += OnInstallStateChanged;

            // Auto-validate if the server files are already installed
            if (_instance.InstalledAt.HasValue)
                _validationResults = ContentOrchestrator.Validate(ContentType.Server, new ContentInstallRequest
                {
                    Type = ContentType.Server,
                    DestinationPath = _instance.InstallPath,
                    Instance = _instance
                });
        }

        if (string.IsNullOrEmpty(_serverCfgRaw)) _serverCfgRaw = ConfigService.SerializeServerConfig(_serverConfig);
        if (string.IsNullOrEmpty(_basicCfgRaw)) _basicCfgRaw = ConfigService.SerializeBasicConfig(_basicConfig);
        if (string.IsNullOrEmpty(_profileRaw)) _profileRaw = ConfigService.SerializeArma3Profile(_profileData);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("kastDragDrop.initDropZone", _availableDropZone, _selfRef, "available");
            await JS.InvokeVoidAsync("kastDragDrop.initDropZone", _clientDropZone, _selfRef, "client");
            await JS.InvokeVoidAsync("kastDragDrop.initDropZone", _serverDropZone, _selfRef, "server");
        }
    }

    private async Task OnDragStart(int modId, string source)
    {
        await JS.InvokeVoidAsync("kastDragDrop.startDrag", modId, source);
    }

    [JSInvokable]
    public async Task OnModDropped(int modId, string fromSource, string toTarget)
    {
        if (fromSource == toTarget) return;

        if (fromSource == "available")
        {
            bool serverSide = toTarget == "server";
            await AddMod(modId, serverSide);
            return;
        }

        if (toTarget == "available")
        {
            await RemoveMod(modId);
            return;
        }

        // Moving between client ↔ server columns
        var instanceMod = _instance.Mods.FirstOrDefault(m => m.SteamModId == modId);
        if (instanceMod != null)
        {
            instanceMod.IsServerSide = toTarget == "server";
            ReindexMods();
        }
        StateHasChanged();
    }

    private void ReindexMods()
    {
        var clientIdx = 0;
        foreach (var m in _instance.Mods.Where(m => !m.IsServerSide).OrderBy(m => m.LoadOrder))
            m.LoadOrder = clientIdx++;
        var serverIdx = 0;
        foreach (var m in _instance.Mods.Where(m => m.IsServerSide).OrderBy(m => m.LoadOrder))
            m.LoadOrder = serverIdx++;
    }

    private void OnNameChanged()
    {
        // Keep InstallPath in sync with the name for new servers (before the user manually edits it)
        if (_isNew && !string.IsNullOrWhiteSpace(_instance.Name))
            _instance.InstallPath = Path.Combine(_serversDirectory, _instance.Name);
    }

    private void OnServerConfigChanged() => _serverCfgRaw = ConfigService.SerializeServerConfig(_serverConfig);
    private void OnServerCfgRawChanged() => _serverConfig = ConfigService.ParseServerConfig(_serverCfgRaw);
    private void OnBasicConfigChanged() => _basicCfgRaw = ConfigService.SerializeBasicConfig(_basicConfig);
    private void OnBasicCfgRawChanged() => _basicConfig = ConfigService.ParseBasicConfig(_basicCfgRaw);
    private void OnProfileChanged() => _profileRaw = ConfigService.SerializeArma3Profile(_profileData);
    private void OnProfileRawChanged() => _profileData = ConfigService.ParseArma3Profile(_profileRaw);

    private async Task Save()
    {
        _instance.ServerCfgContent = ConfigService.SerializeServerConfig(_serverConfig);
        _instance.BasicCfgContent = ConfigService.SerializeBasicConfig(_basicConfig);
        _instance.ArmaProfileContent = ConfigService.SerializeArma3Profile(_profileData);

        if (_isNew)
        {
            await ServerService.CreateInstanceAsync(_instance);
        }
        else
        {
            await ServerService.UpdateInstanceAsync(_instance);
        }

        // Symlink mods into the instance mods folder
        if (!string.IsNullOrEmpty(_instance.InstallPath))
        {
            await ServerService.LinkModsAsync(_instance.Id);
            ServerService.WriteConfigFiles(_instance);
        }

        ToastService.ShowSuccess("Server saved");

        // If this was a new server, update the URL without navigating away
        if (Id == null || Id == 0)
            Nav.NavigateTo($"/servers/{_instance.Id}", replace: true);
    }

    private async Task LaunchServer()
    {
        if (_isNew) return;
        try
        {
            // Save first to ensure config files and symlinks are up to date
            await Save();
            await ServerService.StartInstanceAsync(_instance.Id);
            _instance = (await ServerService.GetInstanceByIdAsync(_instance.Id))!;
            _activeTabId = "monitor-tab";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to launch: {ex.Message}");
        }
    }

    private async Task StopServer()
    {
        if (_isNew) return;
        try
        {
            await ServerService.StopInstanceAsync(_instance.Id);
            _instance = (await ServerService.GetInstanceByIdAsync(_instance.Id))!;
            _monitorCpu = 0;
            _monitorMemory = 0;
            _monitorPlayerCount = 0;
            ToastService.ShowSuccess("Server stopped");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to stop: {ex.Message}");
        }
    }

    private string GetCommandLinePreview()
    {
        // Sync in-memory config content so the preview reflects current UI state
        _instance.ServerCfgContent = ConfigService.SerializeServerConfig(_serverConfig);
        _instance.BasicCfgContent = ConfigService.SerializeBasicConfig(_basicConfig);
        _instance.ArmaProfileContent = ConfigService.SerializeArma3Profile(_profileData);
        return ServerService.GetCommandLine(_instance);
    }

    private async Task AddMod(int modId, bool serverSide = false)
    {
        if (!_isNew)
        {
            await ServerService.AddModToInstanceAsync(_instance.Id, modId);
            _instance = (await ServerService.GetInstanceByIdAsync(_instance.Id))!;
            var added = _instance.Mods.FirstOrDefault(m => m.SteamModId == modId);
            if (added != null) added.IsServerSide = serverSide;
        }
        else
        {
            var mod = _availableMods.FirstOrDefault(m => m.Id == modId);
            if (mod != null)
                _instance.Mods.Add(new ServerInstanceMod { SteamModId = modId, SteamMod = mod, IsServerSide = serverSide, LoadOrder = _instance.Mods.Count });
        }
        ReindexMods();
        StateHasChanged();
    }

    private async Task RemoveMod(int modId)
    {
        if (!_isNew)
        {
            await ServerService.RemoveModFromInstanceAsync(_instance.Id, modId);
            _instance = (await ServerService.GetInstanceByIdAsync(_instance.Id))!;
        }
        else
        {
            var toRemove = _instance.Mods.FirstOrDefault(m => m.SteamModId == modId);
            if (toRemove != null) _instance.Mods.Remove(toRemove);
        }
        ReindexMods();
        StateHasChanged();
    }

    private async Task StartInstall()
    {
        if (_isNew) return;
        _validationResults = null;

        // Detach from previous state if any
        if (_installState is not null)
            _installState.Changed -= OnInstallStateChanged;

        var settings = await SettingsService.GetSettingsAsync();
        int maxPar = Math.Max(1, settings.ParallelDownloads);

        _installState = ContentOrchestrator.StartServerInstall(
            _instance.Id, _instance.InstallPath, _instance, maxPar);
        _installState.Changed += OnInstallStateChanged;
        StateHasChanged();
    }

    private void CancelInstall()
    {
        if (_isNew) return;
        ContentOrchestrator.Cancel(ContentProgressTracker.ServerKey(_instance.Id));
    }

    private void ValidateInstall()
    {
        _validationResults = ContentOrchestrator.Validate(ContentType.Server, new ContentInstallRequest
        {
            Type = ContentType.Server,
            DestinationPath = _instance.InstallPath,
            Instance = _instance
        });
        StateHasChanged();
    }

    private void OnInstallStateChanged()
    {
        if (_disposed) return;
        InvokeAsync(async () =>
        {
            if (_disposed) return;
            // If the download just finished successfully, reload _instance from DB
            if (_installState?.IsComplete == true && !_instance.InstalledAt.HasValue)
            {
                var fresh = await ServerService.GetInstanceByIdAsync(_instance.Id);
                if (fresh != null) _instance = fresh;
            }

            // Auto-validate after download completes
            if (_installState?.IsComplete == true && _validationResults == null)
                _validationResults = ContentOrchestrator.Validate(ContentType.Server, new ContentInstallRequest
                {
                    Type = ContentType.Server,
                    DestinationPath = _instance.InstallPath,
                    Instance = _instance
                });

            StateHasChanged();
            if (_installState?.Log.Count > 0)
            {
                try
                { await JS.InvokeVoidAsync("kastScrollToBottom", _installLogRef); }
                catch (TaskCanceledException) { /* ignore */ }
                catch (OperationCanceledException) { /* ignore */ }
            }
        });
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_installState is not null)
            _installState.Changed -= OnInstallStateChanged;
        _selfRef?.Dispose();
        if (_hubConnection is not null)
            await _hubConnection.DisposeAsync();
    }

    // ── SignalR setup ──
    private async Task InitializeSignalR()
    {
        _hubConnection = new HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri("/hubs/monitoring"))
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<LogEntryEvent>("LogEntry", entry =>
        {
            if (entry.ServerInstanceId != _instance.Id) return;
            _consoleLines.Add(new ConsoleEntry(entry.Timestamp, entry.Line));
            // Keep only last 1000 lines
            while (_consoleLines.Count > 1000)
                _consoleLines.RemoveAt(0);
            InvokeAsync(async () =>
            {
                StateHasChanged();
                await ScrollConsoleToBottom();
            });
        });

        _hubConnection.On<ServerStatusChangedEvent>("ServerStatusChanged", async evt =>
        {
            if (evt.ServerInstanceId != _instance.Id) return;
            if (Enum.TryParse<ServerInstanceStatus>(evt.NewStatus, out var status))
            {
                _instance.Status = status;
                if (status == ServerInstanceStatus.Stopped || status == ServerInstanceStatus.Crashed)
                {
                    _instance.ProcessId = null;
                    _instance.StartedAt = null;
                    _monitorCpu = 0;
                    _monitorMemory = 0;
                    _monitorPlayerCount = 0;
                }
                await InvokeAsync(StateHasChanged);
            }
        });

        _hubConnection.On<InstanceMetricsUpdatedEvent>("InstanceMetricsUpdated", async evt =>
        {
            if (evt.ServerInstanceId != _instance.Id) return;
            _monitorCpu = evt.CpuPercent;
            _monitorMemory = evt.MemoryBytes;
            _monitorPlayerCount = evt.PlayerCount;
            await InvokeAsync(StateHasChanged);
        });

        await _hubConnection.StartAsync();
        await _hubConnection.InvokeAsync("SubscribeToInstance", _instance.Id);
    }

    private async Task ScrollConsoleToBottom()
    {
        try { await JS.InvokeVoidAsync("kastScrollToBottom", _consoleRef); } catch { }
    }

    private void ClearConsole()
    {
        _consoleLines.Clear();
        StateHasChanged();
    }

    private string GetUptime()
    {
        if (_instance.StartedAt is null) return "—";
        var elapsed = DateTime.UtcNow - _instance.StartedAt.Value;
        if (elapsed.TotalDays >= 1) return $"{elapsed.Days}d {elapsed.Hours}h";
        if (elapsed.TotalHours >= 1) return $"{elapsed.Hours}h {elapsed.Minutes}m";
        return $"{elapsed.Minutes}m {elapsed.Seconds}s";
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1024 * 1024 * 1024) return $"{bytes / (1024.0 * 1024.0):F1} MB";
        return $"{bytes / (1024.0 * 1024.0 * 1024.0):F2} GB";
    }

    private Appearance GetStatusAppearance() => _instance.Status switch
    {
        ServerInstanceStatus.Running => Appearance.Accent,
        ServerInstanceStatus.Starting or ServerInstanceStatus.Restarting => Appearance.Neutral,
        ServerInstanceStatus.Crashed => Appearance.Accent,
        _ => Appearance.Lightweight
    };
}
