@page "/settings"
@using KAST.Core.Interfaces
@using KAST.Core.Models
@using Microsoft.FluentUI.AspNetCore.Components
@inject IApiKeyService ApiKeyService
@inject ISteamService SteamService
@inject IToastService ToastService
@implements IDisposable

<PageTitle>KAST — Settings</PageTitle>

<h1>Settings</h1>

<FluentTabs Style="margin-top: 20px;">
    <FluentTab Label="Steam">
        <div class="kast-card" style="margin-top: 16px;">
            <h3>Steam Account</h3>

            @if (SteamService.IsAuthenticated)
            {
                @* ── Logged-in profile card ── *@
                <div class="steam-profile-card">
                    @if (!string.IsNullOrEmpty(SteamService.Profile?.AvatarUrl))
                    {
                        <img src="@SteamService.Profile.AvatarUrl" class="steam-avatar-large" alt="Steam avatar" />
                    }
                    else
                    {
                        <div class="steam-avatar-large steam-avatar-placeholder"></div>
                    }
                    <div class="steam-profile-info">
                        <div class="steam-profile-name">@(SteamService.Profile?.PersonaName ?? SteamService.CurrentUsername)</div>
                        @if (SteamService.Profile?.PersonaName != SteamService.CurrentUsername)
                        {
                            <div class="steam-profile-sub">@SteamService.CurrentUsername</div>
                        }
                        @if (SteamService.Profile?.SteamId > 0)
                        {
                            <div class="steam-profile-sub">SteamID: @SteamService.Profile.SteamId</div>
                        }
                    </div>
                    <FluentButton Appearance="Appearance.Outline" OnClick="Logout" Style="margin-left: auto; align-self: center;">
                        Sign out
                    </FluentButton>
                </div>
            }
            else
            {
                @* ── Not signed in — show QR code + link ── *@
                <p style="color: var(--neutral-foreground-hint, #9e9e9e); font-size: 13px; margin-bottom: 16px;">
                    Sign in to download and manage mods with your Steam account.
                </p>

                @if (_qrCodeBase64 == null && !_loggingIn)
                {
                    <FluentButton Appearance="Appearance.Accent" OnClick="StartQrLogin">
                        Sign in with Steam
                    </FluentButton>
                }
                else if (_loggingIn && _qrCodeBase64 == null)
                {
                    <div style="display: flex; align-items: center; gap: 10px; margin-top: 8px;">
                        <FluentProgressRing Style="width: 20px; height: 20px;" />
                        <span style="font-size: 13px;">Connecting to Steam...</span>
                    </div>
                }
                else if (_qrCodeBase64 != null)
                {
                    <div class="steam-qr-layout">
                        <div class="steam-qr-image-wrap">
                            <img src="data:image/png;base64,@_qrCodeBase64" alt="Steam QR Login"
                                 style="width: 200px; height: 200px; image-rendering: pixelated;" />
                        </div>
                        <div class="steam-qr-instructions">
                            <p style="margin: 0 0 6px 0; font-weight: 600;">Scan with the Steam mobile app</p>
                            <p style="margin: 0 0 12px 0; font-size: 13px; color: var(--neutral-foreground-hint, #9e9e9e);">
                                Open Steam Guard → tap <strong>Confirm sign-in</strong>
                            </p>
                            @if (!string.IsNullOrEmpty(_challengeUrl))
                            {
                                <p style="font-size: 13px; margin: 0 0 12px 0;">
                                    On mobile? <a href="@_challengeUrl" target="_blank" rel="noopener noreferrer">Tap here</a>
                                    to open directly in the Steam app.
                                </p>
                            }
                            @if (_qrPolling)
                            {
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <FluentProgressRing Style="width: 18px; height: 18px;" />
                                    <span style="font-size: 13px;">Waiting for confirmation...</span>
                                </div>
                            }
                            else
                            {
                                <FluentButton Appearance="Appearance.Stealth" OnClick="StartQrLogin">
                                    Refresh QR Code
                                </FluentButton>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </FluentTab>

    <FluentTab Label="API Keys">
        <div class="kast-card" style="margin-top: 16px;">
            <h3>API Keys</h3>
            <p style="color: var(--kast-text-muted); font-size: 13px;">
                Generate API keys for bot integrations or custom frontends.
                Keys are shown only once upon creation.
            </p>

            <div style="display: flex; gap: 8px; margin-top: 16px;">
                <FluentTextField @bind-Value="_newKeyName" Placeholder="Key name (e.g. Discord Bot)" Style="width: 300px;" />
                <FluentButton Appearance="Appearance.Accent" OnClick="CreateApiKey">Generate Key</FluentButton>
            </div>

            @if (!string.IsNullOrEmpty(_newRawKey))
            {
                <FluentMessageBar Title="New API Key" Intent="MessageIntent.Warning" Style="margin-top: 12px;">
                    Copy this key — it won't be shown again: <code>@_newRawKey</code>
                </FluentMessageBar>
            }

            @if (_apiKeys.Count > 0)
            {
                <FluentDataGrid Items="@_apiKeys.AsQueryable()" Style="margin-top: 16px;">
                    <PropertyColumn Title="Name" Property="@(k => k.Name)" />
                    <PropertyColumn Title="Prefix" Property="@(k => k.KeyPrefix + "...")" />
                    <TemplateColumn Title="Created">
                        @context.CreatedAt.ToString("g")
                    </TemplateColumn>
                    <TemplateColumn Title="Last Used">
                        @(context.LastUsedAt?.ToString("g") ?? "Never")
                    </TemplateColumn>
                    <TemplateColumn Title="Status">
                        <FluentBadge Appearance="@(context.IsActive ? Appearance.Accent : Appearance.Neutral)">
                            @(context.IsActive ? "Active" : "Revoked")
                        </FluentBadge>
                    </TemplateColumn>
                    <TemplateColumn Title="Actions">
                        @if (context.IsActive)
                        {
                            <FluentButton Size="ButtonSize.Small" OnClick="@(() => RevokeKey(context.Id))">
                                Revoke
                            </FluentButton>
                        }
                    </TemplateColumn>
                </FluentDataGrid>
            }
        </div>
    </FluentTab>

    <FluentTab Label="About">
        <div class="kast-card" style="margin-top: 16px; text-align: center;">
            <svg viewBox="0 0 200 60" xmlns="http://www.w3.org/2000/svg" style="width: 200px;">
                <defs>
                    <linearGradient id="about-molten" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" style="stop-color:#ff6b35"/>
                        <stop offset="50%" style="stop-color:#ff4444"/>
                        <stop offset="100%" style="stop-color:#cc2200"/>
                    </linearGradient>
                </defs>
                <text x="100" y="45" text-anchor="middle"
                      font-family="'Segoe UI', system-ui, sans-serif"
                      font-size="48" font-weight="700"
                      fill="url(#about-molten)">KAST</text>
            </svg>
            <h2 style="margin-top: 12px;">Keelah's Arma Server Tool</h2>
            <p style="color: var(--kast-text-muted);">Version 1.0.0</p>
            <p style="color: var(--kast-text-muted); font-size: 13px; margin-top: 16px;">
                Manage your Arma 3 dedicated servers with ease.<br/>
                Download mods, configure instances, monitor performance.
            </p>
        </div>
    </FluentTab>
</FluentTabs>

@code {
    private bool _loggingIn;

    // QR auth state
    private string? _qrCodeBase64;
    private string? _challengeUrl;
    private SteamQrAuthSession? _qrSession;
    private bool _qrPolling;
    private CancellationTokenSource? _qrCts;

    private IReadOnlyList<ApiKey> _apiKeys = [];
    private string _newKeyName = "";
    private string _newRawKey = "";

    protected override async Task OnInitializedAsync()
    {
        SteamService.AuthStateChanged += OnAuthStateChanged;
        _apiKeys = await ApiKeyService.GetAllKeysAsync();
    }

    private void OnAuthStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task StartQrLogin()
    {
        _loggingIn = true;
        _qrCodeBase64 = null;
        _challengeUrl = null;
        _qrSession = null;
        _qrPolling = false;
        StateHasChanged();

        var session = await SteamService.BeginQrLoginAsync();

        if (!string.IsNullOrEmpty(session.ErrorMessage))
        {
            _loggingIn = false;
            ToastService.ShowError($"QR error: {session.ErrorMessage}");
            StateHasChanged();
            return;
        }

        _challengeUrl = session.ChallengeUrl;
        _qrCodeBase64 = GenerateQrCodeBase64(session.ChallengeUrl);
        _qrSession = session;
        _qrPolling = true;
        _loggingIn = false;
        StateHasChanged();

        // Start polling in background
        _qrCts?.Cancel();
        _qrCts = new CancellationTokenSource(TimeSpan.FromMinutes(3));
        _ = PollQrAsync(_qrCts.Token);
    }

    private async Task PollQrAsync(CancellationToken ct)
    {
        try
        {
            var success = await SteamService.PollQrLoginAsync(_qrSession!, ct);

            await InvokeAsync(() =>
            {
                _qrPolling = false;
                _qrCodeBase64 = null;
                _challengeUrl = null;
                _qrSession = null;

                if (success)
                    ToastService.ShowSuccess($"Signed in as {SteamService.Profile?.PersonaName ?? SteamService.CurrentUsername}");
                else
                    ToastService.ShowError("QR login expired or failed");

                StateHasChanged();
            });
        }
        catch (OperationCanceledException)
        {
            await InvokeAsync(() =>
            {
                _qrPolling = false;
                _qrCodeBase64 = null;
                _challengeUrl = null;
                StateHasChanged();
            });
        }
    }

    private static string GenerateQrCodeBase64(string url)
    {
        using var qrGenerator = new QRCoder.QRCodeGenerator();
        using var qrData = qrGenerator.CreateQrCode(url, QRCoder.QRCodeGenerator.ECCLevel.M);
        using var qrCode = new QRCoder.PngByteQRCode(qrData);
        var pngBytes = qrCode.GetGraphic(8);
        return Convert.ToBase64String(pngBytes);
    }

    private async Task Logout()
    {
        _qrCts?.Cancel();
        _qrCodeBase64 = null;
        _challengeUrl = null;
        _qrSession = null;
        _qrPolling = false;
        await SteamService.LogoutAsync();
        ToastService.ShowInfo("Signed out of Steam");
    }

    private async Task CreateApiKey()
    {
        if (string.IsNullOrWhiteSpace(_newKeyName)) return;

        var (_, rawKey) = await ApiKeyService.CreateApiKeyAsync(_newKeyName);
        _newRawKey = rawKey;
        _newKeyName = "";
        _apiKeys = await ApiKeyService.GetAllKeysAsync();
        ToastService.ShowSuccess("API key created");
    }

    private async Task RevokeKey(int id)
    {
        await ApiKeyService.RevokeKeyAsync(id);
        _apiKeys = await ApiKeyService.GetAllKeysAsync();
        ToastService.ShowSuccess("Key revoked");
    }

    public void Dispose()
    {
        SteamService.AuthStateChanged -= OnAuthStateChanged;
        _qrCts?.Cancel();
        _qrCts?.Dispose();
    }
}
