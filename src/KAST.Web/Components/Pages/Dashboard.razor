@page "/"
@using KAST.Core.Enums
@using KAST.Core.Interfaces
@using KAST.Core.Models
@using Microsoft.FluentUI.AspNetCore.Components
@implements IAsyncDisposable
@inject IModService ModService
@inject IServerInstanceService ServerService
@inject IMonitoringService MonitoringService

<PageTitle>KAST — Dashboard</PageTitle>

<h1>Dashboard</h1>

<div class="kast-tiles" style="margin-top: 20px;">
    <div class="kast-tile">
        <div>
            <div class="kast-tile-title">Server Instances</div>
            <div class="kast-tile-subtitle">Total configured</div>
        </div>
        <div class="kast-tile-value">@_instances.Count</div>
    </div>

    <div class="kast-tile">
        <div>
            <div class="kast-tile-title">Running</div>
            <div class="kast-tile-subtitle">Active servers</div>
        </div>
        <div class="kast-tile-value" style="color: var(--kast-success);">
            @_instances.Count(i => i.Status == ServerInstanceStatus.Running)
        </div>
    </div>

    <div class="kast-tile">
        <div>
            <div class="kast-tile-title">Installed Mods</div>
            <div class="kast-tile-subtitle">Available for use</div>
        </div>
        <div class="kast-tile-value">@_mods.Count</div>
    </div>

    <div class="kast-tile">
        <div>
            <div class="kast-tile-title">Updates Available</div>
            <div class="kast-tile-subtitle">Mods needing updates</div>
        </div>
        <div class="kast-tile-value" style="color: var(--kast-warning);">
            @_mods.Count(m => m.Status == ModStatus.UpdateAvailable)
        </div>
    </div>
</div>

<h2 style="margin-top: 32px;">Host Resources</h2>

<div class="kast-tiles">
    <div class="kast-tile">
        <div>
            <div class="kast-tile-title">CPU Usage</div>
        </div>
        <div class="kast-tile-value">@_hostMetrics.CpuUsagePercent.ToString("F1")%</div>
        <FluentProgress Value="@((int)_hostMetrics.CpuUsagePercent)" />
    </div>

    <div class="kast-tile">
        <div>
            <div class="kast-tile-title">Memory Usage</div>
            <div class="kast-tile-subtitle">
                @FormatBytes(_hostMetrics.UsedMemoryBytes) / @FormatBytes(_hostMetrics.TotalMemoryBytes)
            </div>
        </div>
        <div class="kast-tile-value">@_hostMetrics.MemoryUsagePercent.ToString("F1")%</div>
        <FluentProgress Value="@((int)_hostMetrics.MemoryUsagePercent)" />
    </div>

    <div class="kast-tile">
        <div>
            <div class="kast-tile-title">Disk Usage</div>
            <div class="kast-tile-subtitle">
                @FormatBytes(_hostMetrics.UsedDiskBytes) / @FormatBytes(_hostMetrics.TotalDiskBytes)
            </div>
        </div>
        <div class="kast-tile-value">@_hostMetrics.DiskUsagePercent.ToString("F1")%</div>
        <FluentProgress Value="@((int)_hostMetrics.DiskUsagePercent)" />
    </div>
</div>

<h2 style="margin-top: 32px;">Server Instances</h2>

@if (_instances.Count == 0)
{
    <div class="kast-card">
        <p style="color: var(--kast-text-muted);">No server instances configured yet. <a href="/servers">Create one</a>.</p>
    </div>
}
else
{
    <div class="kast-tiles">
        @foreach (var instance in _instances)
        {
            <div class="kast-tile">
                <div>
                    <div class="kast-tile-title">
                        <span class="status-dot @instance.Status.ToString().ToLowerInvariant()"></span>
                        @instance.Name
                    </div>
                    <div class="kast-tile-subtitle">
                        Port @instance.Port — @instance.Mods.Count mods
                    </div>
                </div>
                <div>
                    <FluentBadge Appearance="@GetStatusAppearance(instance.Status)">
                        @instance.Status
                    </FluentBadge>
                </div>
            </div>
        }
    </div>
}

@code {
    private IReadOnlyList<SteamMod> _mods = [];
    private IReadOnlyList<ServerInstance> _instances = [];
    private HostMetrics _hostMetrics = new();
    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        await RefreshData();

        _cts = new CancellationTokenSource();
        _ = RunPeriodicRefresh(_cts.Token);
    }

    private async Task RefreshData()
    {
        _mods = await ModService.GetAllModsAsync();
        _instances = await ServerService.GetAllInstancesAsync();

        try
        {
            _hostMetrics = await MonitoringService.GetHostMetricsAsync();
        }
        catch
        {
            // Monitoring may not be available in all environments
        }
    }

    private async Task RunPeriodicRefresh(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await InvokeAsync(async () =>
                {
                    await RefreshData();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) { }
    }

    private static Appearance GetStatusAppearance(ServerInstanceStatus status) => status switch
    {
        ServerInstanceStatus.Running => Appearance.Accent,
        ServerInstanceStatus.Stopped => Appearance.Neutral,
        ServerInstanceStatus.Crashed => Appearance.Accent,
        _ => Appearance.Neutral
    };

    private static string FormatBytes(long bytes)
    {
        string[] sizes = ["B", "KB", "MB", "GB", "TB"];
        int order = 0;
        double size = bytes;
        while (size >= 1024 && order < sizes.Length - 1)
        {
            order++;
            size /= 1024;
        }
        return $"{size:F1} {sizes[order]}";
    }

    public async ValueTask DisposeAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        await ValueTask.CompletedTask;
    }
}
