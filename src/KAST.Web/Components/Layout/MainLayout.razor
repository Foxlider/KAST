@inherits LayoutComponentBase
@using KAST.Core.Interfaces
@using Microsoft.FluentUI.AspNetCore.Components
@inject ISteamService SteamService
@inject ISettingsService SettingsService
@inject NavigationManager Navigation
@implements IDisposable

<FluentDesignTheme @bind-Mode="_themeMode"
                   CustomColor="#ff6b35"
                   StorageName="kast-theme">
    <div class="kast-layout">
        <header class="kast-header">
            <div class="kast-header-brand">
                <svg viewBox="0 0 120 36" xmlns="http://www.w3.org/2000/svg" style="height: 32px; width: auto;">
                    <defs>
                        <linearGradient id="header-molten" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" style="stop-color:#ff6b35"/>
                            <stop offset="100%" style="stop-color:#ff4444"/>
                        </linearGradient>
                    </defs>
                    <text x="60" y="28" text-anchor="middle"
                          font-family="'Segoe UI', system-ui, sans-serif"
                          font-size="30" font-weight="700"
                          fill="url(#header-molten)">KAST</text>
                </svg>
                <span class="kast-header-subtitle">Keelah's Arma Server Tool</span>
            </div>
            <div style="margin-left: auto; display: flex; align-items: center; gap: 8px;">
                <FluentButton Appearance="Appearance.Stealth"
                              Title="@(_themeMode == DesignThemeModes.Dark ? "Switch to light mode" : "Switch to dark mode")"
                              OnClick="ToggleTheme">
                    @if (_themeMode == DesignThemeModes.Dark)
                    {
                        <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.WeatherSunny())" Color="Color.Neutral" />
                    }
                    else
                    {
                        <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.WeatherMoon())" Color="Color.Neutral" />
                    }
                </FluentButton>
                <div class="kast-user-tile-wrapper" style="position: relative;">
                <button class="kast-user-tile" @onclick="ToggleUserPanel" @onclick:stopPropagation="true">
                    @if (SteamService.IsAuthenticated && !string.IsNullOrEmpty(SteamService.Profile?.AvatarUrl))
                    {
                        <img src="@SteamService.Profile!.AvatarUrl" class="steam-avatar-small" alt="avatar" />
                    }
                    else
                    {
                        <span class="status-dot @(SteamService.IsAuthenticated ? "running" : "stopped")"></span>
                    }
                    <span class="kast-user-tile-name">
                        @if (SteamService.IsAuthenticated)
                        {
                            @(SteamService.Profile?.PersonaName ?? SteamService.CurrentUsername)
                        }
                        else
                        {
                            <text>Not signed in</text>
                        }
                    </span>
                    <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.ChevronDown())" Color="Color.Neutral" />
                </button>

                @if (_showUserPanel)
                {
                    <div class="kast-user-panel" @onclick:stopPropagation="true">
                        <div class="kast-user-panel-header">
                            @if (SteamService.IsAuthenticated && !string.IsNullOrEmpty(SteamService.Profile?.AvatarUrl))
                            {
                                <img src="@SteamService.Profile!.AvatarUrl" class="steam-avatar-panel" alt="avatar" />
                            }
                            else
                            {
                                <span class="status-dot @(SteamService.IsAuthenticated ? "running" : "stopped")" style="width: 10px; height: 10px;"></span>
                            }
                            <div>
                                <div style="font-weight: 600; font-size: 14px;">
                                    @if (SteamService.IsAuthenticated)
                                    {
                                        @(SteamService.Profile?.PersonaName ?? SteamService.CurrentUsername)
                                    }
                                    else
                                    {
                                        <text>Not signed in</text>
                                    }
                                </div>
                                <div style="font-size: 12px; color: var(--neutral-foreground-hint, #9e9e9e);">
                                    @if (SteamService.IsAuthenticated)
                                    {
                                        @SteamService.CurrentUsername
                                    }
                                    else
                                    {
                                        <text>Sign in to download mods</text>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="kast-user-panel-divider"></div>

                        @if (!SteamService.IsAuthenticated)
                        {
                            <button class="kast-user-panel-item" @onclick="GoToSteamLogin">
                                <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.PersonAdd())" Color="Color.Neutral" />
                                <span>Sign in with Steam</span>
                            </button>
                        }

                        @if (SteamService.IsAuthenticated)
                        {
                            <button class="kast-user-panel-item" @onclick="Logout">
                                <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.SignOut())" Color="Color.Neutral" />
                                <span>Sign out</span>
                            </button>
                        }

                        <button class="kast-user-panel-item" @onclick="GoToSettings">
                            <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.Settings())" Color="Color.Neutral" />
                            <span>Settings</span>
                        </button>
                    </div>
                }
            </div>
            </div>
        </header>

        <div class="kast-body">
            <FluentNavMenu Width="220" Collapsible="true" Title="Navigation" Class="kast-nav">
                <FluentNavLink Href="/" Match="NavLinkMatch.All" Icon="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24.Home())">
                    Dashboard
                </FluentNavLink>
                <FluentNavLink Href="/mods" Icon="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24.PuzzlePiece())">
                    Mods
                </FluentNavLink>
                <FluentNavLink Href="/servers" Icon="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24.Server())">
                    Servers
                </FluentNavLink>
                <FluentNavLink Href="/monitoring" Icon="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24.ChartMultiple())">
                    Monitoring
                </FluentNavLink>
                <FluentNavLink Href="/settings" Icon="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24.Settings())">
                    Settings
                </FluentNavLink>
            </FluentNavMenu>

            <main class="kast-main">
                <div class="page-content">
                    @Body
                </div>
            </main>
        </div>

        <StatusFooter />
    </div>
</FluentDesignTheme>

@code {
    private bool _showUserPanel;
    private DesignThemeModes _themeMode = DesignThemeModes.Dark;

    protected override async Task OnInitializedAsync()
    {
        SteamService.AuthStateChanged += OnAuthStateChanged;

        // Load theme from DB settings
        try
        {
            var settings = await SettingsService.GetSettingsAsync();
            _themeMode = settings.ThemeMode?.Equals("light", StringComparison.OrdinalIgnoreCase) == true
                ? DesignThemeModes.Light
                : DesignThemeModes.Dark;
        }
        catch
        {
            // Default to dark on error
        }
    }

    private void OnAuthStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void ToggleUserPanel()
    {
        _showUserPanel = !_showUserPanel;
    }

    private async Task Logout()
    {
        _showUserPanel = false;
        await SteamService.LogoutAsync();
    }

    private void GoToSteamLogin()
    {
        _showUserPanel = false;
        Navigation.NavigateTo("/settings");
    }

    private void GoToSettings()
    {
        _showUserPanel = false;
        Navigation.NavigateTo("/settings");
    }

    private async Task ToggleTheme()
    {
        _themeMode = _themeMode == DesignThemeModes.Dark
            ? DesignThemeModes.Light
            : DesignThemeModes.Dark;

        try
        {
            var settings = await SettingsService.GetSettingsAsync();
            settings.ThemeMode = _themeMode == DesignThemeModes.Light ? "light" : "dark";
            await SettingsService.UpdateSettingsAsync(settings);
        }
        catch
        {
            // Persist best-effort
        }
    }

    public void Dispose()
    {
        SteamService.AuthStateChanged -= OnAuthStateChanged;
    }
}