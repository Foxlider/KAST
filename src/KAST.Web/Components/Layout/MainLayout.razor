@inherits LayoutComponentBase
@using Microsoft.FluentUI.AspNetCore.Components

<FluentDesignTheme Mode="DesignThemeModes.Dark"
                   CustomColor="#ff6b35"
                   StorageName="kast-theme">
    <div class="kast-layout">
        <header class="kast-header">
            <div class="kast-header-brand">
                <svg viewBox="0 0 120 36" xmlns="http://www.w3.org/2000/svg" style="height: 32px; width: auto;">
                    <defs>
                        <linearGradient id="header-molten" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" style="stop-color:#ff6b35"/>
                            <stop offset="100%" style="stop-color:#ff4444"/>
                        </linearGradient>
                    </defs>
                    <text x="60" y="28" text-anchor="middle"
                          font-family="'Segoe UI', system-ui, sans-serif"
                          font-size="30" font-weight="700"
                          fill="url(#header-molten)">KAST</text>
                </svg>
                <span class="kast-header-subtitle">Keelah's Arma Server Tool</span>
            </div>
        </header>

        <div class="kast-body">
            <FluentNavMenu Width="220" Collapsible="true" Title="Navigation" Class="kast-nav">
                <FluentNavLink Href="/" Match="NavLinkMatch.All" Icon="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24.Home())">
                    Dashboard
                </FluentNavLink>
                <FluentNavLink Href="/mods" Icon="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24.PuzzlePiece())">
                    Mods
                </FluentNavLink>
                <FluentNavLink Href="/servers" Icon="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24.Server())">
                    Servers
                </FluentNavLink>
                <FluentNavLink Href="/monitoring" Icon="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24.ChartMultiple())">
                    Monitoring
                </FluentNavLink>
                <FluentNavLink Href="/settings" Icon="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24.Settings())">
                    Settings
                </FluentNavLink>
            </FluentNavMenu>

            <main class="kast-main">
                <div class="page-content">
                    @Body
                </div>
            </main>
        </div>
    </div>
</FluentDesignTheme>